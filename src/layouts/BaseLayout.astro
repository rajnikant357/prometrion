---
// BaseLayout.astro - Master Layout with Geist typography, Dark Mode, Ambient Glow, Navbar, Footer, Chatbot and Search
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import ChatbotWidget from "../components/ChatbotWidget.astro";
import { buildOrganizationSchema, buildWebSiteSchema } from "../utils/seo";

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title = "Prometrion — Building Technology for What's Next",
  description = "Prometrion is a technology company delivering custom website development, mobile application engineering, SEO & GEO AI visibility, digital branding, and software consulting.",
  canonical,
  image,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
  jsonLd,
} = Astro.props;

const productionSite = "https://www.prometrion.com";
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = canonical || (currentPath === '/' ? productionSite : `${productionSite}${currentPath}`);
const pageTitle = title.includes("Prometrion") ? title : `${title} | Prometrion`;
const socialImage = image ? (image.startsWith('http') ? image : `${productionSite}${image}`) : `${productionSite}/prometrion-logo.png`;
const socialImageAlt = imageAlt || pageTitle;

// Default structured data for homepage if no explicit jsonLd passed
const computedJsonLd = jsonLd || (currentPath === '/' ? {
  '@context': 'https://schema.org',
  '@graph': [
    buildOrganizationSchema(),
    buildWebSiteSchema(),
  ],
} : undefined);
---

<!doctype html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/prometrion-logo.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Robots Meta Directives -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Prometrion" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {type === 'article' && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- Schema.org JSON-LD Structured Data -->
    {computedJsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(computedJsonLd)} />
    )}

    <!-- Immediate Theme Initialization Script (Default Dark Mode) -->
    <script is:inline>
      (function() {
        try {
          const saved = localStorage.getItem('prometrion-theme');
          if (saved === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Geist & Geist Mono Typeface from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#fafafa] dark:bg-black text-neutral-800 dark:text-neutral-300 font-sans antialiased selection:bg-[#0070f3] dark:selection:bg-[#00dfd8] dark:selection:text-black transition-colors duration-300 relative">
    
    <!-- Top Cinematic Reading Scroll Progress Bar -->
    <div
      id="cinematic-scroll-progress"
      class="fixed top-0 left-0 right-0 h-[2.5px] z-[100] pointer-events-none bg-gradient-to-r from-emerald-400 via-cyan-400 to-[#0070f3] shadow-[0_0_12px_rgba(0,223,216,0.7)] scale-x-0 origin-left"
      aria-hidden="true"
    ></div>

    <!-- Signature Ambient Dark Glow (Light Green + Light Blue combo) -->
    <div class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[650px] overflow-hidden opacity-0 dark:opacity-100 transition-opacity duration-700">
      <div class="absolute -top-[280px] left-1/2 -translate-x-1/2 w-[850px] sm:w-[1300px] h-[550px] rounded-full bg-gradient-to-r from-emerald-400/20 via-cyan-400/25 to-sky-400/20 blur-[120px]"></div>
    </div>

    <!-- Spotlight Search Modal (Cmd+K) -->
    <SearchModal />

    <!-- Accessible Skip to Content Link for Keyboard & Screen Reader Users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-4 focus:z-[150] focus:px-4 focus:py-2 focus:bg-white focus:text-black dark:focus:bg-neutral-900 dark:focus:text-white focus:border focus:border-cyan-400 focus:rounded-md focus:shadow-2xl focus:font-mono focus:text-xs"
    >
      Skip to main content
    </a>

    <!-- Global Top Navigation -->
    <Navbar />

    <!-- Main Page Content -->
    <main id="main-content" class="flex-1 w-full" tabindex="-1">
      <slot />
    </main>

    <!-- Global AI Sales Assistant Chatbot -->
    <ChatbotWidget />

    <!-- Global Technical Footer with Explore & Theme Switcher -->
    <Footer />

    <!-- Universal Spotlight Cursor Tracking for Interactive Bento & Feature Cards -->
    <script>
      function initSpotlights() {
        const cards = document.querySelectorAll<HTMLElement>('.spotlight-card');
        cards.forEach((card) => {
          if (card.dataset.spotlightInit) return;
          card.dataset.spotlightInit = 'true';
          
          card.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            card.style.setProperty('--mouse-x', `${x}px`);
            card.style.setProperty('--mouse-y', `${y}px`);
          });
          
          card.addEventListener('mouseleave', () => {
            card.style.setProperty('--mouse-x', '-400px');
            card.style.setProperty('--mouse-y', '-400px');
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSpotlights);
      } else {
        initSpotlights();
      }
      document.addEventListener('astro:page-load', initSpotlights);
    </script>

    <!-- Lenis Controlled Momentum Smooth Scrolling Engine & Cinematic Scroll Orchestrator -->
    <script>
      import Lenis from 'lenis';

      let lenis: Lenis | null = null;
      let rafId: number | null = null;

      function initLenis() {
        // Accessibility check: respect user motion preference
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        if (lenis) {
          lenis.destroy();
          lenis = null;
        }
        if (rafId) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }

        // Initialize Lenis with weighted momentum curves
        lenis = new Lenis({
          duration: 1.15,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // Apple-grade natural deceleration
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1.0,
          touchMultiplier: 1.2,
          infinite: false,
        });

        (window as any).lenis = lenis;

        function step(time: number) {
          lenis?.raf(time);
          rafId = requestAnimationFrame(step);
        }
        rafId = requestAnimationFrame(step);

        // Fallback progress bar update for browsers without native scroll-timeline
        const progressBar = document.getElementById('cinematic-scroll-progress');
        lenis.on('scroll', ({ progress }: { progress: number }) => {
          if (progressBar && !(window as any).CSS?.supports?.('animation-timeline', 'scroll()')) {
            progressBar.style.transform = `scaleX(${progress})`;
          }
        });

        // Smooth scrolling for in-page anchors
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
          anchor.addEventListener('click', (e) => {
            const href = anchor.getAttribute('href');
            if (href && href.length > 1) {
              const target = document.querySelector(href);
              if (target) {
                e.preventDefault();
                lenis?.scrollTo(target as HTMLElement, { offset: -70, duration: 1.2 });
              }
            }
          });
        });
      }

      function initScrollReveals() {
        const elements = document.querySelectorAll('.scrolly-fade-in');
        if (!elements.length) return;

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
              }
            });
          }, {
            threshold: 0.1,
            rootMargin: '0px 0px -40px 0px'
          });

          elements.forEach((el) => observer.observe(el));
        } else {
          elements.forEach((el) => el.classList.add('is-visible'));
        }
      }

      function setupScroll() {
        initLenis();
        initScrollReveals();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupScroll);
      } else {
        setupScroll();
      }
      document.addEventListener('astro:page-load', setupScroll);
    </script>
  </body>
</html>
