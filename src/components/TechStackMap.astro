---
// TechStackMap.astro - Interactive Engineering Technology Stack & Connected Architecture Map
// Clean SVG logos, connected bus lines, interactive layer filters, and accessible semantic HTML.

interface TechItem {
  id: string;
  name: string;
  category: 'languages' | 'frontend' | 'backend' | 'database' | 'mobile' | 'devops';
  layer: 'interface' | 'logic' | 'data' | 'cloud';
  role: string;
  color: string; // brand accent color for hover/luminous border
  connectedTo: string[]; // ids of connected technologies
}

const technologies: TechItem[] = [
  // A. Web Development Languages
  {
    id: "ts",
    name: "TypeScript",
    category: "languages",
    layer: "interface",
    role: "Strict Type Safety",
    color: "#3178c6",
    connectedTo: ["react", "nextjs", "astro", "nodejs"],
  },
  {
    id: "js",
    name: "JavaScript",
    category: "languages",
    layer: "interface",
    role: "Dynamic Web Runtime",
    color: "#f7df1e",
    connectedTo: ["ts", "react", "nodejs"],
  },
  {
    id: "html5",
    name: "HTML5",
    category: "languages",
    layer: "interface",
    role: "Semantic Web Structure",
    color: "#e34f26",
    connectedTo: ["css3", "astro", "react"],
  },
  {
    id: "css3",
    name: "CSS3",
    category: "languages",
    layer: "interface",
    role: "Modern Styling & Layout",
    color: "#1572b6",
    connectedTo: ["html5", "tailwind"],
  },
  {
    id: "sql",
    name: "SQL",
    category: "languages",
    layer: "data",
    role: "Relational Querying",
    color: "#00758f",
    connectedTo: ["postgres", "supabase", "neon"],
  },

  // B. Frontend Frameworks & Libraries
  {
    id: "astro",
    name: "Astro 7",
    category: "frontend",
    layer: "interface",
    role: "Zero-JS Island Architecture",
    color: "#ff5d01",
    connectedTo: ["react", "tailwind", "vercel"],
  },
  {
    id: "react",
    name: "React 19",
    category: "frontend",
    layer: "interface",
    role: "Component UI Engine",
    color: "#00d8ff",
    connectedTo: ["ts", "nextjs", "tailwind", "vite"],
  },
  {
    id: "nextjs",
    name: "Next.js",
    category: "frontend",
    layer: "interface",
    role: "React Full-Stack Framework",
    color: "#ffffff",
    connectedTo: ["react", "nodejs", "vercel"],
  },
  {
    id: "tailwind",
    name: "Tailwind CSS v4",
    category: "frontend",
    layer: "interface",
    role: "Utility-First Styling",
    color: "#38bdf8",
    connectedTo: ["astro", "react", "nextjs"],
  },
  {
    id: "vite",
    name: "Vite",
    category: "frontend",
    layer: "interface",
    role: "Next-Gen Frontend Bundler",
    color: "#646cff",
    connectedTo: ["react", "ts"],
  },

  // C. Backend Development
  {
    id: "nodejs",
    name: "Node.js",
    category: "backend",
    layer: "logic",
    role: "V8 Server Runtime",
    color: "#5fa04e",
    connectedTo: ["express", "ts", "rest", "postgres"],
  },
  {
    id: "express",
    name: "Express.js",
    category: "backend",
    layer: "logic",
    role: "REST Routing Framework",
    color: "#000000",
    connectedTo: ["nodejs", "rest", "mongodb"],
  },
  {
    id: "python",
    name: "Python",
    category: "backend",
    layer: "logic",
    role: "Data & AI Processing",
    color: "#3776ab",
    connectedTo: ["rest", "postgres"],
  },
  {
    id: "rest",
    name: "REST APIs",
    category: "backend",
    layer: "logic",
    role: "Contract-Driven Endpoints",
    color: "#00dfd8",
    connectedTo: ["nodejs", "express", "postgres", "supabase"],
  },

  // D. Databases & Data Storage
  {
    id: "postgres",
    name: "PostgreSQL",
    category: "database",
    layer: "data",
    role: "ACID Relational Engine",
    color: "#336791",
    connectedTo: ["sql", "supabase", "neon", "nodejs"],
  },
  {
    id: "supabase",
    name: "Supabase",
    category: "database",
    layer: "data",
    role: "Serverless Postgres & Auth",
    color: "#3ecf8e",
    connectedTo: ["postgres", "sql", "react", "astro"],
  },
  {
    id: "mongodb",
    name: "MongoDB",
    category: "database",
    layer: "data",
    role: "Document Store",
    color: "#47a248",
    connectedTo: ["express", "nodejs"],
  },
  {
    id: "neon",
    name: "Neon Postgres",
    category: "database",
    layer: "data",
    role: "Serverless Branching DB",
    color: "#00e599",
    connectedTo: ["postgres", "sql", "vercel"],
  },

  // E. Mobile Application Development
  {
    id: "kotlin",
    name: "Kotlin",
    category: "mobile",
    layer: "interface",
    role: "Modern Android Language",
    color: "#7f52ff",
    connectedTo: ["android-sdk", "java", "rest"],
  },
  {
    id: "android-sdk",
    name: "Android SDK",
    category: "mobile",
    layer: "interface",
    role: "Native Device APIs",
    color: "#34a853",
    connectedTo: ["kotlin", "java"],
  },
  {
    id: "flutter",
    name: "Flutter",
    category: "mobile",
    layer: "interface",
    role: "Multi-Platform UI Toolkit",
    color: "#02569b",
    connectedTo: ["rest"],
  },
  {
    id: "react-native",
    name: "React Native",
    category: "mobile",
    layer: "interface",
    role: "Cross-Platform Mobile",
    color: "#61dafb",
    connectedTo: ["react", "ts", "rest"],
  },
  {
    id: "java",
    name: "Java",
    category: "mobile",
    layer: "interface",
    role: "Core Android Runtime",
    color: "#f89820",
    connectedTo: ["android-sdk", "kotlin"],
  },

  // G. Deployment & Developer Tools
  {
    id: "git",
    name: "Git",
    category: "devops",
    layer: "cloud",
    role: "Distributed Version Control",
    color: "#f05032",
    connectedTo: ["github"],
  },
  {
    id: "github",
    name: "GitHub",
    category: "devops",
    layer: "cloud",
    role: "CI/CD & Code Workflows",
    color: "#ffffff",
    connectedTo: ["git", "vercel", "render"],
  },
  {
    id: "vercel",
    name: "Vercel",
    category: "devops",
    layer: "cloud",
    role: "Edge Compute & Hosting",
    color: "#ffffff",
    connectedTo: ["nextjs", "astro", "github"],
  },
  {
    id: "render",
    name: "Render",
    category: "devops",
    layer: "cloud",
    role: "Cloud Web Services & DBs",
    color: "#46e3b7",
    connectedTo: ["nodejs", "github"],
  },
  {
    id: "postman",
    name: "Postman",
    category: "devops",
    layer: "cloud",
    role: "API Testing & Telemetry",
    color: "#ff6c37",
    connectedTo: ["rest", "express"],
  },
];

const categoryTabs = [
  { id: "all", label: "Full Ecosystem", count: technologies.length },
  { id: "architecture", label: "Architecture Flow", count: 4 },
  { id: "frontend", label: "Frontend & Web", count: 7 },
  { id: "backend", label: "Backend & APIs", count: 4 },
  { id: "database", label: "Databases", count: 5 },
  { id: "mobile", label: "Mobile Development", count: 5 },
  { id: "devops", label: "Cloud & DevOps", count: 5 },
];
---

<section id="technology-stack" class="relative py-24 sm:py-32 bg-white dark:bg-[#070707] border-b border-[#ebebeb] dark:border-white/10 overflow-hidden transition-colors">
  <!-- Atmospheric Ambient Luminous Mesh -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[850px] sm:w-[1100px] h-[450px] bg-gradient-to-r from-emerald-500/10 via-cyan-500/15 to-blue-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Descriptive H2 and supporting copy for SEO/GEO) -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-neutral-100 dark:bg-white/[0.04] text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-white/10 mb-4">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>CONNECTED ENGINEERING ECOSYSTEM</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-white leading-[1.12]">
        Engineered With the Right Technologies
      </h2>
      <p class="mt-4 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        From responsive web experiences to full-stack applications and mobile products, we choose technologies that fit the product, its users, and its long-term requirements.
      </p>
    </div>

    <!-- Interactive View Switcher & Category Filter Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-10 max-w-4xl mx-auto">
      {categoryTabs.map((tab) => (
        <button
          type="button"
          class={`tech-filter-btn px-4 py-1.5 rounded-full text-xs font-medium border transition-all duration-200 cursor-pointer ${
            tab.id === 'all'
              ? 'bg-[#171717] text-white border-neutral-900 dark:bg-white dark:text-black dark:border-white shadow-xs'
              : 'bg-white dark:bg-[#101010] text-neutral-600 dark:text-neutral-400 border-neutral-200/80 dark:border-white/10 hover:border-neutral-400 dark:hover:border-white/30 hover:text-black dark:hover:text-white'
          }`}
          data-filter={tab.id}
          aria-pressed={tab.id === 'all' ? 'true' : 'false'}
        >
          <span>{tab.label}</span>
        </button>
      ))}
    </div>

    <!-- VIEW 1: FULL-STACK ARCHITECTURE FLOW VISUALIZATION (Visible by default and when 'architecture' or 'all' selected) -->
    <div id="architecture-pipeline-view" class="mb-14 p-6 sm:p-8 rounded-[8px] bg-neutral-50/70 dark:bg-[#0c0c0d] border border-[#ebebeb] dark:border-white/10 shadow-whisper relative overflow-hidden transition-all duration-300">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-8 border-b border-neutral-200/60 dark:border-white/10 gap-2">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-[0.2em] text-cyan-600 dark:text-cyan-400 font-semibold block">
            END-TO-END SYSTEM TOPOLOGY
          </span>
          <h3 class="text-base sm:text-lg font-semibold text-neutral-900 dark:text-white mt-1">
            Full-Stack Architectural Flow & Data Pipeline
          </h3>
        </div>
        <div class="flex items-center gap-4 text-[11px] font-mono text-neutral-500 dark:text-neutral-400">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Live Data Bus Active
          </span>
          <span class="hidden sm:inline">|</span>
          <span class="hidden sm:inline">Bidirectional Sync</span>
        </div>
      </div>

      <!-- 4 Connected Pipeline Stages with SVG Bus Connectors -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 relative">
        
        <!-- Stage 1: Client Interfaces -->
        <div class="arch-stage p-5 rounded-[6px] bg-white dark:bg-[#121214] border border-neutral-200 dark:border-white/10 hover:border-cyan-400/50 dark:hover:border-cyan-400/50 transition-all duration-200 relative group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800/60">
                01. LAYER
              </span>
              <span class="text-xs text-neutral-400 font-mono">Client View</span>
            </div>
            <h4 class="text-sm font-semibold text-neutral-900 dark:text-white">Web & Mobile Interfaces</h4>
            <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1 leading-relaxed">
              Sub-second rendering, accessible UI components, and fluid touch runtimes.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/5 flex flex-wrap gap-1.5 text-[10px] font-mono text-neutral-700 dark:text-neutral-300">
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Astro 7</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">React 19</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Kotlin</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Tailwind</span>
          </div>
        </div>

        <!-- Stage 2: Application Logic & APIs -->
        <div class="arch-stage p-5 rounded-[6px] bg-white dark:bg-[#121214] border border-neutral-200 dark:border-white/10 hover:border-emerald-400/50 dark:hover:border-emerald-400/50 transition-all duration-200 relative group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60">
                02. LAYER
              </span>
              <span class="text-xs text-neutral-400 font-mono">Logic & Auth</span>
            </div>
            <h4 class="text-sm font-semibold text-neutral-900 dark:text-white">Application Logic & APIs</h4>
            <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1 leading-relaxed">
              Type-safe business logic, microservices, REST endpoints, and biometric token validation.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/5 flex flex-wrap gap-1.5 text-[10px] font-mono text-neutral-700 dark:text-neutral-300">
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Node.js</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Express</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Python</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">REST API</span>
          </div>
        </div>

        <!-- Stage 3: Data Services & Persistence -->
        <div class="arch-stage p-5 rounded-[6px] bg-white dark:bg-[#121214] border border-neutral-200 dark:border-white/10 hover:border-blue-400/50 dark:hover:border-blue-400/50 transition-all duration-200 relative group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-cyan-300 border border-blue-200 dark:border-blue-800/60">
                03. LAYER
              </span>
              <span class="text-xs text-neutral-400 font-mono">Persistence</span>
            </div>
            <h4 class="text-sm font-semibold text-neutral-900 dark:text-white">Database & Data Services</h4>
            <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1 leading-relaxed">
              ACID relational integrity, serverless PostgreSQL, real-time websockets, and caching.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/5 flex flex-wrap gap-1.5 text-[10px] font-mono text-neutral-700 dark:text-neutral-300">
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">PostgreSQL</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Supabase</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Neon</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">MongoDB</span>
          </div>
        </div>

        <!-- Stage 4: Deployment & Cloud Edge -->
        <div class="arch-stage p-5 rounded-[6px] bg-white dark:bg-[#121214] border border-neutral-200 dark:border-white/10 hover:border-purple-400/50 dark:hover:border-purple-400/50 transition-all duration-200 relative group flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800/60">
                04. LAYER
              </span>
              <span class="text-xs text-neutral-400 font-mono">Edge Mesh</span>
            </div>
            <h4 class="text-sm font-semibold text-neutral-900 dark:text-white">Deployment & Delivery</h4>
            <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1 leading-relaxed">
              Global Anycast edge CDN, automated CI/CD pipelines, SSL provisioning, and zero-downtime rollouts.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/5 flex flex-wrap gap-1.5 text-[10px] font-mono text-neutral-700 dark:text-neutral-300">
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Vercel</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Render</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">GitHub CI</span>
            <span class="px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10">Git</span>
          </div>
        </div>

      </div>

      <!-- Connector Pulse Subtext -->
      <div class="mt-6 pt-4 border-t border-neutral-200/60 dark:border-white/10 flex flex-wrap items-center justify-between gap-2 text-xs text-neutral-500 dark:text-neutral-400 font-mono">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
          <span>Unified Flow: User → Web/Mobile App → REST/Microservice → Database Service → Edge CDN</span>
        </div>
        <span class="text-[11px] text-neutral-400">Hover any technology below to view active dependencies</span>
      </div>
    </div>

    <!-- VIEW 2: INTERACTIVE CONNECTED TECHNOLOGY GRID (Square & Near-Square Cards) -->
    <div
      id="tech-grid"
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4 transition-all duration-300"
    >
      {technologies.map((tech) => (
        <div
          class="tech-card group relative aspect-square p-4 sm:p-5 rounded-[6px] bg-white dark:bg-[#0c0c0e] border border-neutral-200/80 dark:border-white/10 hover:border-neutral-900 dark:hover:border-cyan-400/60 shadow-whisper hover:shadow-floating transition-all duration-200 cursor-pointer flex flex-col justify-between overflow-hidden select-none"
          data-id={tech.id}
          data-category={tech.category}
          data-connected={tech.connectedTo.join(",")}
          tabindex="0"
          role="button"
          aria-label={`${tech.name} — ${tech.role}`}
        >
          <!-- Corner Ambient Accent Glow on Hover -->
          <div
            class="tech-card-glow absolute -top-8 -right-8 w-24 h-24 rounded-full blur-xl opacity-0 group-hover:opacity-40 transition-opacity duration-300 pointer-events-none"
            style={`background-color: ${tech.color};`}
          ></div>

          <!-- Top Row: Category Pill / Indicator -->
          <div class="flex items-center justify-between gap-1 z-10">
            <span class="text-[9px] font-mono uppercase tracking-wider text-neutral-400 dark:text-neutral-500 truncate">
              {tech.category}
            </span>
            <span class="connected-badge w-1.5 h-1.5 rounded-full bg-neutral-300 dark:bg-white/20 transition-all duration-200"></span>
          </div>

          <!-- Center: Official Recognizable Vector Icon -->
          <div class="my-auto py-1 flex items-center justify-center z-10">
            <div class="w-10 h-10 sm:w-11 sm:h-11 flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
              
              {tech.id === "ts" && (
                <svg class="w-9 h-9" viewBox="0 0 128 128" fill="none">
                  <rect width="128" height="128" rx="16" fill="#3178C6" />
                  <path d="M72.16 71.44h11.96c1.16 6.88 5.68 11.2 13.92 11.2 7.76 0 12.8-4.16 12.8-10.16 0-6.72-4.96-9.28-14.72-13.6-13.2-5.76-19.68-12-19.68-23.36 0-12.72 9.84-22.16 25.12-22.16 14.88 0 24.16 9.12 25.28 22.32H115.2c-1.12-6.16-5.44-9.68-12.8-9.68-6.96 0-11.28 3.92-11.28 9.2 0 5.44 3.76 8 13.36 12.16 14.4 6.24 21.04 12.56 21.04 24.56 0 14.48-11.12 23.36-26.96 23.36-17.12 0-26.08-9.44-26.4-23.84zM16 45.92h49.6v12.4H42.72V115H29.28V58.32H16v-12.4z" fill="#FFFFFF" />
                </svg>
              )}

              {tech.id === "js" && (
                <svg class="w-9 h-9" viewBox="0 0 128 128" fill="none">
                  <rect width="128" height="128" rx="16" fill="#F7DF1E" />
                  <path d="M35.6 97.4c2.8 4.6 6.6 8.3 12.6 8.3 6.3 0 10.3-3.1 10.3-15.1V42h15.2v48.8c0 20.4-11.9 29.2-26.9 29.2-12.1 0-19.1-6.1-23.2-14.7l12-7.9zm44.2-1.7c3.3 5.4 8.2 9.4 16.2 9.4 6.9 0 11.4-3.5 11.4-8.4 0-5.8-4.6-7.9-12.4-11.4l-4.2-1.8c-12.3-5.2-20.5-11.8-20.5-25.7 0-12.8 9.9-22.6 25.2-22.6 10.9 0 18.8 4.3 24.4 14.4l-12 7.7c-2.7-4.8-5.7-6.9-12.4-6.9-5.4 0-9.2 3.5-9.2 7.8 0 5.4 3.6 7.6 11.8 11.1l4.2 1.8c14.5 6.2 21.4 12.7 21.4 26.6 0 15.3-12 23.6-27.3 23.6-15.3 0-24.8-7.3-29.4-17.9l12.3-7.7z" fill="#000000" />
                </svg>
              )}

              {tech.id === "html5" && (
                <svg class="w-9 h-9" viewBox="0 0 512 512" fill="none">
