<!-- Client Orchestrator Script for Interactive Filtering & Connection Illumination -->
<script>
  function setupTechStack() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".tech-filter-btn");
    const techCards = document.querySelectorAll<HTMLElement>(".tech-card");
    const pipelineView = document.getElementById("architecture-pipeline-view");
    const techGrid = document.getElementById("tech-grid");

    if (!techCards.length) return;

    // Filter handling
    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter || "all";

        // Update active button state
        filterButtons.forEach((b) => {
          b.setAttribute("aria-pressed", "false");
          b.classList.remove("bg-[#171717]", "text-white", "border-neutral-900", "dark:bg-white", "dark:text-black", "dark:border-white");
          b.classList.add("bg-white", "dark:bg-[#101010]", "text-neutral-600", "dark:text-neutral-400", "border-neutral-200/80", "dark:border-white/10");
        });

        btn.setAttribute("aria-pressed", "true");
        btn.classList.add("bg-[#171717]", "text-white", "border-neutral-900", "dark:bg-white", "dark:text-black", "dark:border-white");
        btn.classList.remove("bg-white", "dark:bg-[#101010]", "text-neutral-600", "dark:text-neutral-400", "border-neutral-200/80", "dark:border-white/10");

        // Toggle Views
        if (filter === "architecture") {
          if (pipelineView) pipelineView.classList.remove("hidden");
          if (techGrid) techGrid.classList.add("opacity-50");
        } else {
          if (pipelineView) pipelineView.classList.remove("hidden");
          if (techGrid) techGrid.classList.remove("opacity-50");
        }

        // Filter cards in grid
        techCards.forEach((card) => {
          const cat = card.dataset.category;
          if (filter === "all" || filter === "architecture" || cat === filter) {
            card.classList.remove("hidden", "opacity-20");
            card.classList.add("opacity-100");
          } else {
            card.classList.add("opacity-20");
          }
        });
      });
    });

    // Connection Hover & Focus Illumination
    techCards.forEach((card) => {
      const handleHighlight = () => {
        const connectedIds = (card.dataset.connected || "").split(",").filter(Boolean);
        const thisId = card.dataset.id;

        techCards.forEach((other) => {
          const otherId = other.dataset.id || "";
          const badge = other.querySelector(".connected-badge");

          if (otherId === thisId) {
            other.classList.add("ring-2", "ring-cyan-400", "dark:ring-cyan-300");
            if (badge) badge.classList.add("bg-cyan-400", "scale-150");
          } else if (connectedIds.includes(otherId)) {
            other.classList.add("ring-1", "ring-emerald-400/80", "scale-[1.03]");
            other.classList.remove("opacity-40");
            if (badge) badge.classList.add("bg-emerald-400", "scale-125");
          } else {
            other.classList.add("opacity-40");
          }
        });
      };

      const handleReset = () => {
        techCards.forEach((other) => {
          other.classList.remove("ring-2", "ring-1", "ring-cyan-400", "dark:ring-cyan-300", "ring-emerald-400/80", "scale-[1.03]", "opacity-40");
          const badge = other.querySelector(".connected-badge");
          if (badge) badge.classList.remove("bg-cyan-400", "bg-emerald-400", "scale-150", "scale-125");
        });
      };

      card.addEventListener("mouseenter", handleHighlight);
      card.addEventListener("mouseleave", handleReset);
      card.addEventListener("focus", handleHighlight);
      card.addEventListener("blur", handleReset);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTechStack);
  } else {
    setupTechStack();
  }
  document.addEventListener("astro:page-load", setupTechStack);
</script>
