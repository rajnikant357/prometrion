---
// SearchModal.astro - Cmd+K Spotlight search across Prometrion
---

<div id="search-modal-backdrop" class="fixed inset-0 z-50 bg-black/50 dark:bg-black/80 backdrop-blur-sm hidden items-start justify-center pt-20 sm:pt-28 px-4 transition-opacity">
  <div id="search-modal-container" class="w-full max-w-xl bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-[#222222] rounded-[6px] shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="relative flex items-center px-4 border-b border-[#ebebeb] dark:border-[#202020]">
      <svg class="w-4 h-4 text-neutral-400 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-modal-input"
        type="text"
        placeholder="Search services, our work, store, media, pricing..."
        class="w-full py-3.5 text-sm bg-transparent text-neutral-900 dark:text-white placeholder:text-neutral-400 dark:placeholder:text-neutral-500 focus:outline-none"
      />
      <span class="text-[11px] font-mono font-medium text-neutral-400 border border-[#ebebeb] dark:border-neutral-800 bg-neutral-100 dark:bg-neutral-800/80 rounded px-1.5 py-0.5 ml-2">ESC</span>
    </div>

    <div id="search-results-list" class="max-h-80 overflow-y-auto p-2 space-y-1" data-lenis-prevent>
      <!-- Dynamic search results populated by script -->
    </div>

    <div class="px-4 py-2.5 bg-neutral-50/80 dark:bg-[#080808] border-t border-[#ebebeb] dark:border-[#202020] text-[11px] text-neutral-500 dark:text-neutral-400 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span><kbd class="font-mono bg-white dark:bg-neutral-800 border border-[#ebebeb] dark:border-neutral-700 rounded px-1 py-0.5 text-neutral-700 dark:text-neutral-300">↑↓</kbd> Navigate</span>
        <span><kbd class="font-mono bg-white dark:bg-neutral-800 border border-[#ebebeb] dark:border-neutral-700 rounded px-1 py-0.5 text-neutral-700 dark:text-neutral-300">↵</kbd> Select</span>
      </div>
      <span class="font-mono">Prometrion Fast Index</span>
    </div>
  </div>
</div>

<script>
  const searchableItems = [
    { title: "Home", category: "General", url: "/", desc: "Prometrion technology & digital services overview" },
    { title: "Services Hub", category: "Services", url: "/services", desc: "Software engineering, digital solutions & growth" },
    { title: "Website Development", category: "Services", url: "/services/website-development", desc: "High-performance enterprise & business websites" },
    { title: "App Development", category: "Services", url: "/services/app-development", desc: "Native Android & modern mobile systems" },
    { title: "SEO / GEO", category: "Services", url: "/services/seo-geo", desc: "Search Engine & Generative Engine AI Optimization" },
    { title: "Digital Presence", category: "Services", url: "/services/digital-presence", desc: "Google Business Profiles, Maps & WhatsApp" },
    { title: "Digital Branding", category: "Services", url: "/services/digital-branding", desc: "Minimalist logos, business cards & brand kits" },
    { title: "Digital Consultancy", category: "Services", url: "/services/digital-consultancy", desc: "Strategic advisory sessions & 90-day growth blueprints" },
    { title: "Maintenance & Support", category: "Services", url: "/services/maintenance-support", desc: "Backups, security scans & monthly developer care plans" },
    { title: "Ready Solutions Catalog", category: "Services", url: "/services/catalog", desc: "Production business systems in INR" },
    { title: "Service Packages", category: "Services", url: "/services/packages", desc: "Starter, Business, Digital Growth & Complete bundles" },
    { title: "Our Work & Portfolio", category: "Work", url: "/work", desc: "Production systems, client case studies & capabilities" },
    { title: "Store Hub", category: "Store", url: "/store", desc: "Software systems, ready web solutions & mobile apps" },
    { title: "Webstore (Live Projects)", category: "Store", url: "/store/webstore", desc: "Production websites, web apps & digital experiences" },
    { title: "Sharpr", category: "Webstore", url: "/store/webstore/sharpr", desc: "Innovative EdTech learning platform" },
    { title: "Paperfolio", category: "Webstore", url: "/store/webstore/paperfolio", desc: "Interactive portfolio of Rajnikant Gaurav" },
    { title: "Ultron 3D Orb", category: "Webstore", url: "/store/webstore/ultron", desc: "Holographic 3D orb with hand gestures" },
    { title: "Qualytics AI", category: "Webstore", url: "/store/webstore/qualytics-ai", desc: "Enterprise data observability & quality platform" },
    { title: "LocalLink", category: "Webstore", url: "/store/webstore/locallink", desc: "Hyperlocal on-demand service provider marketplace" },
    { title: "Gazal Suit Ghar", category: "Webstore", url: "/store/webstore/gazal-suit-ghar", desc: "Ethnic wear e-commerce boutique & Banarasi sarees" },
    { title: "Pankaj Consultancy", category: "Webstore", url: "/store/webstore/pankaj-consultancy", desc: "Real estate & property financial advisory" },
    { title: "Alankarini Mehandi Art", category: "Webstore", url: "/store/webstore/alankarini-mehandi-art", desc: "Bridal mehandi artist & 35-day certified academy" },
    { title: "Paper UI Admin Dashboard", category: "Webstore", url: "/store/webstore/paper-ui-admin-dashboard", desc: "Sketch & papercraft developer dashboard" },
    { title: "Pac Man Clone", category: "Webstore", url: "/store/webstore/pac-man-clone", desc: "Retro Chomper arcade maze game" },
    { title: "Quiz Game", category: "Webstore", url: "/store/webstore/quiz-game", desc: "Interactive trivia challenge game" },
    { title: "Skribble Clone", category: "Webstore", url: "/store/webstore/skribble-clone", desc: "Multiplayer drawing & guessing pictionary game" },
    { title: "Zacson Gym", category: "Webstore", url: "/store/webstore/zacson", desc: "Fitness & personal gym training template" },
    { title: "Study Academy 1", category: "Webstore", url: "/store/webstore/study-academy-1", desc: "Online academic learning portal" },
    { title: "Study Academy 2", category: "Webstore", url: "/store/webstore/study-academy-2", desc: "Next-gen academic learning & course portal" },
    { title: "Prometrion AI", category: "Webstore", url: "/store/webstore/prometrion-ai", desc: "Autonomous AI agent & reasoning interface" },
    { title: "Appstore", category: "Store", url: "/store/appstore", desc: "Android applications & mobile systems" },
    { title: "Prometrion Console", category: "Appstore", url: "/store/appstore/prometrion-console", desc: "Edge deployment telemetry, live logs & incident alerts" },
    { title: "Taluq Agent Mobile", category: "Appstore", url: "/store/appstore/taluq-mobile", desc: "Multimodal AI assistant with voice & vision streaming" },
    { title: "Secure Auth Key", category: "Appstore", url: "/store/appstore/secure-auth-key", desc: "Hardware Keystore FIDO2 & Passkey authenticator" },
    { title: "Coders Club Guild Client", category: "Appstore", url: "/store/appstore/coders-club-guild", desc: "Developer community, hackathons & code challenges" },
    { title: "Edge Telemetry Monitor", category: "Appstore", url: "/store/appstore/edge-telemetry", desc: "Global edge latency tester & DNS propagation toolkit" },
    { title: "Prometrion Cloud Vault", category: "Appstore", url: "/store/appstore/cloud-vault", desc: "Zero-knowledge encrypted client secrets manager" },
    { title: "Media Hub", category: "Media", url: "/media", desc: "Engineering blog, company news, and milestones" },
    { title: "Blogs", category: "Media", url: "/media/blogs", desc: "Deep technical articles and business insights" },
    { title: "Guides & Insights", category: "Media", url: "/media/guides", desc: "Practical checklists, architecture decision frameworks & cost guides" },
    { title: "Official News", category: "Media", url: "/media/news", desc: "Announcements, releases, and milestones" },
    { title: "Company Achievements", category: "Media", url: "/media/achievements", desc: "Chronological milestone timeline" },
    { title: "People & Leadership", category: "Media", url: "/media/people", desc: "Builders, team members, and leadership" },
    { title: "Guide: Website Development Cost Factors", category: "Guides", url: "/media/blogs/website-development-cost-factors", desc: "Pricing tiers, dynamic feature costs, and estimating accuracy" },
    { title: "Guide: Custom Websites vs Templates", category: "Guides", url: "/media/blogs/custom-websites-vs-templates", desc: "Why custom engineering beats generic templates for growth and SEO" },
    { title: "Guide: How to Plan a Business Website", category: "Guides", url: "/media/blogs/how-to-plan-a-business-website", desc: "Actionable 5-stage roadmap: goals, content, features, and launch" },
    { title: "Guide: Preparing a Software Project Brief", category: "Guides", url: "/media/blogs/preparing-a-software-project-brief", desc: "How to draft an effective brief for agencies and developers" },
    { title: "Blog: How to Choose the Right Website", category: "Blogs", url: "/media/blogs/how-to-choose-the-right-website-for-your-business", desc: "Match your business model to portfolio, corporate, catalogue, or app" },
    { title: "Blog: Website vs Catalogue vs E-Commerce", category: "Blogs", url: "/media/blogs/website-vs-catalogue-vs-ecommerce", desc: "Understanding customer purchase journeys and catalog requirements" },
    { title: "Blog: SEO and GEO AI Visibility", category: "Blogs", url: "/media/blogs/seo-and-geo-business-visibility", desc: "Optimizing for Google, Perplexity, ChatGPT, and AI recommendation engines" },
    { title: "Blog: When Does a Business Need a Mobile App?", category: "Blogs", url: "/media/blogs/when-does-a-business-need-a-mobile-app", desc: "Workflow evaluation for native Android and dynamic applications" },
    { title: "Blog: Digital Presence Beyond a Website", category: "Blogs", url: "/media/blogs/digital-presence-beyond-a-website", desc: "Google Business Profiles, Maps, WhatsApp, and social verification" },
    { title: "Blog: Why Website Maintenance Matters", category: "Blogs", url: "/media/blogs/why-website-maintenance-matters", desc: "Backups, uptime tracking, security checks, and operational care" },
    { title: "Blog: How to Choose a Digital Service Package", category: "Blogs", url: "/media/blogs/how-to-choose-a-digital-service-package", desc: "Selecting between Starter, Standard, Growth, and Advanced tiers" },
    { title: "Blog: From Digital Presence to Digital Growth", category: "Blogs", url: "/media/blogs/from-digital-presence-to-digital-growth", desc: "Staged approach to scaling digital infrastructure and conversion" },
    { title: "Pricing & Retainers", category: "Pricing", url: "/pricing", desc: "Transparent pricing matrix, retainers & add-ons" },
    { title: "Project Cost Estimator", category: "Tools", url: "/estimate", desc: "Interactive project scope and indicative pricing calculator" },
    { title: "Request a Formal Quote", category: "Contact", url: "/request-quote", desc: "Submit your brief for an itemized Statement of Work (SOW)" },
    { title: "Book a Consultation", category: "Services", url: "/book-consultation", desc: "Schedule a 1-on-1 strategic advisory session with architects" },
    { title: "About Prometrion", category: "Company", url: "/about", desc: "Our mission, philosophy, culture, and architecture" },
    { title: "Contact & Consultations", category: "Contact", url: "/contact", desc: "Get a quote, email, phone, WhatsApp & enquiries" },
    { title: "Sign In", category: "Account", url: "/account/signin", desc: "Account Portal — We are working for you" },
    { title: "Create Account", category: "Account", url: "/account/signup", desc: "Account Registration — We are working for you" },
  ];

  const backdrop = document.getElementById("search-modal-backdrop");
  const input = document.getElementById("search-modal-input") as HTMLInputElement;
  const resultsContainer = document.getElementById("search-results-list");
  let selectedIndex = 0;
  let currentResults: typeof searchableItems = [];

  function openSearch() {
    backdrop?.classList.remove("hidden");
    backdrop?.classList.add("flex");
    input?.focus();
    renderResults(input?.value || "");
  }

  function closeSearch() {
    backdrop?.classList.add("hidden");
    backdrop?.classList.remove("flex");
    if (input) input.value = "";
  }

  function renderResults(query: string) {
    if (!resultsContainer) return;
    const q = query.toLowerCase().trim();
    currentResults = q
      ? searchableItems.filter(item => item.title.toLowerCase().includes(q) || item.desc.toLowerCase().includes(q) || item.category.toLowerCase().includes(q))
      : searchableItems.slice(0, 8);

    selectedIndex = 0;

    if (currentResults.length === 0) {
      resultsContainer.innerHTML = `
        <div class="py-8 text-center text-sm text-neutral-400">
          No matches found for "<span class="font-medium text-neutral-700">${query}</span>"
        </div>
      `;
      return;
    }

    resultsContainer.innerHTML = currentResults.map((item, index) => `
      <a
        href="${item.url}"
        class="search-item flex items-center justify-between p-2.5 rounded-lg text-sm text-neutral-800 dark:text-neutral-200 transition ${index === selectedIndex ? 'bg-neutral-100 dark:bg-neutral-800 text-black dark:text-white' : 'hover:bg-neutral-50 dark:hover:bg-neutral-900/80'}"
        data-index="${index}"
      >
        <div class="flex flex-col">
          <span class="font-medium text-neutral-900 dark:text-white">${item.title}</span>
          <span class="text-xs text-neutral-500 dark:text-neutral-400">${item.desc}</span>
        </div>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 border border-[#ebebeb] dark:border-neutral-700 shrink-0 ml-2">
          ${item.category}
        </span>
      </a>
    `).join("");
  }

  // Keyboard shortcut listener
  window.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      if (backdrop?.classList.contains("hidden")) {
        openSearch();
      } else {
        closeSearch();
      }
    } else if (e.key === "Escape" && !backdrop?.classList.contains("hidden")) {
      closeSearch();
    }
  });

  input?.addEventListener("input", (e) => {
    renderResults((e.target as HTMLInputElement).value);
  });

  input?.addEventListener("keydown", (e) => {
    const items = resultsContainer?.querySelectorAll(".search-item");
    if (!items || items.length === 0) return;

    if (e.key === "ArrowDown") {
      e.preventDefault();
      selectedIndex = (selectedIndex + 1) % currentResults.length;
      updateHighlight(items);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      selectedIndex = (selectedIndex - 1 + currentResults.length) % currentResults.length;
      updateHighlight(items);
    } else if (e.key === "Enter" && currentResults[selectedIndex]) {
      e.preventDefault();
      window.location.href = currentResults[selectedIndex].url;
    }
  });

  function updateHighlight(items: NodeListOf<Element>) {
    items.forEach((el, idx) => {
      if (idx === selectedIndex) {
        el.classList.add("bg-neutral-100", "text-black");
        el.scrollIntoView({ block: "nearest" });
      } else {
        el.classList.remove("bg-neutral-100", "text-black");
      }
    });
  }

  backdrop?.addEventListener("click", (e) => {
    if (e.target === backdrop) closeSearch();
  });

  // Global trigger hooks
  document.querySelectorAll("[data-open-search]").forEach(btn => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      openSearch();
    });
  });
</script>
