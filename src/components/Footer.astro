          <li><a href="/products" class="hover:text-black dark:hover:text-white transition">Prometrion Cloud</a></li>
          <li><a href="/products" class="hover:text-black dark:hover:text-white transition">Autonomous Agents</a></li>
          <li><a href="/products" class="hover:text-black dark:hover:text-white transition">Developer CLI</a></li>
          <li><a href="/products" class="hover:text-black dark:hover:text-white transition">Secure Sandboxes</a></li>
        </ul>
      </div>

      <!-- Col 3: Store -->
      <div class="space-y-3">
