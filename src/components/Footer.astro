---
// Footer.astro - Multi-column global footer with Explore Section, Theme Switcher & Technical Details
---

<footer class="w-full border-t border-[#ebebeb] dark:border-[#202020] bg-[#fafafa] dark:bg-black pt-16 pb-12 text-sm text-neutral-600 dark:text-neutral-400 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Grid: 6 Columns including Explore -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 lg:gap-8 pb-16 border-b border-[#ebebeb] dark:border-[#202020]">
      
      <!-- Col 1: Explore (Featured Section with Theme Toggle) -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white font-mono flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Explore
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/store" class="hover:text-black dark:hover:text-white transition">Themes</a></li>
          <li><a href="/store/webstore" class="hover:text-black dark:hover:text-white transition">Templates</a></li>
          <li><a href="/store/components" class="hover:text-black dark:hover:text-white transition">Components</a></li>
          <li><a href="/articles/docs#skills-registry" class="hover:text-black dark:hover:text-white transition">Skills</a></li>
          <li><a href="/services/catalog" class="hover:text-black dark:hover:text-white transition">Solutions Catalog</a></li>
          <li><a href="/store/appstore" class="hover:text-black dark:hover:text-white transition">Appstore Directory</a></li>
        </ul>

        <!-- Theme Toggle Button inside Explore Section -->
        <div class="pt-2">
          <button
            id="theme-toggle-btn"
            class="w-full flex items-center justify-between px-3 py-1.5 rounded-lg text-xs font-mono border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#141414] text-neutral-800 dark:text-neutral-200 hover:border-neutral-400 dark:hover:border-emerald-400/50 shadow-whisper transition cursor-pointer group"
            aria-label="Toggle theme appearance"
            title="Switch between Dark and Light mode"
          >
            <div class="flex items-center gap-2">
              <!-- Sun Icon (shown in Dark Mode) -->
              <svg id="theme-sun-icon" class="w-3.5 h-3.5 text-amber-400 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <!-- Moon Icon (shown in Light Mode) -->
              <svg id="theme-moon-icon" class="w-3.5 h-3.5 text-cyan-500 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
              <span id="theme-status-text" class="text-[11px]">Dark Mode</span>
            </div>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 group-hover:scale-125 transition-transform"></span>
          </button>
        </div>
      </div>

      <!-- Col 2: Products -->
      <div class="space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[#171717] dark:text-white font-mono">
