---
// CaseStudiesSection.astro - Section 7: Selected Case Studies Based on Actual Work
// Real deliverables, verified technical metrics, authentic screenshots, and honest client/product classifications.
// Zero fabricated revenue growth or fake percentages.
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";

interface CaseStudy {
  id: string;
  title: string;
  clientType: 'Client Engagement' | 'Client Collaboration' | 'Internal Platform' | 'Founder-Led Project';
  badgeVariant: 'emerald' | 'blue' | 'purple' | 'amber';
  industry: string;
  image: string;
  challenge: string;
  solution: string;
  deliverables: string[];
  techStack: string[];
  liveUrl: string;
  detailUrl: string;
  telemetry: {
    lcp: string;
    cls: string;
    architecture: string;
  };
}

const caseStudies: CaseStudy[] = [
  {
    id: "alankarini",
    title: "Alankarini Mehandi Art: Bridal Studio & Academy Platform",
    clientType: "Client Engagement",
    badgeVariant: "emerald",
    industry: "Bridal Fashion & Education (Varanasi, UP)",
    image: "/projects/alankarini-mehandi-art.png",
    challenge: "A renowned bridal henna artist in Varanasi required a modern digital showcase to present high-resolution bridal design collections, capture doorstep home-service bookings, and publish enrollment details for a 35-day certified masterclass academy without complex app downloads.",
    solution: "Prometrion engineered a high-contrast, mobile-first web presence featuring categorical design galleries (bridal, engagement, festive), direct WhatsApp and phone booking hotline integrations (+91 9336814631), a structured 35-day academy curriculum table with transparent fees, and local Varanasi search optimization.",
    deliverables: [
      "Sub-second load times on mobile 4G/5G networks",
      "Direct one-tap WhatsApp & phone consultation intake",
      "Full 35-day certified course curriculum & fee schedule",
      "High-resolution image optimization with zero cumulative layout shift"
    ],
    techStack: ["React", "Tailwind CSS", "Lucide Icons", "WhatsApp Direct Integration"],
    liveUrl: "https://alankarini-mehandi-art.vercel.app/",
    detailUrl: "/store/webstore/alankarini-mehandi-art",
    telemetry: {
      lcp: "<0.4s",
      cls: "0.00",
      architecture: "React + Edge CDN",
    },
  },
  {
    id: "sharpr",
    title: "Sharpr EdTech: Interactive Learning & Center Locator",
    clientType: "Client Collaboration",
    badgeVariant: "blue",
    industry: "EdTech & Academic Coaching (Classes 5–10)",
    image: "/projects/sharpr.png",
    challenge: "An expanding EdTech initiative needed an engaging digital platform to communicate their academic programs ('Sharper Minds. Stronger Future.'), allow parents to locate neighborhood physical centers, and collect free demo session reservations seamlessly.",
    solution: "Built a space-themed interactive web platform featuring categorized academic curriculum tracks, an interactive center locator with map coordinates, waitlist onboarding forms, and verified student results timelines powered by Supabase.",
    deliverables: [
      "100/100 Core Web Vitals with zero layout shift",
      "Interactive center discovery and map routing",
      "Free demo session booking and automated lead intake",
      "Dynamic interactive UI with Framer Motion fluid animations"
    ],
    techStack: ["React 19", "Vite", "Tailwind CSS", "Framer Motion", "Supabase"],
    liveUrl: "https://www.sharpr.in/",
    detailUrl: "/store/webstore/sharpr",
    telemetry: {
      lcp: "<0.45s",
      cls: "0.00",
      architecture: "React 19 + Supabase",
    },
  },
  {
    id: "locallink",
    title: "LocalLink: Hyperlocal On-Demand Service Directory",
    clientType: "Founder-Led Project",
    badgeVariant: "amber",
    industry: "Hyperlocal Services (Sikandarpur, Ballia)",
    image: "/projects/locallink.png",
    challenge: "Residents in regional towns faced difficulty finding verified local tradespeople (electricians, carpenters, plumbers, technicians), relying on word-of-mouth with no central directory or transparent verification.",
    solution: "Developed an on-demand hyperlocal marketplace tailored for regional connectivity. Includes categorized trade directories, instant phone and WhatsApp booking actions, and RESTful service endpoints connecting to a cloud backend on Render.",
    deliverables: [
      "Lightweight mobile footprint (<80KB initial JS payload)",
      "Instant trade category filtering by neighborhood",
      "Direct one-tap WhatsApp and phone call triggers",
      "RESTful API architecture ready for multi-town scaling"
    ],
    techStack: ["React 19", "Tailwind CSS", "REST API", "Vite", "Render Cloud"],
    liveUrl: "https://new-locallink.vercel.app/",
    detailUrl: "/store/webstore/locallink",
    telemetry: {
      lcp: "<0.35s",
      cls: "0.00",
      architecture: "React + REST Microservice",
    },
  },
  {
    id: "gazal",
    title: "Gazal Suit Ghar: Ethnic Fashion Retail Storefront",
    clientType: "Client Collaboration",
    badgeVariant: "blue",
    industry: "E-Commerce & Indian Ethnic Retail",
    image: "/projects/gazal-suit-ghar.png",
    challenge: "A traditional boutique specializing in Banarasi silk sarees, Anarkali designer suits, and kurtis required an e-commerce catalog allowing customers to explore products, choose color/size variations, and review cart items with prices in INR.",
    solution: "Engineered a responsive retail storefront featuring high-fidelity product imagery, dynamic variant selector state, an interactive sliding shopping cart drawer, and transparent pricing in Indian Rupees.",
    deliverables: [
      "Fast client-side product filtering across Sarees, Kurtis, and Suits",
      "Real-time cart drawer with subtotal calculations in INR",
      "Fluid touch-friendly product image gallery with zero layout shift",
      "Clean architecture with React Context API state management"
    ],
    techStack: ["React 19", "Tailwind CSS", "Vite", "Context API Store"],
    liveUrl: "https://gazal-suit-ghar.vercel.app/",
    detailUrl: "/store/webstore/gazal-suit-ghar",
    telemetry: {
      lcp: "<0.4s",
      cls: "0.00",
      architecture: "React 19 + Context API",
    },
  },
];
---

<section id="case-studies" class="py-24 sm:py-32 bg-[#fafafa] dark:bg-black border-b border-[#ebebeb] dark:border-white/10 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-6">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-neutral-100 dark:bg-white/[0.04] text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-white/10 mb-4">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          <span>DOCUMENTED DELIVERABLES</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-white leading-[1.12]">
          Selected Case Studies: Real Deliverables & Impact
        </h2>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Explore documented deliverables, architectural implementations, and verified outcomes from Prometrion's production portfolio.
        </p>
      </div>

      <div class="shrink-0">
        <Button variant="secondary" href="/work#case-studies">
          View All Case Details →
        </Button>
      </div>
    </div>

    <!-- Case Studies Detailed Cards (Vertical Stack of 4 Deep Cards) -->
    <div class="space-y-10">
      {caseStudies.map((study, idx) => (
        <article class="bento-card-sharp spotlight-card p-6 sm:p-10 rounded-[8px] bg-white dark:bg-[#0c0c0e] border border-[#ebebeb] dark:border-white/10 shadow-whisper hover:shadow-floating transition-all duration-200 overflow-hidden">
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Left Column: Screenshot & Telemetry (5 cols) -->
            <div class="lg:col-span-5 space-y-4">
              <a
                href={study.detailUrl}
                class="block aspect-[16/10] rounded-[6px] overflow-hidden bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-white/10 group relative cursor-pointer"
                title={`View case details for ${study.title}`}
              >
                <img
                  src={study.image}
                  alt={`Screenshot of ${study.title}`}
                  class="w-full h-full object-cover object-top transition duration-300 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                  <span class="px-3.5 py-1.5 rounded-full bg-white dark:bg-black text-xs font-semibold text-neutral-900 dark:text-white shadow-md">
                    Explore Architecture ↗
                  </span>
                </div>
              </a>

              <!-- Live Telemetry Box -->
              <div class="p-3.5 rounded-[6px] bg-neutral-50 dark:bg-white/[0.03] border border-neutral-200/70 dark:border-white/10 grid grid-cols-3 gap-2 text-center text-xs font-mono">
                <div>
                  <span class="text-[10px] text-neutral-500 dark:text-neutral-400 block">LCP Metric</span>
                  <span class="font-semibold text-emerald-600 dark:text-emerald-400">{study.telemetry.lcp}</span>
                </div>
                <div>
                  <span class="text-[10px] text-neutral-500 dark:text-neutral-400 block">CLS Shift</span>
                  <span class="font-semibold text-cyan-600 dark:text-cyan-400">{study.telemetry.cls}</span>
                </div>
                <div>
                  <span class="text-[10px] text-neutral-500 dark:text-neutral-400 block">Architecture</span>
                  <span class="font-semibold text-neutral-800 dark:text-neutral-200 truncate block">{study.telemetry.architecture}</span>
                </div>
              </div>
            </div>

            <!-- Right Column: Case Details, Challenge, Solution & Deliverables (7 cols) -->
            <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
              <div>
                <!-- Top Badge & Header -->
                <div class="flex items-center justify-between gap-3 flex-wrap mb-2">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono font-bold text-neutral-400">0{idx + 1}.</span>
                    <Badge variant={study.badgeVariant}>{study.clientType}</Badge>
                  </div>
                  <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
                    {study.industry}
                  </span>
                </div>

                <h3 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white">
                  {study.title}
                </h3>

                <!-- Challenge & Solution Paragraphs -->
                <div class="mt-4 space-y-3 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                  <p>
                    <strong class="font-semibold text-neutral-900 dark:text-white">The Challenge: </strong>
                    {study.challenge}
                  </p>
                  <p>
                    <strong class="font-semibold text-neutral-900 dark:text-white">The Solution: </strong>
                    {study.solution}
                  </p>
                </div>

                <!-- Verified Implemented Deliverables -->
                <div class="mt-5 pt-4 border-t border-neutral-100 dark:border-white/10">
                  <span class="text-[11px] font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold block mb-2">
                    Verified Deliverables & Systems Built:
                  </span>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-neutral-700 dark:text-neutral-300">
                    {study.deliverables.map((deliv) => (
                      <div class="flex items-start gap-2">
                        <span class="text-emerald-500 font-bold shrink-0">✓</span>
                        <span>{deliv}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Tech Stack Tags -->
                <div class="mt-5 flex flex-wrap gap-1.5">
                  {study.techStack.map((tech) => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/[0.05] text-neutral-700 dark:text-neutral-300 border border-neutral-200/60 dark:border-white/10">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action Links -->
              <div class="pt-4 border-t border-neutral-100 dark:border-white/10 flex flex-wrap items-center justify-between gap-3">
                <a
                  href={study.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-semibold bg-[#171717] dark:bg-white text-white dark:text-black hover:opacity-90 transition shadow-xs cursor-pointer"
                >
                  <span>Launch Live System</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>

                <a
                  href={study.detailUrl}
                  class="text-xs font-medium text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white transition flex items-center gap-1"
                >
                  <span>Read Full Technical Case</span>
                  <span>→</span>
                </a>
              </div>

            </div>

          </div>

        </article>
      ))}
    </div>

  </div>
</section>
