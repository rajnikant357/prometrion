---
// WireframeGlobe.astro - 3D WebGL Wireframe Globe with Coordinate Mapping & Rotating Render Loop
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'hero' | 'full';
  title?: string;
  badge?: string;
  class?: string;
  glow?: 'cyan' | 'emerald' | 'combo' | 'aurora';
  background?: boolean;
  aurora?: boolean;
}

const {
  size = 'md',
  title = 'Global Anycast Edge Network',
  badge = '300+ Edge Nodes Active',
  class: className = '',
  glow = 'combo',
  background = false,
  aurora = false,
} = Astro.props;

const sizeHeights: Record<string, string> = {
  sm: 'h-[280px]',
  md: 'h-[380px] sm:h-[440px]',
  lg: 'h-[460px] sm:h-[540px]',
  hero: 'h-[500px] sm:h-[620px]',
  full: 'h-full',
};
---

{background ? (
  <div 
    class={`wireframe-globe-container relative w-full h-full bg-transparent border-0 rounded-none overflow-visible pointer-events-none ${className}`}
    data-globe-background="true"
    data-globe-aurora={aurora ? "true" : undefined}
  >
    {aurora && (
      <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center overflow-visible">
        <div class="aurora-light-glow"></div>
        <div class="aurora-light-ribbon"></div>
      </div>
    )}
    <!-- WebGL Three.js Canvas Container for Background -->
    <canvas class="webgl-globe-canvas w-full h-full block pointer-events-none"></canvas>
  </div>
) : (
  <div class={`wireframe-globe-container relative w-full ${sizeHeights[size] || sizeHeights.md} rounded-[6px] overflow-hidden bg-black/40 dark:bg-black border border-[#ebebeb] dark:border-white/10 ${className}`}>
    <!-- Atmospheric Glow Backdrop -->
    <div class="absolute inset-0 pointer-events-none -z-0 flex items-center justify-center">
      <div class="w-[320px] sm:w-[420px] h-[320px] sm:h-[420px] rounded-full bg-radial from-cyan-500/15 via-emerald-500/10 to-transparent blur-3xl opacity-75 dark:opacity-90"></div>
    </div>

    <!-- Top Status Badge & Title Overlay -->
    <div class="absolute top-4 left-4 sm:top-6 sm:left-6 z-10 pointer-events-none">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-[11px] font-mono font-medium bg-black/60 dark:bg-white/10 text-cyan-400 dark:text-cyan-300 border border-cyan-500/30 dark:border-white/15 backdrop-blur-md shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>{badge}</span>
      </div>
      {title && (
        <h3 class="text-base sm:text-lg font-semibold text-white tracking-tight mt-2 font-sans drop-shadow-md">
          {title}
        </h3>
      )}
    </div>

    <!-- Realtime Telemetry Strip (Bottom) -->
    <div class="absolute bottom-4 left-4 right-4 sm:bottom-6 sm:left-6 sm:right-6 z-10 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-neutral-400 bg-black/70 dark:bg-[#0c0c0c]/80 border border-white/10 backdrop-blur-md px-3.5 py-2 rounded-[6px]">
      <div class="flex items-center gap-3">
        <span class="text-white font-medium flex items-center gap-1.5">
          <span class="text-emerald-400">●</span> Live Telemetry
        </span>
        <span class="hidden sm:inline text-neutral-500">|</span>
        <span class="hidden sm:inline text-neutral-300">Rotational Speed: <strong class="text-cyan-400">0.24°/frame</strong></span>
      </div>
      <div class="flex items-center gap-3 text-[10px] sm:text-[11px]">
        <span>Global Latency: <strong class="text-emerald-400">&lt;18ms</strong></span>
        <span>Routing: <strong class="text-white">BGP Anycast</strong></span>
      </div>
    </div>

    <!-- Hover Tooltip Tag -->
    <div 
      class="globe-tooltip absolute z-20 pointer-events-none hidden px-2.5 py-1 rounded-md bg-neutral-900/90 text-white border border-cyan-400/50 text-[10px] font-mono backdrop-blur-md shadow-lg transition-transform duration-75"
    ></div>

    <!-- WebGL Three.js Canvas Container -->
    <canvas class="webgl-globe-canvas w-full h-full block cursor-grab active:cursor-grabbing"></canvas>
  </div>
)}

<script>
  import * as THREE from 'three';

  interface CityNode {
    name: string;
    lat: number;
    lng: number;
    type: 'flagship' | 'pop' | 'edge';
    latency: string;
  }

  // Real-world Coordinate Database
  const GLOBAL_NODES: CityNode[] = [
    { name: 'San Francisco PoP', lat: 37.7749, lng: -122.4194, type: 'flagship', latency: '12ms' },
    { name: 'New York Gateway', lat: 40.7128, lng: -74.0060, type: 'pop', latency: '16ms' },
    { name: 'London Central', lat: 51.5074, lng: -0.1278, type: 'pop', latency: '14ms' },
    { name: 'Frankfurt Core', lat: 50.1109, lng: 8.6821, type: 'flagship', latency: '11ms' },
    { name: 'Mumbai Edge Core', lat: 19.0760, lng: 72.8777, type: 'flagship', latency: '8ms' },
    { name: 'Bengaluru R&D Hub', lat: 12.9716, lng: 77.5946, type: 'flagship', latency: '9ms' },
    { name: 'Singapore Transit', lat: 1.3521, lng: 103.8198, type: 'pop', latency: '15ms' },
    { name: 'Tokyo FastPoP', lat: 35.6762, lng: 139.6503, type: 'pop', latency: '18ms' },
    { name: 'Sydney Edge', lat: -33.8688, lng: 151.2093, type: 'edge', latency: '24ms' },
    { name: 'São Paulo Transit', lat: -23.5505, lng: -46.6333, type: 'edge', latency: '28ms' },
    { name: 'Dubai Gateway', lat: 25.2048, lng: 55.2708, type: 'pop', latency: '19ms' },
    { name: 'Johannesburg Node', lat: -26.2041, lng: 28.0473, type: 'edge', latency: '35ms' },
    { name: 'Amsterdam IXP', lat: 52.3676, lng: 4.9041, type: 'pop', latency: '13ms' },
    { name: 'Seoul Edge', lat: 37.5665, lng: 126.9780, type: 'pop', latency: '17ms' },
    { name: 'Toronto Anycast', lat: 43.6532, lng: -79.3832, type: 'edge', latency: '19ms' },
  ];

  // Primary network connections (Great circle arcs)
  const NETWORK_ARCS: [string, string][] = [
    ['Mumbai Edge Core', 'Frankfurt Core'],
    ['Mumbai Edge Core', 'Singapore Transit'],
    ['Bengaluru R&D Hub', 'Mumbai Edge Core'],
    ['Frankfurt Core', 'London Central'],
    ['London Central', 'New York Gateway'],
    ['New York Gateway', 'San Francisco PoP'],
    ['San Francisco PoP', 'Tokyo FastPoP'],
    ['Tokyo FastPoP', 'Singapore Transit'],
    ['Singapore Transit', 'Sydney Edge'],
    ['Frankfurt Core', 'Dubai Gateway'],
    ['Dubai Gateway', 'Mumbai Edge Core'],
    ['New York Gateway', 'São Paulo Transit'],
  ];

  function initWireframeGlobe(container: HTMLElement) {
    const canvas = container.querySelector<HTMLCanvasElement>('.webgl-globe-canvas');
    const tooltip = container.querySelector<HTMLElement>('.globe-tooltip');
    if (!canvas) return;

    const width = container.clientWidth || 600;
    const height = container.clientHeight || 400;

    // 1. Scene, Camera & WebGL Renderer
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
    camera.position.z = 210;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: 'high-performance',
    });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // Master Group for continuous rotation
    const globeGroup = new THREE.Group();
    // Default tilt
    globeGroup.rotation.x = 0.28;
    globeGroup.rotation.y = -0.6;
    scene.add(globeGroup);

    const GLOBE_RADIUS = 72;
    const isAurora = container.dataset.globeAurora === 'true';

    // 2. Wireframe Geometry: Base 3D Sphere geometry with wireframe: true
    const sphereGeometry = new THREE.SphereGeometry(GLOBE_RADIUS, 36, 24);
    
    // Outer luminous wireframe material revealing longitude and latitude segments
    const wireframeMaterial = new THREE.MeshBasicMaterial({
      color: 0x38bdf8,
      wireframe: true,
      transparent: true,
      opacity: isAurora ? 0.38 : 0.28,
    });
    const wireframeSphere = new THREE.Mesh(sphereGeometry, wireframeMaterial);
    globeGroup.add(wireframeSphere);

    // Inner subtle dense wireframe core for depth (light green / emerald)
    const innerGeometry = new THREE.SphereGeometry(GLOBE_RADIUS * 0.985, 24, 16);
    const innerMaterial = new THREE.MeshBasicMaterial({
      color: 0x00F5A0,
      wireframe: true,
      transparent: true,
      opacity: isAurora ? 0.22 : 0.12,
    });
    const innerSphere = new THREE.Mesh(innerGeometry, innerMaterial);
    globeGroup.add(innerSphere);

    // Dark solid occlusion core so back side of globe is soft and visible through wireframe
    const coreGeometry = new THREE.SphereGeometry(GLOBE_RADIUS * 0.97, 32, 24);
    const coreMaterial = new THREE.MeshBasicMaterial({
      color: 0x030712,
      transparent: true,
      opacity: isAurora ? 0.65 : 0.85,
    });
    const coreSphere = new THREE.Mesh(coreGeometry, coreMaterial);
    globeGroup.add(coreSphere);

    // Subtle atmospheric glowing ring
    const ringGeometry = new THREE.RingGeometry(GLOBE_RADIUS * 1.08, GLOBE_RADIUS * 1.15, 64);
    const ringMaterial = new THREE.MeshBasicMaterial({
      color: 0x00dfd8,
      side: THREE.DoubleSide,
      transparent: true,
      opacity: isAurora ? 0.28 : 0.18,
    });
    const ringMesh = new THREE.Mesh(ringGeometry, ringMaterial);
    ringMesh.rotation.x = Math.PI / 2;
    globeGroup.add(ringMesh);

    // 3. Coordinate Mapping: Convert (Lat, Lng) to 3D Space (X, Y, Z)
    function latLngToVector3(lat: number, lng: number, radius: number): THREE.Vector3 {
      const phi = (90 - lat) * (Math.PI / 180);
      const theta = (lng + 180) * (Math.PI / 180);
      const x = -(radius * Math.sin(phi) * Math.cos(theta));
      const z = radius * Math.sin(phi) * Math.sin(theta);
      const y = radius * Math.cos(phi);
      return new THREE.Vector3(x, y, z);
    }

    // Glowing Triangles & Beacon Markers
    const nodeMeshes: { mesh: THREE.Mesh; node: CityNode; pos: THREE.Vector3 }[] = [];
    const nodeGroup = new THREE.Group();
    globeGroup.add(nodeGroup);

    // Shared glowing materials for triangles
    const cyanMaterial = new THREE.MeshBasicMaterial({ color: 0x38bdf8 });
    const emeraldMaterial = new THREE.MeshBasicMaterial({ color: 0x00F5A0 });

    GLOBAL_NODES.forEach((node) => {
      const pos = latLngToVector3(node.lat, node.lng, GLOBE_RADIUS);

      // Glowing Triangle geometry: Cone with 3 radial segments = 3D Tetrahedron / Triangle pyramid!
      const triangleGeometry = new THREE.ConeGeometry(
        node.type === 'flagship' ? 2.4 : 1.8,
        node.type === 'flagship' ? 5.5 : 4.0,
        3
      );
      
      const mat = node.type === 'flagship' ? emeraldMaterial : cyanMaterial;
      const triangleMesh = new THREE.Mesh(triangleGeometry, mat);

      // Position triangle at coordinate surface
      triangleMesh.position.copy(pos);

      // Orient triangle pointing outward along sphere normal
      const normal = pos.clone().normalize();
      triangleMesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), normal);

      nodeGroup.add(triangleMesh);

      // Add a glowing halo ring flat on the surface beneath each triangle
      const haloGeo = new THREE.RingGeometry(1.6, 2.8, 16);
      const haloMat = new THREE.MeshBasicMaterial({
        color: node.type === 'flagship' ? 0x00F5A0 : 0x38bdf8,
        side: THREE.DoubleSide,
        transparent: true,
        opacity: 0.6,
      });
      const haloMesh = new THREE.Mesh(haloGeo, haloMat);
      haloMesh.position.copy(pos.clone().add(normal.clone().multiplyScalar(0.2)));
      haloMesh.lookAt(pos.clone().add(normal));
      nodeGroup.add(haloMesh);

      nodeMeshes.push({ mesh: triangleMesh, node, pos });
    });

    // 4. Arc Lines connecting coordinates
    const arcGroup = new THREE.Group();
    globeGroup.add(arcGroup);

    NETWORK_ARCS.forEach(([startName, endName]) => {
      const startNode = GLOBAL_NODES.find((n) => n.name === startName);
      const endNode = GLOBAL_NODES.find((n) => n.name === endName);
      if (!startNode || !endNode) return;

      const p1 = latLngToVector3(startNode.lat, startNode.lng, GLOBE_RADIUS);
      const p2 = latLngToVector3(endNode.lat, endNode.lng, GLOBE_RADIUS);

      // Midpoint elevated outward above sphere surface for curved arc
      const mid = p1.clone().add(p2).multiplyScalar(0.5);
      const distance = p1.distanceTo(p2);
      const elevation = GLOBE_RADIUS + Math.min(distance * 0.3, 24);
      mid.normalize().multiplyScalar(elevation);

      // Quadratic Bezier Curve
      const curve = new THREE.QuadraticBezierCurve3(p1, mid, p2);
      const points = curve.getPoints(32);
      const arcGeometry = new THREE.BufferGeometry().setFromPoints(points);

      const arcMaterial = new THREE.LineBasicMaterial({
        color: 0x00F5A0,
        transparent: true,
        opacity: 0.35,
      });

      const arcLine = new THREE.Line(arcGeometry, arcMaterial);
      arcGroup.add(arcLine);
    });

    // 5. Interactive Mouse Rotation & Momentum
    let isDragging = false;
    let previousMouseX = 0;
    let previousMouseY = 0;
    let rotationVelocityX = 0;
    let rotationVelocityY = 0;
    let autoRotate = true;

    const isBackground = container.dataset.globeBackground === 'true';

    if (!isBackground) {
      canvas.addEventListener('mousedown', (e) => {
        isDragging = true;
        autoRotate = false;
        previousMouseX = e.clientX;
        previousMouseY = e.clientY;
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
        // Resume auto rotation slowly
        setTimeout(() => { autoRotate = true; }, 1200);
      });

      window.addEventListener('mousemove', (e) => {
        if (isDragging) {
          const deltaX = e.clientX - previousMouseX;
          const deltaY = e.clientY - previousMouseY;

          rotationVelocityY = deltaX * 0.005;
          rotationVelocityX = deltaY * 0.005;

          globeGroup.rotation.y += rotationVelocityY;
          globeGroup.rotation.x += rotationVelocityX;

          previousMouseX = e.clientX;
          previousMouseY = e.clientY;
        }
      });

      // Touch support for mobile devices
      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isDragging = true;
          autoRotate = false;
          previousMouseX = e.touches[0].clientX;
          previousMouseY = e.touches[0].clientY;
        }
      }, { passive: true });

      window.addEventListener('touchend', () => {
        isDragging = false;
        setTimeout(() => { autoRotate = true; }, 1200);
      });

      window.addEventListener('touchmove', (e) => {
        if (isDragging && e.touches.length === 1) {
          const deltaX = e.touches[0].clientX - previousMouseX;
          const deltaY = e.touches[0].clientY - previousMouseY;

          globeGroup.rotation.y += deltaX * 0.005;
          globeGroup.rotation.x += deltaY * 0.005;

          previousMouseX = e.touches[0].clientX;
          previousMouseY = e.touches[0].clientY;
        }
      }, { passive: true });

      // 6. Raycaster for Hovering Glowing Triangles
      const raycaster = new THREE.Raycaster();
      const mouse = new THREE.Vector2();

      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
        mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

        raycaster.setFromCamera(mouse, camera);
        const meshesToTest = nodeMeshes.map((n) => n.mesh);
        const intersects = raycaster.intersectObjects(meshesToTest);

        if (intersects.length > 0 && tooltip) {
          const hit = intersects[0];
          const match = nodeMeshes.find((n) => n.mesh === hit.object);
          if (match) {
            tooltip.innerHTML = `<strong>${match.node.name}</strong> • ${match.node.latency} (Active)`;
            tooltip.style.left = `${e.clientX - rect.left + 12}px`;
            tooltip.style.top = `${e.clientY - rect.top - 12}px`;
            tooltip.classList.remove('hidden');
          }
        } else if (tooltip) {
          tooltip.classList.add('hidden');
        }
      });

      canvas.addEventListener('mouseleave', () => {
        tooltip?.classList.add('hidden');
      });
    }

    // 7. Continuous Render Loop with requestAnimationFrame
    let animationFrameId: number;
    let isVisible = true;

    function renderLoop() {
      if (!isVisible) return;

      // Increments globe rotation on Y-axis by a fraction of a degree every frame
      if (autoRotate) {
        globeGroup.rotation.y += 0.0035;
      } else {
        // Apply friction/momentum decay
        rotationVelocityX *= 0.95;
        rotationVelocityY *= 0.95;
        globeGroup.rotation.y += rotationVelocityY;
        globeGroup.rotation.x += rotationVelocityX;
      }

      // Gentle pulsating triangle scale
      const time = performance.now() * 0.003;
      const pulseScale = 1 + Math.sin(time) * 0.12;
      nodeMeshes.forEach((item, idx) => {
        const individualPulse = 1 + Math.sin(time + idx * 0.8) * 0.15;
        item.mesh.scale.set(individualPulse, individualPulse, individualPulse);
      });

      renderer.render(scene, camera);
      animationFrameId = requestAnimationFrame(renderLoop);
    }

    // 8. IntersectionObserver to pause render loop off-screen
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        isVisible = entry.isIntersecting;
        if (isVisible) {
          cancelAnimationFrame(animationFrameId);
          renderLoop();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(container);

    // 9. Resize Observer
    const resizeObserver = new ResizeObserver(() => {
      const w = container.clientWidth;
      const h = container.clientHeight;
      if (w > 0 && h > 0) {
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
      }
    });
    resizeObserver.observe(container);

    // Initial trigger
    renderLoop();
  }

  // Auto-mount all globes on page
  function setupAllGlobes() {
    const containers = document.querySelectorAll<HTMLElement>('.wireframe-globe-container');
    containers.forEach((container) => {
      // Prevent double init
      if (container.dataset.globeInitialized) return;
      container.dataset.globeInitialized = 'true';
      initWireframeGlobe(container);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAllGlobes);
  } else {
    setupAllGlobes();
  }
</script>
