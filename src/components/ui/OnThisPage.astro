---
// OnThisPage.astro - Vercel-style Right Side "On this page" Mini UI Component with Scrollspy
interface HeadingItem {
  id: string;
  text: string;
  level?: number;
}

interface Props {
  headings: HeadingItem[];
}

const { headings } = Astro.props;
---

<aside class="hidden xl:block w-60 xl:w-64 shrink-0 text-xs font-sans">
  <div class="sticky top-20 space-y-6 max-h-[calc(100vh-5.5rem)] overflow-y-auto pr-2">
    
    <!-- Mini TOC Header -->
    <div class="space-y-3">
      <div class="flex items-center gap-2 font-semibold text-neutral-900 dark:text-white uppercase tracking-wider text-[11px] font-mono">
        <svg class="w-3.5 h-3.5 text-[#0070f3] dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h10M4 18h7" />
        </svg>
        <span>On this page</span>
      </div>

      <!-- Headings List with Left Progress Accent Bar -->
      <nav class="relative border-l border-neutral-200 dark:border-white/10 ml-1.5 space-y-1 py-1" id="on-this-page-nav">
        <!-- Active Sliding Highlight Pill -->
        <div 
          id="toc-active-indicator" 
          class="absolute left-[-1px] w-0.5 bg-[#0070f3] dark:bg-[#00F5A0] transition-all duration-200 h-5 top-1 opacity-0 shadow-[0_0_8px_rgba(0,245,160,0.6)]"
        ></div>

        {headings.map((item, idx) => (
          <a
            href={`#${item.id}`}
            class={`toc-link block py-1.5 transition-colors duration-150 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-white ${
              item.level === 3 ? 'pl-5 text-[11px]' : 'pl-3 font-medium'
            } ${idx === 0 ? 'active' : ''}`}
            data-target={item.id}
          >
            {item.text}
          </a>
        ))}
      </nav>
    </div>

    <!-- Community & Feedback Utilities -->
    <div class="pt-5 border-t border-neutral-100 dark:border-white/10 space-y-3 text-[11px] text-neutral-500 dark:text-neutral-400">
      
      <!-- Quick Feedback Pill -->
      <div class="p-3 rounded-lg bg-neutral-50 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 space-y-2">
        <span class="block font-medium text-neutral-800 dark:text-neutral-200">Was this page helpful?</span>
        <div class="flex items-center gap-2">
          <button class="feedback-btn px-2.5 py-1 rounded bg-white dark:bg-white/10 border border-neutral-200 dark:border-white/10 hover:border-emerald-500 text-neutral-700 dark:text-neutral-300 transition">
            👍 Yes
          </button>
          <button class="feedback-btn px-2.5 py-1 rounded bg-white dark:bg-white/10 border border-neutral-200 dark:border-white/10 hover:border-red-500 text-neutral-700 dark:text-neutral-300 transition">
            👎 No
          </button>
        </div>
      </div>

      <!-- Action Links -->
      <div class="space-y-1.5 pt-1">
        <a 
          href="#chat-launcher-btn" 
          onclick="document.getElementById('chat-launcher-btn')?.click(); return false;"
          class="flex items-center gap-2 hover:text-[#0070f3] dark:hover:text-cyan-400 transition py-1"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
          </svg>
          <span>Ask Prometrion AI about this</span>
        </a>

        <button 
          id="copy-page-url-btn" 
          class="w-full text-left flex items-center gap-2 hover:text-[#0070f3] dark:hover:text-cyan-400 transition py-1 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span id="copy-url-label">Copy link to this article</span>
        </button>

        <a 
          href="/articles/docs" 
          class="flex items-center gap-2 hover:text-[#0070f3] dark:hover:text-cyan-400 transition py-1"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>All Technical Documentation</span>
        </a>
      </div>

    </div>

  </div>
</aside>

<!-- Scrollspy Engine for "On this page" Mini UI -->
<script>
  function setupOnThisPageScrollspy() {
    const links = document.querySelectorAll<HTMLAnchorElement>("#on-this-page-nav .toc-link");
    const indicator = document.getElementById("toc-active-indicator");
    const copyBtn = document.getElementById("copy-page-url-btn");
    const copyLabel = document.getElementById("copy-url-label");
    const feedbackBtns = document.querySelectorAll(".feedback-btn");

    if (!links.length) return;

    // Feedback button interaction
    feedbackBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const parent = btn.parentElement;
        if (parent) {
          parent.innerHTML = '<span class="text-xs text-emerald-500 font-medium">Thank you for your feedback! ✔</span>';
        }
      });
    });

    // Copy URL handler
    copyBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (copyLabel) {
          copyLabel.textContent = "Copied link to clipboard!";
          setTimeout(() => {
            copyLabel.textContent = "Copy link to this article";
          }, 2000);
        }
      } catch (err) {
        console.error("Clipboard copy failed", err);
      }
    });

    // Heading observation
    const headingIds = Array.from(links).map((l) => l.getAttribute("data-target")).filter(Boolean) as string[];
    const headingElements = headingIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (!headingElements.length) return;

    function setActiveLink(activeId: string) {
      links.forEach((link) => {
        const target = link.getAttribute("data-target");
        if (target === activeId) {
          link.classList.add("text-[#0070f3]", "dark:text-[#00F5A0]", "font-semibold");
          link.classList.remove("text-neutral-500", "dark:text-neutral-400");
          
          // Align indicator bar
          if (indicator) {
            indicator.style.opacity = "1";
            indicator.style.top = `${link.offsetTop}px`;
            indicator.style.height = `${link.offsetHeight}px`;
          }
        } else {
          link.classList.remove("text-[#0070f3]", "dark:text-[#00F5A0]", "font-semibold");
          link.classList.add("text-neutral-500", "dark:text-neutral-400");
        }
      });
    }

    // Set first active on load
    if (links[0]) {
      const firstTarget = links[0].getAttribute("data-target");
      if (firstTarget) setActiveLink(firstTarget);
    }

    // Scroll handler with throttle
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollPos = window.scrollY + 120;
          let currentHeading = headingElements[0];

          for (let i = 0; i < headingElements.length; i++) {
            const el = headingElements[i];
            if (el.offsetTop <= scrollPos) {
              currentHeading = el;
            } else {
              break;
            }
          }

          if (currentHeading) {
            setActiveLink(currentHeading.id);
          }
          ticking = false;
        });
        ticking = true;
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupOnThisPageScrollspy);
  } else {
    setupOnThisPageScrollspy();
  }
</script>
