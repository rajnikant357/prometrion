---
// InteractiveWorkflowShowcase.astro - Dual Column Architecture:
// Left: Storyline timeline with sticky information headings aligned with right cards.
//       Storyline terminates exactly on the 4th point (Node 04).
// Right: Stacking cards with calculated heights, visible header tabs, and flawless 4th card stacking.
import Badge from "./Badge.astro";
---

<section id="platform-showcase" class="relative py-20 sm:py-28 bg-[#fafafa] dark:bg-[#050505] border-b border-[#ebebeb] dark:border-[#202020] overflow-visible">
  <!-- Atmospheric Ambient Glows -->
  <div class="absolute top-1/4 right-0 w-[550px] h-[550px] bg-sky-500/10 dark:bg-sky-500/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-1/4 -left-24 w-[480px] h-[480px] bg-emerald-500/10 dark:bg-emerald-500/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    
    <!-- Section Header Title & Storyline Quick Navigation -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 sm:mb-20 gap-6">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800/60 mb-3">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>✦ ARCHITECTURAL STORYLINE & STACKING CARDS</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-white leading-[1.12]">
          Extract. Stream. Reason.<br class="hidden sm:inline" />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#0070f3] via-cyan-400 to-[#00F5A0]">
            Instant execution at the edge.
          </span>
        </h2>
        <p class="mt-2.5 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
          Follow the architectural storyline on the left while the live execution engines stack seamlessly on the right with zero delay. Every card is locked in alignment with its storyline heading.
        </p>
      </div>

      <!-- Quick Jump Storyline Chapter Pills -->
      <div class="flex flex-wrap items-center gap-2 p-1.5 rounded-xl bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 font-mono text-xs">
        <button data-jump-story="1" class="story-pill px-3 py-1.5 rounded-lg bg-white dark:bg-[#141414] text-neutral-900 dark:text-white font-semibold shadow-xs transition">
          01 Prerender
        </button>
        <button data-jump-story="2" class="story-pill px-3 py-1.5 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition">
          02 Islands
        </button>
        <button data-jump-story="3" class="story-pill px-3 py-1.5 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition">
          03 Taluq AI
        </button>
        <button data-jump-story="4" class="story-pill px-3 py-1.5 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition">
          04 Telemetry
        </button>
      </div>
    </div>

    <!-- 2-Column Split: Storyline Scroll (Left) + Stacking Cards (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 relative" id="storyline-cards-container">
      
      <!-- ======================================================================
           LEFT COLUMN: Storyline Information Scroll Effect
           ====================================================================== -->
      <div class="lg:col-span-5 relative" id="storyline-left-column">
        
        <div class="relative pl-12 sm:pl-16" id="storyline-chapters-list">
          
          <!-- Storyline Vertical Timeline Track: Terminating precisely at Node 04 -->
          <div id="storyline-track-wrapper" class="absolute left-3.5 sm:left-4.5 w-0.5 bg-neutral-200 dark:bg-white/10 z-0 transition-all duration-300">
            <div id="storyline-progress-rail" class="w-full bg-gradient-to-b from-cyan-400 via-[#0070f3] to-emerald-400 h-0 transition-all duration-150 shadow-[0_0_10px_rgba(0,245,160,0.5)]"></div>
          </div>

          <!-- Storyline Chapter 1 -->
          <div id="story-chapter-1" data-story-index="1" class="story-chapter min-h-[550px] lg:min-h-[680px] relative pb-16 flex flex-col justify-start scroll-mt-28">
            <div class="chapter-content lg:sticky lg:top-24 space-y-4 pt-1">
              <!-- Timeline Node Marker -->
              <div class="chapter-node absolute -left-12 sm:-left-16 top-1 w-7 h-7 rounded-full flex items-center justify-center font-mono text-xs font-bold transition-all duration-300 bg-[#171717] text-white dark:bg-white dark:text-black shadow-md ring-4 ring-cyan-400/20 z-10">
                01
              </div>

              <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono uppercase tracking-wider font-semibold text-[#0070f3] dark:text-cyan-400">
                  Chapter 01 // Foundation
                </span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-[#0070f3] dark:text-cyan-400 border border-blue-200 dark:border-blue-800/40">
                  12ms TTFB
                </span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white leading-tight">
                Extract & prerender immutable asset graphs
              </h3>

              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Compile routes, components, and media at build time into an immutable dependency tree distributed across global anycast edge PoPs worldwide. Eliminates origin compute spikes and ensures low-latency page delivery globally.
              </p>

              <!-- Architectural Checklist -->
              <ul class="space-y-2 text-xs text-neutral-700 dark:text-neutral-300 pt-1">
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>Anycast edge caching across Tier-1 global transit</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>100% Cache HIT ratio for static HTML and assets</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>0.0ms cold start latency worldwide</span>
                </li>
              </ul>

              <!-- Micro Telemetry Row -->
              <div class="flex flex-wrap gap-2 pt-2 text-[11px] font-mono">
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  PoP: <strong class="text-neutral-900 dark:text-white">FRA1</strong>
                </span>
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  Compile: <strong class="text-emerald-500">14ms</strong>
                </span>
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  Payload: <strong class="text-cyan-500">1.2KB</strong>
                </span>
              </div>
            </div>
          </div>

          <!-- Storyline Chapter 2 -->
          <div id="story-chapter-2" data-story-index="2" class="story-chapter min-h-[550px] lg:min-h-[680px] relative pb-16 flex flex-col justify-start scroll-mt-28 opacity-75 hover:opacity-100 transition-opacity duration-200">
            <div class="chapter-content lg:sticky lg:top-24 space-y-4 pt-1">
              <div class="chapter-node absolute -left-12 sm:-left-16 top-1 w-7 h-7 rounded-full flex items-center justify-center font-mono text-xs font-medium transition-all duration-300 bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-white/10 z-10">
                02
              </div>

              <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono uppercase tracking-wider font-semibold text-emerald-600 dark:text-emerald-400">
                  Chapter 02 // Streaming
                </span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40">
                  0s CLS
                </span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white leading-tight">
                Prerender fallbacks & stream dynamic islands
              </h3>

              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Stream dynamic personalization, user sessions, and live stock inventory without delaying the primary visual paint. Interactive components hydrate selectively right when needed.
              </p>

              <ul class="space-y-2 text-xs text-neutral-700 dark:text-neutral-300 pt-1">
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>Selective Astro / React component partial hydration</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>Zero Cumulative Layout Shift (0.000 CLS) audited</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>HTTP/3 QUIC parallel asynchronous delivery</span>
                </li>
              </ul>

              <div class="flex flex-wrap gap-2 pt-2 text-[11px] font-mono">
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  Protocol: <strong class="text-neutral-900 dark:text-white">HTTP/3</strong>
                </span>
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  Shift: <strong class="text-emerald-500">0.000</strong>
                </span>
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  Hydrate: <strong class="text-cyan-500">24ms</strong>
                </span>
              </div>
            </div>
          </div>

          <!-- Storyline Chapter 3 -->
          <div id="story-chapter-3" data-story-index="3" class="story-chapter min-h-[550px] lg:min-h-[680px] relative pb-16 flex flex-col justify-start scroll-mt-28 opacity-75 hover:opacity-100 transition-opacity duration-200">
            <div class="chapter-content lg:sticky lg:top-24 space-y-4 pt-1">
              <div class="chapter-node absolute -left-12 sm:-left-16 top-1 w-7 h-7 rounded-full flex items-center justify-center font-mono text-xs font-medium transition-all duration-300 bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-white/10 z-10">
                03
              </div>

              <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono uppercase tracking-wider font-semibold text-purple-600 dark:text-purple-400">
                  Chapter 03 // Intelligence
                </span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40">
                  Taluq AI
                </span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white leading-tight">
                Autonomous agent reasoning in isolated microVMs
              </h3>

              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Embed autonomous computational intelligence directly into user journeys. Intent resolution, dynamic price adjustments, and conversational checkout logic resolve in under 15ms.
              </p>

              <ul class="space-y-2 text-xs text-neutral-700 dark:text-neutral-300 pt-1">
                <li class="flex items-center gap-2">
                  <span class="text-purple-500 font-bold">✓</span>
                  <span>Isolated sub-millisecond Firecracker microVM execution</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-purple-500 font-bold">✓</span>
                  <span>Deterministic guardrails with zero hallucination vulnerability</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-purple-500 font-bold">✓</span>
                  <span>Autonomous DAG resolving multi-step business logic</span>
                </li>
              </ul>

              <div class="flex flex-wrap gap-2 pt-2 text-[11px] font-mono">
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  Engine: <strong class="text-neutral-900 dark:text-white">Taluq Core</strong>
                </span>
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  Execution: <strong class="text-purple-400">14.2ms</strong>
                </span>
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  Safety: <strong class="text-emerald-500">Deterministic</strong>
                </span>
              </div>
            </div>
          </div>

          <!-- Storyline Chapter 4: FINAL POINT (Storyline terminates here) -->
          <div id="story-chapter-4" data-story-index="4" class="story-chapter min-h-[600px] lg:min-h-[780px] relative pb-28 flex flex-col justify-start scroll-mt-28 opacity-75 hover:opacity-100 transition-opacity duration-200">
            <div class="chapter-content lg:sticky lg:top-24 space-y-4 pt-1">
              <!-- FINAL Node 04: The storyline stops here -->
              <div class="chapter-node absolute -left-12 sm:-left-16 top-1 w-7 h-7 rounded-full flex items-center justify-center font-mono text-xs font-medium transition-all duration-300 bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-white/10 z-10">
                04
              </div>

              <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono uppercase tracking-wider font-semibold text-cyan-600 dark:text-cyan-400">
                  Chapter 04 // Reliability (Complete)
                </span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800/40">
                  99.999% SLA
                </span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white leading-tight">
                Full observability & atomic canary rollbacks
              </h3>

              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                Real-time Core Web Vitals telemetry continuously streams back from all edge nodes. Automated anomaly detection initiates instant sub-200ms canary rollbacks if thresholds deviate.
              </p>

              <ul class="space-y-2 text-xs text-neutral-700 dark:text-neutral-300 pt-1">
                <li class="flex items-center gap-2">
                  <span class="text-cyan-500 font-bold">✓</span>
                  <span>Continuous real-time telemetry streaming from global edge nodes</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-cyan-500 font-bold">✓</span>
                  <span>Sub-second anomaly mitigation with proactive self-healing</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="text-cyan-500 font-bold">✓</span>
                  <span>Instant zero-downtime rollback to verified safe hash</span>
                </li>
              </ul>

              <div class="flex flex-wrap gap-2 pt-2 text-[11px] font-mono">
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  SLA: <strong class="text-neutral-900 dark:text-white">99.999%</strong>
                </span>
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  Rollback: <strong class="text-cyan-400">142ms</strong>
                </span>
                <span class="px-2.5 py-1 rounded bg-neutral-100 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10 text-neutral-600 dark:text-neutral-300">
                  Health: <strong class="text-emerald-500">Optimal</strong>
                </span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- ======================================================================
           RIGHT COLUMN: Stackable Scroll Effect Cards
           ====================================================================== -->
      <div class="lg:col-span-7 relative pb-40 sm:pb-56" id="stacking-cards-column">
        
        <!-- CARD 1: Acme Storefront Prerender UI -->
        <div 
          id="stack-card-1"
          data-card-index="1"
          class="desktop-stack-card stacking-card sticky top-24 z-10 rounded-2xl bg-white dark:bg-[#0c0c0c] border border-neutral-200/90 dark:border-white/15 shadow-[0_-8px_25px_rgba(0,0,0,0.08),0_20px_40px_rgba(0,0,0,0.1)] dark:shadow-[0_-10px_35px_rgba(0,0,0,0.8),0_25px_60px_rgba(0,0,0,0.9)] overflow-hidden transition-all duration-200"
        >
          <!-- Card Titlebar (Header Tab) -->
          <div class="px-5 py-3.5 bg-neutral-100/90 dark:bg-[#141414] border-b border-neutral-200/80 dark:border-white/10 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-black dark:bg-white text-white dark:text-black font-mono text-xs font-bold flex items-center justify-center">
                01
              </span>
              <span class="text-xs font-semibold font-mono tracking-wide text-neutral-800 dark:text-neutral-200">
                PRERENDER ENGINE • ACME® GOODS
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-mono text-emerald-500 font-bold">● 200 OK</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-[#0070f3] dark:text-cyan-400 border border-blue-200 dark:border-blue-800/40">12ms</span>
            </div>
          </div>

          <!-- Browser Address Bar -->
          <div class="px-5 py-2 bg-neutral-50 dark:bg-black/40 border-b border-neutral-200/60 dark:border-white/5 flex items-center justify-between text-xs font-mono text-neutral-500">
            <div class="flex items-center gap-2 truncate">
              <span class="text-emerald-500">🔒</span>
              <span class="text-neutral-700 dark:text-neutral-300">https://acme-store.prometrion.network</span>
            </div>
            <span class="text-[10px] text-neutral-400">EDGE CACHE HIT</span>
          </div>

          <!-- Card Content Body -->
          <div class="p-6 space-y-4">
            <!-- Acme Store Sub-Navbar -->
            <div class="flex items-center justify-between pb-3 border-b border-neutral-100 dark:border-white/10">
              <div class="flex items-center gap-2.5">
                <div class="w-6 h-6 rounded bg-black dark:bg-white text-white dark:text-black flex items-center justify-center font-bold text-xs">
                  A
                </div>
                <span class="font-bold text-xs tracking-tight text-neutral-900 dark:text-white">ACME® GOODS</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/10 text-neutral-500">v4.1 Anycast</span>
              </div>
              <div class="flex items-center gap-2">
                <span id="right-card-1-cart" class="text-xs font-mono text-neutral-600 dark:text-neutral-400">Cart (2)</span>
                <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
              </div>
            </div>

            <!-- Product Showcase Hero in Acme Frame -->
            <div class="p-4 rounded-xl bg-neutral-50 dark:bg-white/[0.03] border border-neutral-200/80 dark:border-white/10 grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
              <div>
                <span class="text-[10px] font-mono uppercase tracking-wider text-[#0070f3] dark:text-cyan-400 font-semibold">HOT RELEASE • PRERENDERED</span>
                <h4 class="text-base font-bold text-neutral-900 dark:text-white mt-1">
                  Acme® Horizon Mech Keyboard
                </h4>
                <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1 leading-relaxed">
                  Custom Gateron switches, anodized aluminum chassis, and instantaneous edge telemetry sync.
                </p>
                <div class="mt-3 flex items-center gap-3">
                  <span class="text-sm font-mono font-bold text-neutral-900 dark:text-white">$189.00</span>
                  <button id="right-card-1-add-btn" class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:opacity-90 transition cursor-pointer">
                    Instant Add +
                  </button>
                </div>
              </div>

              <div class="h-28 rounded-lg bg-gradient-to-tr from-cyan-500/20 via-sky-500/10 to-emerald-500/20 border border-cyan-500/30 flex flex-col items-center justify-center p-3">
                <div class="text-3xl">⌨️</div>
                <span class="text-[11px] font-mono text-neutral-700 dark:text-neutral-300 mt-1.5 font-medium">Acme® Pro Horizon</span>
                <span class="text-[9px] font-mono text-emerald-600 dark:text-emerald-400">Asset Cache: HIT (1.2KB)</span>
              </div>
            </div>

            <!-- Micro Telemetry Bar -->
            <div class="pt-2 flex items-center justify-between text-[11px] font-mono text-neutral-500">
              <span>Anycast Node: <strong class="text-neutral-800 dark:text-neutral-200">FRA1</strong></span>
              <span>Cold Start: <strong class="text-emerald-500">0.0ms</strong></span>
            </div>
          </div>
        </div>

        <!-- CARD 2: Streaming Islands Waterfall Timeline -->
        <div 
          id="stack-card-2"
          data-card-index="2"
          class="desktop-stack-card stacking-card sticky top-[7.25rem] z-20 rounded-2xl bg-white dark:bg-[#0c0c0c] border border-neutral-200/90 dark:border-white/15 shadow-[0_-8px_25px_rgba(0,0,0,0.08),0_20px_40px_rgba(0,0,0,0.1)] dark:shadow-[0_-10px_35px_rgba(0,0,0,0.8),0_25px_60px_rgba(0,0,0,0.9)] overflow-hidden transition-all duration-200"
        >
          <!-- Card Titlebar (Header Tab) -->
          <div class="px-5 py-3.5 bg-neutral-100/90 dark:bg-[#141414] border-b border-neutral-200/80 dark:border-white/10 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-600 text-white font-mono text-xs font-bold flex items-center justify-center">
                02
              </span>
              <span class="text-xs font-semibold font-mono tracking-wide text-neutral-800 dark:text-neutral-200">
                STREAMING ISLANDS RUNTIME
              </span>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40">0s CLS</span>
          </div>

          <div class="px-5 py-2 bg-neutral-50 dark:bg-black/40 border-b border-neutral-200/60 dark:border-white/5 flex items-center justify-between text-xs font-mono text-neutral-500">
            <div class="flex items-center gap-2 truncate">
              <span class="text-emerald-500">🔒</span>
              <span class="text-neutral-700 dark:text-neutral-300">https://acme-store.prometrion.network/streaming-islands</span>
            </div>
