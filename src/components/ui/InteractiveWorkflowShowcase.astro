---
// InteractiveWorkflowShowcase.astro - Vertical Stepper + Scrollspy + Browser Mockup Window
// Demonstrates Prometrion platform in action with Acme® store UI and live telemetry.
import Badge from "./Badge.astro";
---

<section id="platform-showcase" class="py-24 sm:py-32 relative overflow-hidden border-b border-[#ebebeb] dark:border-[#202020] bg-white dark:bg-[#000000]">
  <!-- Atmospheric One-Sided Blue Ambient Glow -->
  <div class="absolute -top-24 right-0 w-[500px] h-[500px] bg-sky-500/10 dark:bg-sky-500/15 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-0 -left-24 w-[450px] h-[450px] bg-emerald-500/10 dark:bg-emerald-500/12 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header Title -->
    <div class="max-w-3xl mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800/60 mb-4">
        <span>✦ WORKFLOW ARCHITECTURE</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-white leading-[1.12]">
        Extract. Stream. Reason.<br class="hidden sm:inline" />
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#0070f3] via-cyan-400 to-[#00F5A0]">
          Instant execution at the edge.
        </span>
      </h2>
      <p class="mt-4 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Watch how Prometrion decomposes monolithic applications into prerendered static trees, dynamic streaming islands, and autonomous reasoning agents.
      </p>
    </div>

    <!-- 2-Column Split: Stepper Timeline (Left) & Browser Mockup (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      
      <!-- Left Column: Vertical Stepper / Timeline with Scrollspy -->
      <div class="lg:col-span-5 relative" id="workflow-stepper-container">
        <!-- Continuous Vertical Glowing Progress Line -->
        <div class="absolute left-6 top-8 bottom-8 w-0.5 bg-neutral-200 dark:bg-white/10 -z-0">
          <div id="vertical-progress-bar" class="w-full bg-gradient-to-b from-cyan-400 to-emerald-400 transition-all duration-300 h-[25%] shadow-[0_0_12px_rgba(0,245,160,0.6)]"></div>
        </div>

        <div class="space-y-6 relative z-10" id="stepper-list">
          
          <!-- Step 1 -->
          <div 
            class="workflow-step group cursor-pointer p-4 sm:p-5 rounded-[6px] transition-all duration-200 border border-transparent hover:border-neutral-200 dark:hover:border-white/10 hover:bg-neutral-50/60 dark:hover:bg-white/[0.03] active-step"
            data-step="1"
          >
            <div class="flex items-start gap-4">
              <!-- Step Pill / Dot -->
              <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center shrink-0 font-mono text-xs font-bold transition-all duration-200 bg-[#171717] text-white dark:bg-white dark:text-black shadow-md">
                01
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between">
                  <h3 class="step-title text-base sm:text-lg font-semibold text-[#171717] dark:text-white transition-colors">
                    Extract & prerender static assets
                  </h3>
                  <span class="step-badge text-[11px] font-mono px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-[#0070f3] dark:text-cyan-400 border border-blue-200 dark:border-blue-800/40">
                    12ms TTFB
                  </span>
                </div>
                <p class="step-desc text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
                  Compile routes, components, and media at build time into an immutable graph distributed to 300+ anycast edge PoPs worldwide.
                </p>
              </div>
            </div>
          </div>

          <!-- Step 2 -->
          <div 
            class="workflow-step group cursor-pointer p-4 sm:p-5 rounded-[6px] transition-all duration-200 border border-transparent hover:border-neutral-200 dark:hover:border-white/10 hover:bg-neutral-50/60 dark:hover:bg-white/[0.03] opacity-60 hover:opacity-100"
            data-step="2"
          >
            <div class="flex items-start gap-4">
              <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center shrink-0 font-mono text-xs font-medium transition-all duration-200 bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-neutral-400">
                02
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between">
                  <h3 class="step-title text-base sm:text-lg font-semibold text-neutral-700 dark:text-neutral-300 transition-colors">
                    Prerender fallbacks & stream islands
                  </h3>
                  <span class="step-badge text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40">
                    0s CLS
                  </span>
                </div>
                <p class="step-desc text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
                  Stream in dynamic personalization, shopping carts, and live stock states without blocking the primary visual render or causing page jumps.
                </p>
              </div>
            </div>
          </div>

          <!-- Step 3 -->
          <div 
            class="workflow-step group cursor-pointer p-4 sm:p-5 rounded-[6px] transition-all duration-200 border border-transparent hover:border-neutral-200 dark:hover:border-white/10 hover:bg-neutral-50/60 dark:hover:bg-white/[0.03] opacity-60 hover:opacity-100"
            data-step="3"
          >
            <div class="flex items-start gap-4">
              <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center shrink-0 font-mono text-xs font-medium transition-all duration-200 bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-neutral-400">
                03
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between">
                  <h3 class="step-title text-base sm:text-lg font-semibold text-neutral-700 dark:text-neutral-300 transition-colors">
                    Autonomous agent reasoning
                  </h3>
                  <span class="step-badge text-[11px] font-mono px-2 py-0.5 rounded bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-300 border border-purple-200 dark:border-purple-800/40">
                    Taluq AI
                  </span>
                </div>
                <p class="step-desc text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
                  Embed autonomous intelligence directly into user interactions—intent resolution, dynamic discounts, and conversational shopping logic in &lt;15ms.
                </p>
              </div>
            </div>
          </div>

          <!-- Step 4 -->
          <div 
            class="workflow-step group cursor-pointer p-4 sm:p-5 rounded-[6px] transition-all duration-200 border border-transparent hover:border-neutral-200 dark:hover:border-white/10 hover:bg-neutral-50/60 dark:hover:bg-white/[0.03] opacity-60 hover:opacity-100"
            data-step="4"
          >
            <div class="flex items-start gap-4">
              <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center shrink-0 font-mono text-xs font-medium transition-all duration-200 bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-neutral-400">
                04
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between">
                  <h3 class="step-title text-base sm:text-lg font-semibold text-neutral-700 dark:text-neutral-300 transition-colors">
                    Observability & atomic rollbacks
                  </h3>
                  <span class="step-badge text-[11px] font-mono px-2 py-0.5 rounded bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800/40">
                    99.999%
                  </span>
                </div>
                <p class="step-desc text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
                  Real-time Core Web Vitals telemetry, proactive anomaly self-healing, and single-click zero-downtime rollbacks across all edge locations.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Right Column: Browser Mockup / Preview Window -->
      <div class="lg:col-span-7 sticky top-24">
        <!-- Application Window Container with One-Sided Blue Ambient Glow -->
        <div class="card-glow-blue rounded-[6px] bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/15 shadow-floating dark:shadow-[0_25px_60px_rgba(0,0,0,0.9),0_0_35px_rgba(56,189,248,0.15)] overflow-hidden transition-all duration-300">
          
          <!-- Browser Titlebar & Controls -->
          <div class="px-4 py-3 bg-neutral-100/70 dark:bg-[#141414]/90 border-b border-[#ebebeb] dark:border-white/10 flex items-center justify-between backdrop-blur-md">
            <!-- macOS Traffic Light Dots -->
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-[#ff5f56] border border-[#e0443e] inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-[#ffbd2e] border border-[#dea123] inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-[#27c93f] border border-[#1aab29] inline-block"></span>
              <span class="hidden sm:inline-block ml-2 text-[11px] font-mono text-neutral-400 dark:text-neutral-500">Preview Engine</span>
            </div>

            <!-- Address Bar with SSL Lock -->
            <div class="flex-1 max-w-xs sm:max-w-md mx-3 px-3 py-1 rounded-md bg-white dark:bg-black/60 border border-neutral-200 dark:border-white/10 text-xs font-mono text-neutral-600 dark:text-neutral-300 flex items-center justify-between shadow-xs">
              <div class="flex items-center gap-2 truncate">
                <svg class="w-3 h-3 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                </svg>
                <span id="browser-url-text" class="truncate text-neutral-700 dark:text-neutral-200">https://acme-store.prometrion.network</span>
              </div>
              <span class="text-[10px] text-emerald-500 font-bold shrink-0 ml-1">● 200 OK</span>
            </div>

            <!-- Reload Icon -->
            <button id="browser-reload-btn" class="p-1 rounded hover:bg-neutral-200 dark:hover:bg-white/10 text-neutral-500 dark:text-neutral-400 transition" title="Reload simulation">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </button>
          </div>

          <!-- Browser Viewport Content (Interactive Canvas) -->
          <div class="p-5 sm:p-7 min-h-[380px] flex flex-col justify-between" id="browser-viewport">
            
            <!-- View 1: Acme® Storefront Prerendered UI (Default) -->
            <div id="view-step-1" class="preview-panel transition-opacity duration-300">
              <!-- Acme Store Sub-Navbar -->
              <div class="flex items-center justify-between pb-4 border-b border-neutral-100 dark:border-white/10">
                <div class="flex items-center gap-3">
                  <div class="w-6 h-6 rounded bg-black dark:bg-white text-white dark:text-black flex items-center justify-center font-bold text-xs font-sans">
                    A
                  </div>
                  <span class="font-bold text-sm tracking-tight text-neutral-900 dark:text-white font-sans">ACME® GOODS</span>
                  <span class="hidden sm:inline-block text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/10 text-neutral-500">v4.1 Global</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-xs text-neutral-500 dark:text-neutral-400">Cart (2)</span>
                  <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                </div>
              </div>

              <!-- Product Showcase Hero in Acme Frame -->
              <div class="mt-5 p-4 sm:p-5 rounded-[6px] bg-neutral-50 dark:bg-white/[0.04] border border-neutral-100 dark:border-white/10 grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
                <div>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-[#0070f3] dark:text-cyan-400 font-semibold">HOT RELEASE • PRERENDERED</span>
                  <h4 class="text-base sm:text-lg font-bold text-neutral-900 dark:text-white mt-1">
                    Acme® Horizon Mech Keyboard
                  </h4>
                  <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1.5 leading-relaxed">
                    Custom Gateron switches, anodized aluminum chassis, and instantaneous edge telemetry sync.
                  </p>
                  <div class="mt-4 flex items-center gap-3">
                    <span class="text-sm font-mono font-bold text-neutral-900 dark:text-white">$189.00</span>
                    <button class="px-3 py-1 rounded-full text-xs font-medium bg-[#171717] dark:bg-white text-white dark:text-black hover:opacity-90 transition">
                      Instant Add
                    </button>
                  </div>
                </div>

                <div class="h-32 sm:h-36 rounded-lg bg-gradient-to-tr from-cyan-500/20 via-sky-500/10 to-emerald-500/20 border border-cyan-500/30 flex flex-col items-center justify-center p-3 relative overflow-hidden">
                  <div class="text-2xl">⌨️</div>
                  <span class="text-[11px] font-mono text-neutral-700 dark:text-neutral-300 mt-2 font-medium">Acme® Pro Horizon</span>
                  <span class="text-[9px] font-mono text-emerald-600 dark:text-emerald-400 mt-0.5">Asset Cache: HIT (1.2KB)</span>
                </div>
              </div>

              <!-- Micro Telemetry Bar -->
              <div class="mt-5 pt-4 border-t border-neutral-100 dark:border-white/10 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-neutral-500 dark:text-neutral-400">
                <span>Anycast Node: <strong class="text-neutral-800 dark:text-neutral-200">FRA1 (Frankfurt)</strong></span>
                <span>Compile Time: <strong class="text-emerald-500">14ms</strong></span>
                <span>Cold Start: <strong class="text-emerald-500">0.0ms</strong></span>
              </div>
            </div>

            <!-- View 2: Streaming Islands & Partial Hydration -->
            <div id="view-step-2" class="preview-panel hidden transition-opacity duration-300 space-y-4">
              <div class="flex items-center justify-between pb-3 border-b border-neutral-100 dark:border-white/10">
                <span class="font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400">✦ ISLANDS HYDRATION TIMELINE</span>
                <span class="text-[10px] font-mono text-neutral-400">Selective React Hydration</span>
              </div>

              <!-- Waterfall Stream Simulator -->
              <div class="space-y-3 font-mono text-xs">
                <div class="p-2.5 rounded-lg bg-neutral-50 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">
                  <div class="flex justify-between text-neutral-700 dark:text-neutral-300 mb-1">
                    <span>1. Static Shell & Layout</span>
                    <span class="text-emerald-500 font-bold">11ms (TTFB)</span>
                  </div>
                  <div class="w-full bg-neutral-200 dark:bg-white/10 h-1.5 rounded-full overflow-hidden">
                    <div class="bg-emerald-400 h-full w-full"></div>
                  </div>
                </div>

                <div class="p-2.5 rounded-lg bg-neutral-50 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">
                  <div class="flex justify-between text-neutral-700 dark:text-neutral-300 mb-1">
                    <span>2. Streaming Shopping Cart Island</span>
                    <span class="text-cyan-400 font-bold">24ms (Streamed)</span>
                  </div>
                  <div class="w-full bg-neutral-200 dark:bg-white/10 h-1.5 rounded-full overflow-hidden">
                    <div class="bg-cyan-400 h-full w-[85%]"></div>
                  </div>
                </div>

                <div class="p-2.5 rounded-lg bg-neutral-50 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">
                  <div class="flex justify-between text-neutral-700 dark:text-neutral-300 mb-1">
                    <span>3. Dynamic Pricing & Recommendation Engine</span>
                    <span class="text-purple-400 font-bold">32ms (Hydrated)</span>
                  </div>
                  <div class="w-full bg-neutral-200 dark:bg-white/10 h-1.5 rounded-full overflow-hidden">
                    <div class="bg-purple-400 h-full w-[65%]"></div>
                  </div>
                </div>
              </div>

              <div class="p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-600 dark:text-emerald-400 flex items-center gap-2">
                <span>✔</span>
                <span>Zero Layout Shift recorded across 1,000 synthetic page views.</span>
              </div>
            </div>

            <!-- View 3: Taluq AI Agent Execution -->
            <div id="view-step-3" class="preview-panel hidden transition-opacity duration-300 space-y-4">
              <div class="flex items-center justify-between pb-3 border-b border-neutral-100 dark:border-white/10">
                <span class="font-mono text-xs font-semibold text-purple-600 dark:text-purple-400">✦ TALUQ AI AGENT REASONING SANDBOX</span>
                <span class="text-[10px] font-mono text-neutral-400">microVM Sub-15ms</span>
              </div>

              <!-- Terminal Agent Execution Feed -->
              <div class="bg-black text-neutral-200 p-4 rounded-[6px] font-mono text-xs space-y-2 border border-neutral-800">
                <div class="text-neutral-500">// User prompt intercepted at edge gateway:</div>
                <div class="text-cyan-300">&gt; "Apply best student discount and bundle matching wrist rest"</div>
                <div class="text-neutral-400 pt-1">// Reasoning DAG executing:</div>
                <div class="text-emerald-400 pl-3">↳ [Tool: auth.verifyStudentCredentials] => Valid (Campus ID verified)</div>
                <div class="text-emerald-400 pl-3">↳ [Tool: store.lookupBundleStock] => 38 units available</div>
                <div class="text-emerald-400 pl-3">↳ [Tool: checkout.applyDiscountRule] => Code APPLIED (-15%)</div>
                <div class="pt-2 text-white font-bold text-[11px] bg-white/10 p-2 rounded">
                  ★ Agent Result: Order recalculated to $160.65 in 14.2ms.
                </div>
              </div>
            </div>

            <!-- View 4: Observability & Core Web Vitals -->
            <div id="view-step-4" class="preview-panel hidden transition-opacity duration-300 space-y-5">
              <div class="flex items-center justify-between pb-3 border-b border-neutral-100 dark:border-white/10">
                <span class="font-mono text-xs font-semibold text-cyan-600 dark:text-cyan-400">✦ REAL-TIME OBSERVABILITY & METRICS</span>
                <span class="text-[10px] font-mono text-emerald-500">All Nodes Healthy</span>
              </div>

              <!-- 3 CWV Score Gauges -->
              <div class="grid grid-cols-3 gap-3 text-center font-mono">
                <div class="p-3 rounded-[6px] bg-neutral-50 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">
                  <div class="text-xs text-neutral-500">LCP</div>
                  <div class="text-xl font-bold text-emerald-500 mt-1">0.38s</div>
                  <div class="text-[10px] text-neutral-400">Good (&lt;2.5s)</div>
                </div>
                <div class="p-3 rounded-[6px] bg-neutral-50 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">
                  <div class="text-xs text-neutral-500">FID / INP</div>
                  <div class="text-xl font-bold text-emerald-500 mt-1">14ms</div>
                  <div class="text-[10px] text-neutral-400">Sub-instant</div>
                </div>
                <div class="p-3 rounded-[6px] bg-neutral-50 dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">
                  <div class="text-xs text-neutral-500">CLS</div>
                  <div class="text-xl font-bold text-emerald-500 mt-1">0.000</div>
                  <div class="text-[10px] text-neutral-400">Zero Shift</div>
                </div>
              </div>

              <!-- Instant Rollback Simulator Button -->
              <div class="p-3.5 rounded-[6px] bg-neutral-50 dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10 flex items-center justify-between">
                <div>
                  <div class="text-xs font-semibold text-neutral-900 dark:text-white">Instant Canary Rollback</div>
                  <div class="text-[11px] text-neutral-500">Atomic rollback to commit 7b9f3e in 180ms</div>
                </div>
                <button id="demo-rollback-btn" class="px-3 py-1.5 rounded-md text-xs font-mono font-medium bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/30 transition cursor-pointer">
                  Test Rollback
                </button>
              </div>
            </div>

          </div>

          <!-- Bottom Status Telemetry Footer -->
          <div class="px-5 py-2.5 bg-neutral-50 dark:bg-[#080808] border-t border-neutral-100 dark:border-white/10 flex items-center justify-between text-[11px] font-mono text-neutral-400 dark:text-neutral-500">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Synchronized with Prometrion Mesh
            </span>
            <span id="active-step-indicator-text">Step 1/4 • Static Prerender</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- Scrollspy & Step Switcher Client Script -->
<script>
  function setupWorkflowShowcase() {
    const steps = document.querySelectorAll<HTMLElement>(".workflow-step");
    const panels = document.querySelectorAll<HTMLElement>(".preview-panel");
    const progressBar = document.getElementById("vertical-progress-bar");
    const statusText = document.getElementById("active-step-indicator-text");
    const urlText = document.getElementById("browser-url-text");
    const reloadBtn = document.getElementById("browser-reload-btn");
    const rollbackBtn = document.getElementById("demo-rollback-btn");

    if (!steps.length) return;

    const urls: Record<number, string> = {
      1: "https://acme-store.prometrion.network",
      2: "https://acme-store.prometrion.network/streaming-islands",
      3: "https://acme-store.prometrion.network/taluq-agent-runtime",
      4: "https://acme-store.prometrion.network/telemetry-observability",
    };

    const statusLabels: Record<number, string> = {
      1: "Step 1/4 • Static Prerender",
      2: "Step 2/4 • Streaming Islands",
      3: "Step 3/4 • Taluq AI Sandbox",
      4: "Step 4/4 • Observability & Telemetry",
    };

    function activateStep(stepNum: number) {
      steps.forEach((s) => {
        const num = parseInt(s.getAttribute("data-step") || "1", 10);
        const indicator = s.querySelector(".step-indicator");
        const title = s.querySelector(".step-title");

        if (num === stepNum) {
          s.classList.add("active-step");
          s.classList.remove("opacity-60");
          s.classList.add("opacity-100");
          if (indicator) {
            indicator.className = "step-indicator w-8 h-8 rounded-full flex items-center justify-center shrink-0 font-mono text-xs font-bold transition-all duration-200 bg-[#171717] text-white dark:bg-white dark:text-black shadow-md";
          }
          if (title) {
            title.className = "step-title text-base sm:text-lg font-semibold text-[#171717] dark:text-white transition-colors";
          }
        } else {
          s.classList.remove("active-step");
          s.classList.add("opacity-60");
          s.classList.remove("opacity-100");
          if (indicator) {
            indicator.className = "step-indicator w-8 h-8 rounded-full flex items-center justify-center shrink-0 font-mono text-xs font-medium transition-all duration-200 bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-neutral-400";
          }
          if (title) {
            title.className = "step-title text-base sm:text-lg font-semibold text-neutral-700 dark:text-neutral-300 transition-colors";
          }
        }
      });

      // Show matching panel
      panels.forEach((p) => {
        if (p.id === `view-step-${stepNum}`) {
          p.classList.remove("hidden");
        } else {
          p.classList.add("hidden");
        }
      });

      // Update progress bar height
      if (progressBar) {
        progressBar.style.height = `${stepNum * 25}%`;
      }

      // Update URL & status
      if (urlText && urls[stepNum]) {
        urlText.textContent = urls[stepNum];
      }
      if (statusText && statusLabels[stepNum]) {
        statusText.textContent = statusLabels[stepNum];
      }
    }

    // Click handler for steps
    steps.forEach((step) => {
      step.addEventListener("click", () => {
        const stepNum = parseInt(step.getAttribute("data-step") || "1", 10);
        activateStep(stepNum);
      });
    });

    // Reload button simulation
    reloadBtn?.addEventListener("click", () => {
      const activeStepEl = document.querySelector(".workflow-step.active-step");
      const currentStep = parseInt(activeStepEl?.getAttribute("data-step") || "1", 10);
      reloadBtn.classList.add("animate-spin");
      setTimeout(() => {
        reloadBtn.classList.remove("animate-spin");
        activateStep(currentStep);
      }, 500);
    });

    // Rollback test button simulation
    rollbackBtn?.addEventListener("click", () => {
      rollbackBtn.textContent = "Rolled Back in 142ms ✔";
      rollbackBtn.classList.remove("bg-red-500/10", "text-red-600");
      rollbackBtn.classList.add("bg-emerald-500/20", "text-emerald-400");
      setTimeout(() => {
        rollbackBtn.textContent = "Test Rollback";
        rollbackBtn.classList.remove("bg-emerald-500/20", "text-emerald-400");
        rollbackBtn.classList.add("bg-red-500/10", "text-red-600");
      }, 2500);
    });

    // IntersectionObserver Scrollspy
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const stepNum = parseInt(entry.target.getAttribute("data-step") || "1", 10);
              activateStep(stepNum);
            }
          });
        },
        {
          rootMargin: "-25% 0px -40% 0px",
          threshold: 0.5,
        }
      );

      steps.forEach((step) => observer.observe(step));
    }
  }

  // Run on mount
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupWorkflowShowcase);
  } else {
    setupWorkflowShowcase();
  }
</script>
