<!-- Storyline & Stacking Cards Synchronization Script (Zero Delay, 100% Seamless) -->
<script>
  function setupDualStorylineAndStacking() {
    const chapters = document.querySelectorAll<HTMLElement>(".story-chapter");
    const cards = document.querySelectorAll<HTMLElement>(".desktop-stack-card");
    const pills = document.querySelectorAll<HTMLElement>("[data-jump-story]");
    const track = document.getElementById("storyline-track-wrapper");
    const rail = document.getElementById("storyline-progress-rail");
    const container = document.getElementById("storyline-cards-container");
    const addBtn = document.getElementById("right-card-1-add-btn");
    const cartLabel = document.getElementById("right-card-1-cart");
    const rollbackBtn = document.getElementById("right-card-4-rollback-btn");

    if (!chapters.length || !container) return;

    // Interactive Card 1 Add-to-cart
    let cartCount = 2;
    addBtn?.addEventListener("click", () => {
      cartCount++;
      if (cartLabel) cartLabel.textContent = `Cart (${cartCount})`;
      addBtn.textContent = "Added! ✓";
      addBtn.classList.add("bg-emerald-600", "text-white");
      setTimeout(() => {
        addBtn.textContent = "Instant Add +";
        addBtn.classList.remove("bg-emerald-600");
      }, 1500);
    });

    // Interactive Card 4 Rollback Test
    rollbackBtn?.addEventListener("click", () => {
      rollbackBtn.textContent = "Rolled Back in 142ms ✔";
      rollbackBtn.classList.remove("bg-red-500/10", "text-red-600");
      rollbackBtn.classList.add("bg-emerald-500/20", "text-emerald-400", "border-emerald-500/30");
      setTimeout(() => {
        rollbackBtn.textContent = "Test Rollback";
        rollbackBtn.classList.remove("bg-emerald-500/20", "text-emerald-400", "border-emerald-500/30");
        rollbackBtn.classList.add("bg-red-500/10", "text-red-600");
      }, 2500);
    });

    // Align track line precisely so it starts at Node 01 center and terminates at Node 04 center
    function alignStorylineTrack() {
      const ch1 = document.getElementById("story-chapter-1");
      const ch4 = document.getElementById("story-chapter-4");
      if (ch1 && ch4 && track) {
        const node1Center = ch1.offsetTop + 15; // Vertical center of Node 01
        const node4Center = ch4.offsetTop + 15; // Vertical center of Node 04
        track.style.top = `${node1Center}px`;
        track.style.height = `${Math.max(0, node4Center - node1Center)}px`;
      }
    }

    // Align each card's bottom spacing to match its corresponding chapter height perfectly
    function alignChaptersAndCards() {
      const isDesktop = window.innerWidth >= 1024;
      if (!isDesktop) {
        cards.forEach((c) => { c.style.marginBottom = ""; });
        return;
      }

      chapters.forEach((chapter, i) => {
        if (cards[i]) {
          const chapterHeight = chapter.offsetHeight;
          const cardHeight = cards[i].offsetHeight;
          // For cards 1, 2, 3: provide spacing to sync arrival with next chapter
          if (i < cards.length - 1) {
            const spacing = Math.max(140, chapterHeight - cardHeight);
            cards[i].style.marginBottom = `${spacing}px`;
          } else {
            // For Card 4: provide runway so it stays stacked and visible during Chapter 4
            cards[i].style.marginBottom = "0px";
          }
        }
      });
    }

    // Quick Jump Buttons
    pills.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetNum = btn.getAttribute("data-jump-story");
        const targetChapter = document.getElementById(`story-chapter-${targetNum}`);
        if (targetChapter) {
          const topOffset = targetChapter.getBoundingClientRect().top + window.scrollY - 100;
          if ((window as any).lenis) {
            (window as any).lenis.scrollTo(topOffset, { duration: 0.8 });
          } else {
            window.scrollTo({ top: topOffset, behavior: "smooth" });
          }
        }
      });
    });

    // Seamless scroll tracking for storyline rail, active chapter highlighting, and card stacking depth
    function onScrollSync() {
      const ch1 = document.getElementById("story-chapter-1");
      const ch4 = document.getElementById("story-chapter-4");
      if (!ch1 || !ch4) return;

      const triggerLine = window.innerHeight * 0.50;

      // Determine current active chapter
      let activeIdx = 1;
      chapters.forEach((ch, i) => {
        const rect = ch.getBoundingClientRect();
        if (rect.top <= triggerLine) {
          activeIdx = i + 1;
        }
      });

      // Clamp to Chapter 4 max
      activeIdx = Math.min(4, Math.max(1, activeIdx));

      // Calculate progress line fill: starts at Ch1 (0%), ends at Ch4 (100%), never past Ch4
      const ch1Top = ch1.getBoundingClientRect().top;
      const ch4Top = ch4.getBoundingClientRect().top;
      const totalDistance = ch4Top - ch1Top;

      if (totalDistance !== 0 && rail) {
        const currentDistance = triggerLine - ch1Top;
        const progressFraction = Math.min(1, Math.max(0, currentDistance / (ch4.offsetTop - ch1.offsetTop)));
        rail.style.height = `${(progressFraction * 100).toFixed(1)}%`;
      }

      // Update storyline chapter indicators
      chapters.forEach((ch) => {
        const idx = parseInt(ch.getAttribute("data-story-index") || "1", 10);
        const node = ch.querySelector(".chapter-node");
        if (idx === activeIdx) {
          ch.classList.remove("opacity-75");
          ch.classList.add("opacity-100");
          if (node) {
            node.className = "chapter-node absolute -left-12 sm:-left-16 top-1 w-7 h-7 rounded-full flex items-center justify-center font-mono text-xs font-bold transition-all duration-300 bg-[#171717] text-white dark:bg-white dark:text-black shadow-md ring-4 ring-cyan-400/20 z-10";
          }
        } else {
          ch.classList.add("opacity-75");
          ch.classList.remove("opacity-100");
          if (node) {
            node.className = "chapter-node absolute -left-12 sm:-left-16 top-1 w-7 h-7 rounded-full flex items-center justify-center font-mono text-xs font-medium transition-all duration-300 bg-neutral-100 dark:bg-white/10 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-white/10 z-10";
          }
        }
      });

      // Update pills in header
      pills.forEach((p) => {
        const pNum = parseInt(p.getAttribute("data-jump-story") || "1", 10);
        if (pNum === activeIdx) {
          p.className = "story-pill px-3 py-1.5 rounded-lg bg-white dark:bg-[#141414] text-neutral-900 dark:text-white font-semibold shadow-xs transition";
        } else {
          p.className = "story-pill px-3 py-1.5 rounded-lg text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition";
        }
      });

      // Dynamic depth scaling on stacked cards (smooth physical deck feel)
      if (window.innerWidth >= 1024) {
        cards.forEach((card, i) => {
          const cardNum = i + 1;
          if (cardNum < activeIdx) {
            // Card is behind the active card in the stack
            const depthDiff = activeIdx - cardNum;
            const scaleVal = Math.max(0.91, 1 - depthDiff * 0.03);
            const brightnessVal = Math.max(0.86, 1 - depthDiff * 0.045);
            card.style.transform = `scale(${scaleVal}) translateY(-${depthDiff * 4}px)`;
            card.style.filter = `brightness(${brightnessVal})`;
            card.style.opacity = `${Math.max(0.7, 1 - depthDiff * 0.1)}`;
          } else {
            // Active or upcoming card
            card.style.transform = "none";
            card.style.filter = "none";
            card.style.opacity = "1";
          }
        });
      }
    }

    // Initialize alignment and track dimensions
    alignStorylineTrack();
    alignChaptersAndCards();

    window.addEventListener("scroll", onScrollSync, { passive: true });
    window.addEventListener("resize", () => {
      alignStorylineTrack();
      alignChaptersAndCards();
      onScrollSync();
    }, { passive: true });

    if ((window as any).lenis) {
      (window as any).lenis.on("scroll", onScrollSync);
    }

    onScrollSync();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupDualStorylineAndStacking);
  } else {
    setupDualStorylineAndStacking();
  }
  document.addEventListener("astro:page-load", setupDualStorylineAndStacking);
</script>
