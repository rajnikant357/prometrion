---
// Badge.astro - Technical chip / status indicator with Dark Mode support
interface Props {
  variant?: 'neutral' | 'blue' | 'emerald' | 'amber' | 'purple';
  class?: string;
}

const { variant = 'neutral', class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  neutral: 'bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border-neutral-200 dark:border-neutral-800',
  blue: 'bg-blue-50 dark:bg-blue-950/60 text-[#0070f3] dark:text-cyan-400 border-blue-200 dark:border-blue-900/60',
  emerald: 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 border-emerald-200 dark:border-emerald-900/60',
  amber: 'bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 border-amber-200 dark:border-amber-900/60',
  purple: 'bg-purple-50 dark:bg-purple-950/60 text-purple-700 dark:text-purple-400 border-purple-200 dark:border-purple-900/60',
};

const badgeClass = `inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium border ${variants[variant]} ${className}`;
---

<span class={badgeClass}>
  <slot />
</span>
