---
// src/pages/store/appstore/[slug].astro
// Dynamic Application Detail Page for Prometrion Appstore
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Button from "../../../components/ui/Button.astro";
import Badge from "../../../components/ui/Badge.astro";
import SectionEyebrow from "../../../components/ui/SectionEyebrow.astro";
import { appstoreApps, getAppDownloadAvailability, type AppstoreApp } from "../../../data/appstoreApps";

export function getStaticPaths() {
  return appstoreApps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

import { buildSoftwareApplicationSchema, buildBreadcrumbSchema } from "../../../utils/seo";

const { app } = Astro.props;
const availability = getAppDownloadAvailability(app);
const platformLabel = Array.isArray(app.platforms) ? app.platforms.join(", ") : app.platforms;

const appSchema = buildSoftwareApplicationSchema({
  name: app.name,
  description: app.shortDescription,
  applicationCategory: app.category || "UtilitiesApplication",
  operatingSystem: app.systemRequirements || "Android 8.0+",
  downloadUrl: app.githubReleaseUrl || app.directApkUrl,
  slug: app.slug,
});

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Store", url: "/store" },
  { name: "Appstore", url: "/store/appstore" },
  { name: app.name, url: `/store/appstore/${app.slug}` },
]);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    appSchema,
    breadcrumbSchema,
  ],
};
---

<BaseLayout
  title={`${app.name} — Android Appstore | Prometrion`}
  description={app.shortDescription}
  jsonLd={jsonLd}
>
  <!-- Ambient Atmospheric Aurora Glow -->
  <div class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[500px] overflow-hidden opacity-0 dark:opacity-100 transition-opacity">
    <div class="absolute -top-[200px] left-1/2 -translate-x-1/2 w-[800px] h-[450px] rounded-full bg-gradient-to-r from-emerald-500/15 via-cyan-500/20 to-sky-500/15 blur-[120px]"></div>
  </div>

  <!-- Breadcrumbs & Header Strip -->
  <section class="border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070707] transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <nav class="flex items-center gap-2 text-xs font-mono text-neutral-500 dark:text-neutral-400 mb-3">
        <a href="/store" class="hover:text-neutral-900 dark:hover:text-white transition">Store</a>
        <span>/</span>
        <a href="/store/appstore" class="hover:text-neutral-900 dark:hover:text-white transition">Appstore</a>
        <span>/</span>
        <span class="text-neutral-900 dark:text-white font-medium">{app.name}</span>
      </nav>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-start gap-4">
          <!-- App Icon Frame -->
          <div class="w-16 h-16 rounded-xl bg-gradient-to-tr from-neutral-800 to-neutral-950 text-white flex items-center justify-center font-bold text-2xl shadow-whisper shrink-0 ring-1 ring-white/10">
            {app.name.charAt(0)}
          </div>
          <div>
            <div class="flex items-center gap-2.5 flex-wrap">
              <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white">
                {app.name}
              </h1>
              <Badge variant="blue">{app.category}</Badge>
              {availability === "available" && (
                <Badge variant="emerald">Release Available</Badge>
              )}
              {availability === "release_only" && (
                <Badge variant="cyan">GitHub Release</Badge>
              )}
              {availability === "coming_soon" && (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                  Release Scheduled
                </span>
              )}
            </div>
            <div class="flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400 mt-1 font-mono">
              <span>{app.developer}</span>
              <span>•</span>
              <span>v{app.currentVersion}</span>
              <span>•</span>
              <span>{platformLabel}</span>
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex items-center gap-3 shrink-0 flex-wrap">
          {availability === "available" && app.apkDownloadUrl ? (
            <a
              href={app.apkDownloadUrl}
              download
              class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold rounded-full bg-[#171717] text-white dark:bg-white dark:text-black hover:opacity-90 transition shadow-sm cursor-pointer"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Download APK ({app.apkFileSize || "Release Asset"})</span>
            </a>
          ) : availability === "release_only" && app.githubReleaseUrl ? (
            <a
              href={app.githubReleaseUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold rounded-full bg-[#171717] text-white dark:bg-white dark:text-black hover:opacity-90 transition shadow-sm cursor-pointer"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>View GitHub Release</span>
            </a>
          ) : (
            <button
              type="button"
              disabled
              class="inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold rounded-full bg-neutral-100 dark:bg-white/5 border border-neutral-200/60 dark:border-white/10 text-neutral-400 dark:text-neutral-500 cursor-not-allowed opacity-90"
              title="Official binary will be published directly via GitHub Releases"
            >
              <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
              <span>Download Coming Soon</span>
            </button>
          )}

          <Button
            variant="secondary"
            href={`/request-quote?app=${encodeURIComponent(app.name)}`}
            size="sm"
          >
            Request Custom App Dev
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Layout -->
  <section class="py-10 sm:py-14 bg-[#fafafa] dark:bg-black/50 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Application Details & Showcase (8 cols) -->
        <div class="lg:col-span-8 space-y-6">

          <!-- Application Interface Preview Console -->
          <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] overflow-hidden shadow-whisper">
            <!-- Inspection Window Chrome -->
            <div class="px-4 py-3 border-b border-neutral-100 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.02] flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400/80 inline-block"></span>
              </div>
              <div class="flex items-center gap-2 px-3 py-1 rounded bg-white dark:bg-black/40 border border-neutral-200/80 dark:border-white/10 text-[11px] font-mono text-neutral-500 dark:text-neutral-400 max-w-sm truncate">
                <span class="text-neutral-400">package:</span>
                <span class="text-neutral-800 dark:text-neutral-200 font-semibold">{app.packageIdentifier || `com.prometrion.${app.slug}`}</span>
              </div>
              <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                Verified Manifest
              </span>
            </div>

            <!-- Preview Visual or Architectural Showcase -->
            {app.screenshots && app.screenshots.length > 0 ? (
              <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4 bg-neutral-950">
                {app.screenshots.map((s, idx) => (
                  <div class="rounded-lg overflow-hidden border border-white/10 bg-neutral-900">
                    <img src={s} alt={`${app.name} screenshot ${idx + 1}`} class="w-full h-auto object-cover" />
                  </div>
                ))}
              </div>
            ) : (
              <div class="p-8 sm:p-12 bg-gradient-to-br from-neutral-900 via-[#0e0e0e] to-neutral-950 relative overflow-hidden">
                <div class="absolute -top-24 -right-24 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

                <div class="relative z-10 max-w-2xl mx-auto text-center space-y-4">
                  <div class="w-16 h-16 mx-auto rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white shadow-lg">
                    <svg class="w-8 h-8 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <h3 class="text-xl font-semibold text-white tracking-tight">{app.name}</h3>
                  <p class="text-xs text-neutral-400 leading-relaxed max-w-lg mx-auto">
                    {app.shortDescription}
                  </p>

                  <div class="pt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-left">
                    <div class="p-3 rounded-lg bg-white/5 border border-white/10 font-mono">
                      <span class="text-[10px] text-neutral-400 block">VERSION</span>
                      <strong class="text-white text-xs">v{app.currentVersion}</strong>
                    </div>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/10 font-mono">
                      <span class="text-[10px] text-neutral-400 block">PACKAGE SIZE</span>
                      <strong class="text-white text-xs">{app.apkFileSize || "Release Asset"}</strong>
                    </div>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/10 font-mono">
                      <span class="text-[10px] text-neutral-400 block">MIN ANDROID</span>
                      <strong class="text-white text-xs">{app.minimumAndroidVersion || "API 29+"}</strong>
                    </div>
                    <div class="p-3 rounded-lg bg-white/5 border border-white/10 font-mono">
                      <span class="text-[10px] text-neutral-400 block">DISTRIBUTION</span>
                      <strong class="text-emerald-400 text-xs">GitHub Releases</strong>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>

          <!-- Deep Narrative Overview -->
          <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-6 sm:p-8 shadow-whisper space-y-4">
            <SectionEyebrow tag="01. OVERVIEW">APPLICATION ARCHITECTURE</SectionEyebrow>
            <h2 class="text-lg sm:text-xl font-semibold text-neutral-900 dark:text-white">
              About {app.name}
            </h2>
            <p class="text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
              {app.fullDescription}
            </p>
          </div>

          <!-- Verified Feature Set -->
          <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-6 sm:p-8 shadow-whisper space-y-4">
            <SectionEyebrow tag="02. CAPABILITIES">ENGINEERED FEATURES</SectionEyebrow>
            <h3 class="text-base font-semibold text-neutral-900 dark:text-white">
              Verified Capabilities & Workflows
            </h3>
            <ul class="space-y-3 pt-2">
              {app.features.map((feature) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
                  <div class="w-5 h-5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Release Notes & Changelog -->
          <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-6 sm:p-8 shadow-whisper space-y-4">
            <SectionEyebrow tag="03. RELEASE NOTES">CHANGELOG & VERSIONING</SectionEyebrow>
            <div class="flex items-center justify-between pb-3 border-b border-neutral-100 dark:border-white/10">
              <h3 class="text-base font-semibold text-neutral-900 dark:text-white font-mono">
                Build Release v{app.currentVersion}
              </h3>
              <span class="text-xs font-mono text-neutral-500 dark:text-neutral-400">
                {app.releaseDate || "Upcoming Release"}
              </span>
            </div>
            <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
              {app.releaseNotes || "Initial build release for mobile systems and edge telemetry client."}
            </p>
          </div>

          <!-- Android APK Sideloading & Installation Guidance -->
          <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-6 sm:p-8 shadow-whisper space-y-4">
            <SectionEyebrow tag="04. INSTALLATION">ANDROID SIDELOADING GUIDE</SectionEyebrow>
            <h3 class="text-base font-semibold text-neutral-900 dark:text-white">
              How to Install Standalone Android Packages (.apk)
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
              Prometrion distributes production Android binaries directly through verified GitHub Releases. Follow these safe sideloading steps on your Android device:
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <div class="p-4 rounded-lg bg-neutral-50 dark:bg-white/[0.03] border border-neutral-200/80 dark:border-white/10 space-y-2">
                <span class="w-6 h-6 rounded-full bg-neutral-900 text-white dark:bg-white dark:text-black flex items-center justify-center font-bold text-xs">1</span>
                <h4 class="text-xs font-semibold text-neutral-900 dark:text-white">Download Binary</h4>
                <p class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-relaxed">
                  Download the standalone <code class="font-mono text-neutral-800 dark:text-neutral-200">.apk</code> file directly from the GitHub Release link above.
                </p>
              </div>

              <div class="p-4 rounded-lg bg-neutral-50 dark:bg-white/[0.03] border border-neutral-200/80 dark:border-white/10 space-y-2">
                <span class="w-6 h-6 rounded-full bg-neutral-900 text-white dark:bg-white dark:text-black flex items-center justify-center font-bold text-xs">2</span>
                <h4 class="text-xs font-semibold text-neutral-900 dark:text-white">Enable Install</h4>
                <p class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-relaxed">
                  In Android Settings, toggle <strong class="text-neutral-700 dark:text-neutral-300">"Install Unknown Apps"</strong> for your web browser or file manager.
                </p>
              </div>

              <div class="p-4 rounded-lg bg-neutral-50 dark:bg-white/[0.03] border border-neutral-200/80 dark:border-white/10 space-y-2">
                <span class="w-6 h-6 rounded-full bg-neutral-900 text-white dark:bg-white dark:text-black flex items-center justify-center font-bold text-xs">3</span>
                <h4 class="text-xs font-semibold text-neutral-900 dark:text-white">Launch & Verify</h4>
                <p class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-relaxed">
                  Tap the downloaded package, complete the installation prompt, and launch the application directly.
                </p>
              </div>
            </div>

            <div class="p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-700 dark:text-emerald-300 flex items-center gap-2">
              <svg class="w-4 h-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Prometrion builds are independently signed and strictly zero-telemetry. No Google Play Services login required.</span>
            </div>
          </div>

        </div>

        <!-- Right: Technical Specifications & CTAs (4 cols) -->
        <div class="lg:col-span-4 space-y-6">
          
          <!-- Technical Specs Card -->
          <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-6 shadow-whisper space-y-4">
            <h3 class="text-sm font-semibold text-neutral-900 dark:text-white font-mono uppercase tracking-wider">
              Technical Specifications
            </h3>
            
            <div class="space-y-3 text-xs font-mono">
              <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-white/10">
                <span class="text-neutral-500 dark:text-neutral-400">Package Identifier:</span>
                <span class="text-neutral-900 dark:text-white font-semibold">{app.packageIdentifier || `com.prometrion.${app.slug}`}</span>
              </div>
              <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-white/10">
                <span class="text-neutral-500 dark:text-neutral-400">Current Version:</span>
                <span class="text-neutral-900 dark:text-white font-semibold">v{app.currentVersion}</span>
              </div>
              <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-white/10">
                <span class="text-neutral-500 dark:text-neutral-400">Min Android OS:</span>
                <span class="text-neutral-900 dark:text-white font-semibold">{app.minimumAndroidVersion}</span>
              </div>
              <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-white/10">
                <span class="text-neutral-500 dark:text-neutral-400">Architecture:</span>
                <span class="text-neutral-900 dark:text-white font-semibold">{platformLabel}</span>
              </div>
              <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-white/10">
                <span class="text-neutral-500 dark:text-neutral-400">Package Size:</span>
                <span class="text-neutral-900 dark:text-white font-semibold">{app.apkFileSize || "Release Asset"}</span>
              </div>
              <div class="flex items-center justify-between pb-2 border-b border-neutral-100 dark:border-white/10">
                <span class="text-neutral-500 dark:text-neutral-400">Distribution Channel:</span>
                <span class="text-emerald-600 dark:text-emerald-400 font-semibold">GitHub Releases</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-neutral-500 dark:text-neutral-400">Developer:</span>
                <span class="text-neutral-900 dark:text-white font-semibold">{app.developer}</span>
              </div>
            </div>
          </div>

          <!-- Declared Android Permissions -->
          <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-6 shadow-whisper space-y-3">
            <h3 class="text-sm font-semibold text-neutral-900 dark:text-white font-mono uppercase tracking-wider">
              Declared Permissions
            </h3>
            <p class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-relaxed">
              Engineered under the principle of minimal required privileges:
            </p>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {(app.permissions || ["INTERNET"]).map((p) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/10 text-neutral-700 dark:text-neutral-300 border border-neutral-200/60 dark:border-white/10">
                  android.permission.{p}
                </span>
              ))}
            </div>
          </div>

          <!-- Developer & Trust Guarantee -->
          <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-6 shadow-whisper space-y-3">
            <h3 class="text-sm font-semibold text-neutral-900 dark:text-white font-mono uppercase tracking-wider">
              Security & Privacy
            </h3>
            <ul class="space-y-2 text-xs text-neutral-600 dark:text-neutral-300 leading-relaxed">
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Zero third-party tracking or advertising SDKs</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Direct GitHub cryptographic binary checksums</span>
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>No required user registration for downloads</span>
              </li>
            </ul>
            <div class="pt-2">
              <a
                href={app.privacyPolicyUrl || "/privacy"}
                class="text-[11px] font-mono text-[#0070f3] dark:text-cyan-400 hover:underline"
              >
                Prometrion Privacy Policy ↗
              </a>
            </div>
          </div>

          <!-- Business Conversion CTA Box -->
          <div class="bg-gradient-to-br from-neutral-900 to-black text-white rounded-[6px] p-6 border border-neutral-800 shadow-xl space-y-4 relative overflow-hidden">
            <div class="absolute -top-12 -right-12 w-32 h-32 bg-cyan-500/20 rounded-full blur-2xl pointer-events-none"></div>
            
            <span class="text-[10px] font-mono uppercase tracking-widest text-cyan-400 block font-semibold">
              ✦ CUSTOM ENGINEERING
            </span>
            <h4 class="text-base font-semibold leading-snug">
              Need a custom mobile app like {app.name}?
            </h4>
            <p class="text-xs text-neutral-400 leading-relaxed">
              We design, build, and deploy native Android applications, internal tools, and offline-first mobile systems tailored to your enterprise.
            </p>
            <div class="pt-2 flex flex-col gap-2">
              <a
                href={`/request-quote?app=${encodeURIComponent(app.name)}`}
                class="btn-white-solid inline-flex items-center justify-center gap-1.5 px-4 py-2.5 text-xs font-semibold rounded-full transition shadow-sm cursor-pointer"
                style="background-color: #ffffff !important; color: #000000 !important;"
              >
                Request a Custom App →
              </a>
              <a
                href="/services/app-development"
                class="inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-medium rounded-full bg-white/10 text-neutral-300 hover:text-white hover:bg-white/20 transition"
              >
                Explore App Dev Services
              </a>
            </div>
          </div>

          <!-- Back to Appstore Link -->
          <div class="pt-2 text-center">
            <a
              href="/store/appstore"
              class="text-xs font-mono text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition inline-flex items-center gap-1"
            >
              ← Back to All {appstoreApps.length} Android Applications
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>
