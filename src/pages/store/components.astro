---
// store/components.astro - Prometrion Component Store
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";

const componentsList = [
  {
    title: "Geist Header & Mega-Menu",
    category: "Navigation",
    frameworks: ["React", "Astro", "Tailwind v4"],
    desc: "Sticky navigation with multi-column mega menus, Cmd+K search button, and animated mobile drawer.",
    codeSnippet: `<header class="sticky top-0 z-40 w-full border-b border-[#ebebeb] bg-white/90 backdrop-blur-md">...`,
  },
  {
    title: "Conic Mesh Hero Section",
    category: "Hero Bands",
    frameworks: ["React", "HTML", "Tailwind"],
    desc: "Atmospheric multi-stop radial gradient banner with dual marketing CTA pills and terminal mockup.",
    codeSnippet: `<section class="relative overflow-hidden pt-20 pb-28 mesh-gradient">...`,
  },
  {
    title: "Bento Feature Grid 3-Up",
    category: "Layouts",
    frameworks: ["React", "Astro", "Tailwind"],
    desc: "Asymmetrical hairline-bordered cards with hover elevation, subtle shadows, and status chips.",
    codeSnippet: `<div class="grid grid-cols-1 md:grid-cols-3 gap-6">...`,
  },
  {
    title: "Interactive Pricing Matrix",
    category: "Pricing",
    frameworks: ["React", "Next.js", "Tailwind"],
    desc: "Annual/monthly billing switch, feature checklist with emerald checkmarks, and highlight tier badge.",
    codeSnippet: `<div class="rounded-[6px] border border-[#ebebeb] p-8 shadow-floating">...</div>`,
  },
  {
    title: "Floating AI Assistant Bubble",
    category: "Widgets",
    frameworks: ["JavaScript", "Tailwind"],
    desc: "Fixed bottom-right chat launcher with expandable dialog, quick chips, and deep-link responses.",
    codeSnippet: `<div id="prometrion-chatbot" class="fixed bottom-6 right-6 z-50">...`,
  },
  {
    title: "Technical Multi-Column Footer",
    category: "Footers",
    frameworks: ["HTML", "Astro", "Tailwind"],
    desc: "5-column links grid, live operational status beacon, and social channel SVG icons.",
    codeSnippet: `<footer class="w-full border-t border-[#ebebeb] bg-[#fafafa] pt-16 pb-12">...`,
  },
];
---

<BaseLayout
  title="Component Store — Prometrion UI Library"
  description="Explore production-ready UI components, templates, and sections built with Tailwind CSS v4."
>
  <div class="py-14 sm:py-20 border-b border-[#ebebeb] bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionEyebrow tag="MARKETPLACE / COMPONENTS">DEVELOPER UI STORE</SectionEyebrow>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717]">
        UI Components & Building Blocks
      </h1>
      <p class="mt-3 text-neutral-600 max-w-xl text-sm sm:text-base leading-relaxed">
        Engineered according to the Geist design system. Accessible, high-contrast, zero-dependency Tailwind CSS v4 components.
      </p>

      <!-- Framework filter pills -->
      <div class="mt-8 flex flex-wrap gap-2 pt-4 border-t border-neutral-100">
        <button class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-neutral-900 text-white">All Components</button>
        <button class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">Navigation</button>
        <button class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">Hero & CTAs</button>
        <button class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">Pricing</button>
        <button class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">Widgets & Forms</button>
      </div>
    </div>
  </div>

  <div class="py-16 bg-[#fafafa]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {componentsList.map((comp) => (
          <div class="bg-white border border-[#ebebeb] rounded-[6px] overflow-hidden shadow-whisper hover:shadow-floating transition-all flex flex-col justify-between">
            <div class="p-6">
              <div class="flex items-center justify-between mb-2">
                <Badge variant="purple">{comp.category}</Badge>
                <div class="flex gap-1.5">
                  {comp.frameworks.map(fw => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 text-neutral-600">
                      {fw}
                    </span>
                  ))}
                </div>
              </div>

              <h3 class="text-base font-semibold text-neutral-900 mt-2">{comp.title}</h3>
              <p class="text-xs text-neutral-600 mt-1 leading-relaxed">{comp.desc}</p>

              <!-- Code Preview Window -->
              <div class="mt-4 bg-[#171717] rounded-lg p-3 text-neutral-300 font-mono text-[11px] overflow-x-auto">
                <code>{comp.codeSnippet}</code>
              </div>
            </div>

            <div class="px-6 py-3 bg-neutral-50/80 border-t border-[#ebebeb] flex items-center justify-between">
              <span class="text-xs font-mono font-medium text-emerald-600">MIT Open Source</span>
              <div class="flex gap-2">
                <Button variant="ghost-sm" href="/contact">View Live Sandbox</Button>
                <Button variant="primary-sm" href="/contact">Copy Code</Button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
