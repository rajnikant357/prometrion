---
// store/webstore.astro - Prometrion Webstore
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";

const webProducts = [
  {
    id: "apex-saas",
    title: "Apex SaaS & Platform Starter",
    category: "SaaS",
    desc: "Production-ready enterprise SaaS template with authentication, subscription billing, and dark/light themes.",
    price: "$79",
    stack: ["Astro 7", "Tailwind v4", "TypeScript"],
    rating: "4.9 (42 reviews)",
  },
  {
    id: "mono-agency",
    title: "Mono Creative Studio",
    category: "Agency",
    desc: "High-contrast minimalist agency template inspired by Swiss typography with animated case studies.",
    price: "$49",
    stack: ["Astro", "Tailwind", "Framer Motion"],
    rating: "5.0 (28 reviews)",
  },
  {
    id: "lumen-commerce",
    title: "Lumen Headless Commerce",
    category: "E-Commerce",
    desc: "Blazing-fast e-commerce storefront with instant cart drawer, Stripe hooks, and sub-100ms page transitions.",
    price: "$99",
    stack: ["Next.js", "Tailwind", "Shopify/Stripe"],
    rating: "4.8 (63 reviews)",
  },
  {
    id: "horizon-clinic",
    title: "Horizon Health & Clinic Portal",
    category: "Healthcare",
    desc: "Doctor appointments booking, patient intake form, doctor profiles, and HIPAA-compliant layout schema.",
    price: "$59",
    stack: ["Astro", "Tailwind", "JSON-LD"],
    rating: "4.9 (19 reviews)",
  },
  {
    id: "veritas-consulting",
    title: "Veritas Executive Advisory",
    category: "Business",
    desc: "Authoritative corporate website for law firms, accounting practices, and venture funds with lead capture.",
    price: "$69",
    stack: ["Astro 7", "Tailwind", "Responsive"],
    rating: "5.0 (31 reviews)",
  },
  {
    id: "devpulse-docs",
    title: "DevPulse Developer Hub",
    category: "Docs & Tech",
    desc: "Full technical documentation and API reference theme with Cmd+K search and multi-language code tabs.",
    price: "$39",
    stack: ["Astro Starlight", "Tailwind"],
    rating: "4.9 (84 reviews)",
  },
];
---

<BaseLayout
  title="Webstore — Prometrion Marketplace"
  description="Explore production-grade website templates, SaaS frontends, and turnkey digital web packages."
>
  <div class="py-14 sm:py-20 border-b border-[#ebebeb] bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionEyebrow tag="MARKETPLACE / WEBSTORE">WEBSITE PRODUCTS</SectionEyebrow>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717]">
        Production Websites & Templates
      </h1>
      <p class="mt-3 text-neutral-600 max-w-xl text-sm sm:text-base leading-relaxed">
        Engineered with sub-second page loads, accessible semantic HTML, and pre-configured SEO schema. Launch your venture today.
      </p>

      <!-- Category Filter Pills -->
      <div class="mt-8 flex flex-wrap gap-2 pt-4 border-t border-neutral-100">
        <button class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-neutral-900 text-white">All Templates</button>
        <button class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">SaaS & Apps</button>
        <button class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">Agency & Portfolio</button>
        <button class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">E-Commerce</button>
        <button class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">Healthcare & Clinic</button>
      </div>
    </div>
  </div>

  <!-- Products Grid -->
  <div class="py-16 bg-[#fafafa]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {webProducts.map((p) => (
          <Card variant="interactive" class="flex flex-col justify-between">
            <div>
              <div class="aspect-video bg-neutral-100 rounded-lg mb-4 flex items-center justify-center text-neutral-400 font-mono text-xs border border-neutral-200/60 relative overflow-hidden group-hover:border-neutral-300">
                <div class="absolute inset-0 flex items-center justify-center bg-neutral-900/5 backdrop-blur-[1px] opacity-0 group-hover:opacity-100 transition-opacity">
                  <span class="px-3 py-1 bg-white text-black font-sans text-xs font-medium rounded-full shadow-sm">
                    Live Demo ↗
                  </span>
                </div>
                <span>[ {p.category} Preview ]</span>
              </div>

              <div class="flex items-center justify-between text-xs mb-1">
                <Badge variant="blue">{p.category}</Badge>
                <span class="text-neutral-500 font-mono text-[11px]">★ {p.rating}</span>
              </div>

              <h3 class="font-semibold text-base text-neutral-900 mt-2">
                {p.title}
              </h3>
              <p class="text-xs text-neutral-600 mt-2 leading-relaxed">
                {p.desc}
              </p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.stack.map(tech => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 text-neutral-600">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-neutral-100 flex items-center justify-between">
              <span class="text-lg font-mono font-bold text-[#171717]">{p.price}</span>
              <div class="flex gap-2">
                <Button variant="ghost-sm" href="/contact">
                  Preview
                </Button>
                <Button variant="primary-sm" href="/contact">
                  Get Template
                </Button>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
