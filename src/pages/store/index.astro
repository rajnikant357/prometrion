---
// store/index.astro - Prometrion Store Hub
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import WireframeGlobe from "../../components/ui/WireframeGlobe.astro";
import StoreHero from "../../components/ui/StoreHero.astro";
import { webstoreProjects } from "../../data/webstoreProjects";
import { appstoreApps, getAppDownloadAvailability } from "../../data/appstoreApps";
import { buildBreadcrumbSchema } from "../../utils/seo";

// Featured 2-row sets for both showcase containers (3 columns x 2 rows = 6 cards)
const featuredWebProjects = webstoreProjects.slice(0, 6);
const featuredApps = appstoreApps.slice(0, 6);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Store", url: "/store" },
]);
---

<BaseLayout
  title="Store — Prometrion Webstore & Appstore"
  description="Explore the Prometrion digital marketplace: Production Webstore templates and modern Android applications."
  jsonLd={breadcrumbSchema}
>
  <!-- Unified Prometrion Store Hero & Navbuttons -->
  <StoreHero activeTab="hub" />

  <!-- Store Hub Showcase -->
  <section class="py-8 sm:py-12 bg-[#fafafa] dark:bg-black/50 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Container 1: Webstore Showcase (2 Rows) -->
      <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-6 sm:p-8 shadow-whisper">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-neutral-100 dark:border-white/10">
          <div>
            <div class="flex items-center gap-2">
              <Badge variant="blue">Webstore</Badge>
              <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">Websites & Web Applications Showcase</h2>
            </div>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-1">Explore {webstoreProjects.length} live production websites, platforms, and digital experiences.</p>
          </div>
          <a href="/store/webstore" class="text-xs font-semibold text-[#0070f3] dark:text-cyan-400 hover:underline flex items-center gap-1 shrink-0">
            View All {webstoreProjects.length} Projects →
          </a>
        </div>

        <!-- 2 Rows Grid (3 cols x 2 rows = 6 cards) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-6">
          {featuredWebProjects.map((p) => (
            <Card variant="interactive" href={`/store/webstore/${p.slug}`}>
              <div class="aspect-[16/10] bg-neutral-900 rounded-lg mb-3 overflow-hidden border border-neutral-200/60 dark:border-white/10">
                <img src={p.image} alt={p.name} class="w-full h-full object-cover object-top" loading="lazy" />
              </div>
              <div class="flex justify-between items-center text-xs">
                <h3 class="font-semibold text-neutral-900 dark:text-white truncate">{p.name}</h3>
                <Badge variant="blue">{p.category}</Badge>
              </div>
              <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1 line-clamp-2 leading-relaxed">{p.shortDesc}</p>
            </Card>
          ))}
        </div>
      </div>

      <!-- Container 2: Appstore Showcase (2 Rows) -->
      <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-6 sm:p-8 shadow-whisper">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-neutral-100 dark:border-white/10">
          <div>
            <div class="flex items-center gap-2">
              <Badge variant="emerald">Appstore</Badge>
              <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">Android & Modern Applications</h2>
            </div>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-1">Official Prometrion mobile applications, tools, and utilities.</p>
          </div>
          <a href="/store/appstore" class="text-xs font-semibold text-[#0070f3] dark:text-cyan-400 hover:underline flex items-center gap-1 shrink-0">
            View All {appstoreApps.length} Apps →
          </a>
        </div>

        <!-- 2 Rows Grid (3 cols x 2 rows = 6 cards) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-6">
          {featuredApps.map((app) => {
            const availability = getAppDownloadAvailability(app);
            return (
              <Card variant="interactive" href={`/store/appstore/${app.slug}`}>
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-10 h-10 rounded-[6px] bg-neutral-900 text-white flex items-center justify-center font-bold text-sm shrink-0 ring-1 ring-white/10">
                    {app.name.charAt(0)}
                  </div>
                  <div class="min-w-0 flex-1">
                    <h3 class="font-semibold text-xs text-neutral-900 dark:text-white truncate">{app.name}</h3>
                    <span class="text-[10px] text-neutral-400 font-mono">v{app.currentVersion || app.version} • {app.platforms ? (Array.isArray(app.platforms) ? app.platforms[0] : app.platforms.split(" ")[0]) : "Android"}</span>
                  </div>
                </div>
                <p class="text-[11px] text-neutral-500 dark:text-neutral-400 mt-1 line-clamp-2 leading-relaxed">{app.shortDescription || app.desc}</p>
                <div class="mt-3 flex items-center justify-between text-[11px] font-mono">
                  {availability === "available" ? (
                    <span class="text-emerald-500 font-medium">Release Available</span>
                  ) : availability === "release_only" ? (
                    <span class="text-cyan-500 font-medium">GitHub Release</span>
                  ) : (
                    <span class="text-amber-500 font-medium">Coming Soon</span>
                  )}
                  <span class="text-neutral-400 text-[10px]">{app.apkFileSize || app.fileSize}</span>
                </div>
              </Card>
            );
          })}
        </div>
      </div>

      <!-- Global Edge Delivery Section with 3D Wireframe Globe -->
      <div id="edge-section" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-8 sm:p-12 shadow-floating card-glow-blue scroll-mt-24">
        <div class="lg:col-span-6 space-y-4">
          <Badge variant="emerald">✦ Anycast Storefront Network</Badge>
          <h2 class="text-2xl sm:text-3xl font-semibold text-neutral-900 dark:text-white tracking-tight">
            Instant digital delivery across global edge networks.
          </h2>
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Every web template and application package purchased on Prometrion Store is compiled and cached at the edge node closest to your developer workstation or server.
          </p>
          <div class="grid grid-cols-2 gap-4 pt-2 text-xs font-mono">
            <div class="p-3 rounded-lg bg-neutral-50 dark:bg-white/[0.04] border border-neutral-100 dark:border-white/10">
              <span class="text-neutral-400 block text-[10px]">CACHE PROPAGATION</span>
              <strong class="text-emerald-500 text-sm">Instant Edge HIT</strong>
            </div>
            <div class="p-3 rounded-lg bg-neutral-50 dark:bg-white/[0.04] border border-neutral-100 dark:border-white/10">
              <span class="text-neutral-400 block text-[10px]">EDGE ROUTING</span>
              <strong class="text-cyan-400 text-sm">Global Anycast</strong>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <WireframeGlobe 
            title="Prometrion Global Edge Nodes" 
            badge="Real-time Asset Distribution"
            size="md"
          />
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
