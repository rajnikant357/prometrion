---
// products/taluq-ai.astro - Taluq AI Flagship Product Deep-dive
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
import WireframeGlobe from "../../components/ui/WireframeGlobe.astro";
---

<BaseLayout
  title="Taluq AI — Autonomous Intelligence & Agent Platform | Prometrion"
  description="Taluq AI is Prometrion's premier intelligence engine for autonomous agents, multi-step reasoning graphs, and edge execution."
>
  <!-- Hero Section with Conic Mesh Bloom -->
  <section class="relative overflow-hidden pt-20 pb-24 border-b border-[#ebebeb] bg-white">
    <div class="absolute inset-0 -z-10 flex items-center justify-center pointer-events-none">
      <div class="w-[600px] h-[360px] mesh-gradient mesh-glow rounded-full opacity-40"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 mb-6">
        <Badge variant="emerald">✦ GENERAL AVAILABILITY 2.0</Badge>
        <span class="text-xs font-mono text-neutral-400">PROMETRION FLAGSHIP</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-semibold tracking-[-0.04em] text-[#171717] leading-tight">
        Taluq AI
      </h1>
      <p class="mt-4 text-xl font-medium text-neutral-700">
        The Autonomous Intelligence Platform for Enterprise & Developers.
      </p>
      <p class="mt-4 text-sm sm:text-base text-neutral-600 max-w-2xl mx-auto leading-relaxed">
        Taluq AI transforms raw foundation models into reliable, production-ready agentic systems. Built with stateful memory, zero cold starts, and deterministic tool execution.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <Button variant="primary" href="/contact">
          Deploy Taluq in Production
        </Button>
        <Button variant="secondary" href="/articles/docs">
          Read Technical Docs
        </Button>
      </div>
    </div>
  </section>

  <!-- Interactive Architecture Preview -->
  <section class="py-20 bg-[#fafafa] border-b border-[#ebebeb]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <SectionEyebrow tag="ARCHITECTURE">HOW TALUQ AI OPERATES</SectionEyebrow>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717]">
          Three-tier autonomous agent execution
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <Card variant="default">
          <div class="font-mono text-xs font-bold text-[#0070f3] mb-2">TIER 01</div>
          <h3 class="text-base font-semibold text-neutral-900">Cognitive Orchestrator</h3>
          <p class="text-xs text-neutral-600 mt-2 leading-relaxed">
            Deconstructs human prompts into structured directed acyclic graphs (DAGs). Performs self-correction and validation before emitting state changes.
          </p>
        </Card>

        <Card variant="default">
          <div class="font-mono text-xs font-bold text-emerald-600 mb-2">TIER 02</div>
          <h3 class="text-base font-semibold text-neutral-900">Isolated Tool Sandbox</h3>
          <p class="text-xs text-neutral-600 mt-2 leading-relaxed">
            Executes generated code, API queries, and database updates inside ephemeral microVMs with strict memory caps and zero cross-tenant contamination.
          </p>
        </Card>

        <Card variant="default">
          <div class="font-mono text-xs font-bold text-purple-600 mb-2">TIER 03</div>
          <h3 class="text-base font-semibold text-neutral-900">Edge State Cache</h3>
          <p class="text-xs text-neutral-600 mt-2 leading-relaxed">
            Maintains conversational context and agent memories across sessions with sub-10ms retrieval via our Anycast distributed cache layer.
          </p>
        </Card>
      </div>

      <!-- Quickstart Code Sample -->
      <div class="mt-12 bg-[#171717] rounded-[6px] p-6 text-white font-mono text-xs overflow-x-auto shadow-floating">
        <div class="text-neutral-400 pb-2 border-b border-neutral-800 flex justify-between items-center">
          <span>example-agent.ts</span>
          <span class="text-[10px] text-neutral-500">TypeScript / Node 22+</span>
        </div>
        <pre class="pt-4 text-neutral-200 leading-relaxed"><code><span class="text-[#00dfd8]">import</span> &#123; TaluqAgent &#125; <span class="text-[#00dfd8]">from</span> <span class="text-emerald-400">'@prometrion/taluq'</span>;

<span class="text-neutral-400">// Initialize high-concurrency autonomous worker</span>
<span class="text-[#007cf0]">const</span> agent = <span class="text-[#00dfd8]">new</span> TaluqAgent(&#123;
  apiKey: process.env.TALUQ_KEY,
  policy: <span class="text-emerald-400">'strict-enterprise'</span>,
  memoryRetention: <span class="text-amber-400">'30d'</span>
&#125;);

<span class="text-neutral-400">// Run autonomous business workflow</span>
<span class="text-[#007cf0]">const</span> session = <span class="text-[#00dfd8]">await</span> agent.executeTask(&#123;
  task: <span class="text-emerald-400">"Audit webstore performance, fix CLS anomalies, and deploy patch."</span>
&#125;);

console.log(<span class="text-emerald-400">`Status: ${'{session.status}'}, Latency: ${'{session.latencyMs}'}ms`</span>);</code></pre>
      </div>
    </div>
  </section>

  <!-- Global Distributed Runtime Section with 3D Wireframe Globe -->
  <section class="py-20 bg-[#fafafa] dark:bg-black border-b border-[#ebebeb] dark:border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-6 space-y-4">
          <Badge variant="emerald">✦ Distributed Edge Runtime</Badge>
          <h2 class="text-2xl sm:text-3xl font-semibold text-neutral-900 dark:text-white tracking-tight">
            Autonomous intelligence at the speed of light.
          </h2>
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            Taluq AI agents run in isolated sandboxes colocated with users in 300+ edge locations worldwide. Context graphs, vector memory, and tool dispatch occur in under 15ms without central server hops.
          </p>
          <div class="grid grid-cols-2 gap-4 pt-2 text-xs font-mono">
            <div class="p-3 rounded-lg bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">
              <span class="text-neutral-400 block text-[10px]">GLOBAL INFERENCE P95</span>
              <strong class="text-emerald-500 text-sm">&lt;14.8ms</strong>
            </div>
            <div class="p-3 rounded-lg bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">
              <span class="text-neutral-400 block text-[10px]">CONCURRENT AGENTS</span>
              <strong class="text-cyan-400 text-sm">100,000+</strong>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <WireframeGlobe 
            title="Taluq Global Mesh Network" 
            badge="Autonomous Sandboxes Active"
            size="md"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-white text-center">
    <div class="max-w-2xl mx-auto px-4">
      <h3 class="text-2xl font-semibold text-[#171717]">Ready to integrate Taluq AI?</h3>
      <p class="text-neutral-600 text-xs sm:text-sm mt-2">
        Get direct developer API keys or consult with our solutions architects.
      </p>
      <div class="mt-6 flex justify-center gap-3">
        <Button variant="primary" href="/contact">Request Enterprise Demo</Button>
        <Button variant="secondary" href="/pricing">View API Pricing</Button>
      </div>
    </div>
  </section>
</BaseLayout>
