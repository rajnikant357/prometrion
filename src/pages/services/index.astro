---
// services/index.astro - Prometrion Digital Services Overview
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
---

<BaseLayout
  title="Digital Services — Prometrion"
  description="Explore Prometrion's commercial digital engineering services: Website development, app development, SEO/GEO optimization, solutions catalog, and bundled packages."
>
  <div class="py-6 sm:py-8 border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070707]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <SectionEyebrow tag="COMMERCIAL CAPABILITIES">PROMETRION SERVICES</SectionEyebrow>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white mt-1">
          Engineering that accelerates your digital trajectory.
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-2xl">
          High-conversion web platforms, mobile applications, and AI discoverability systems.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <Button variant="primary" href="/services/packages" size="sm">
          Service Packages
        </Button>
        <Button variant="secondary" href="/services/catalog" size="sm">
          Solutions Catalog
        </Button>
        <Button variant="ghost-sm" href="/contact" size="sm">
          Consult Engineer
        </Button>
      </div>
    </div>
  </div>

  <div class="py-8 sm:py-12 bg-[#fafafa] dark:bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Sharp Bento Grid: Exactly 3 Cards (1 Large + 2 Aligned Small Cards) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        
        <!-- Large Card (7 cols): Website Development with Glowing Border Beam & Deliverable Specs -->
        <div class="lg:col-span-7 bento-card-sharp border-beam-container spotlight-card shadow-floating">
          <div class="border-beam-inner p-8 sm:p-10 flex flex-col justify-between h-full bg-dot-grid">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-2">
                  <Badge variant="blue">✦ Flagship Service 01</Badge>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-emerald-400/10 text-emerald-500 border border-emerald-400/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Sub-Second LCP Guarantee
                  </span>
                </div>
                <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">Astro 5 & React</span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-semibold text-[#171717] dark:text-white tracking-tight">
                Enterprise Website Engineering & Cloud Platforms
              </h2>
              <p class="mt-3 text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed max-w-xl">
                Full-lifecycle design, technical architecture, and software engineering for high-growth corporate platforms, SaaS applications, and global digital storefronts. Engineered for extreme conversion, responsive elegance, and global Anycast delivery.
              </p>

              <!-- Live Engineering Specifications Panel -->
              <div class="mt-6 rounded-[6px] border border-neutral-200 dark:border-white/10 bg-neutral-900 dark:bg-black/90 p-4 font-mono text-xs text-neutral-300 shadow-inner">
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/10 text-[11px] text-neutral-400">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
                    <span class="ml-2 text-neutral-300">engineering-sprint-manifest.json</span>
                  </div>
                  <span class="text-cyan-400">PRODUCTION AUDITED</span>
                </div>
                <div class="space-y-1.5 text-neutral-300 text-[11px]">
                  <p class="text-emerald-400">✓ Lighthouse Core Web Vitals: 100 Performance | 100 Accessibility</p>
                  <p class="text-cyan-400">✓ Type-Safe Architecture: TypeScript strict mode + Zod validated schemas</p>
                  <p class="text-sky-300">✓ Edge Deployment: 300+ Anycast PoPs with automated SSL & cache purging</p>
                </div>
              </div>

              <!-- Metrics -->
              <div class="mt-6 grid grid-cols-3 gap-4 pt-4 border-t border-neutral-100 dark:border-white/10 text-xs">
                <div>
                  <span class="block font-semibold text-neutral-900 dark:text-white text-base">&lt;0.5s</span>
                  <span class="text-neutral-500 dark:text-neutral-400 text-[11px]">Largest Contentful Paint</span>
                </div>
                <div>
                  <span class="block font-semibold text-neutral-900 dark:text-white text-base">Zero</span>
                  <span class="text-neutral-500 dark:text-neutral-400 text-[11px]">Layout Shift (CLS 0)</span>
                </div>
                <div>
                  <span class="block font-semibold text-neutral-900 dark:text-white text-base">100%</span>
                  <span class="text-neutral-500 dark:text-neutral-400 text-[11px]">Source Code Ownership</span>
                </div>
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-neutral-100 dark:border-white/10 flex flex-wrap items-center gap-4">
              <Button variant="primary" href="/services/website-development">
                Explore Website Engineering →
              </Button>
              <a href="/services/packages" class="text-xs font-semibold text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition flex items-center gap-1">
                Compare Fixed Packages <span>→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 2 Aligned Small Cards (5 cols) Stacked Vertically -->
        <div class="lg:col-span-5 flex flex-col gap-6 justify-between">
          
          <!-- Small Card 1: App Development -->
          <div class="flex-1 bento-card-sharp spotlight-card p-7 flex flex-col justify-between shadow-whisper hover:shadow-floating">
            <div>
              <div class="flex items-center justify-between mb-3">
                <Badge variant="emerald">SERVICE 02</Badge>
                <span class="text-[11px] font-mono text-emerald-500 font-semibold">Android & Mobile</span>
              </div>
              <h3 class="text-xl font-semibold tracking-tight text-[#171717] dark:text-white">
                Native Android & Cross-Platform Apps
              </h3>
              <p class="mt-2 text-neutral-600 dark:text-neutral-400 text-xs leading-relaxed">
                Native Android engineering and fluid cross-platform applications built with hardware security, biometric auth, offline caching, and responsive UI elegance.
              </p>

              <div class="mt-4 space-y-2 text-xs text-neutral-600 dark:text-neutral-400 font-mono">
                <div class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✔</span> Biometric Authentication & KeyStore
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✔</span> Offline-First SQLite Data Caching
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✔</span> Google Play Release Certification
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-neutral-100 dark:border-white/10 flex items-center justify-between text-xs">
              <span class="text-emerald-600 font-medium">Turnkey Deployment</span>
              <a href="/services/app-development" class="font-medium text-[#0070f3] dark:text-cyan-400 hover:underline">Explore App Development →</a>
            </div>
          </div>

          <!-- Small Card 2: SEO & GEO Optimization -->
          <div class="flex-1 bento-card-sharp spotlight-card p-7 flex flex-col justify-between shadow-whisper hover:shadow-floating">
            <div>
              <div class="flex items-center justify-between mb-3">
                <Badge variant="purple">SERVICE 03</Badge>
                <span class="text-[11px] font-mono text-cyan-400 font-semibold">AI Search Ranking</span>
              </div>
              <h3 class="text-xl font-semibold tracking-tight text-[#171717] dark:text-white">
                SEO & Generative Engine Optimization (GEO)
              </h3>
              <p class="mt-2 text-neutral-600 dark:text-neutral-400 text-xs leading-relaxed">
                Ensure your business is cited and discovered across ChatGPT, Perplexity, Google Gemini, and classical search engines through structured semantic entity graphs.
              </p>

              <div class="mt-4 space-y-2 text-xs text-neutral-600 dark:text-neutral-400 font-mono">
                <div class="flex items-center gap-2">
                  <span class="text-cyan-400 font-bold">⚡</span> AI Engine Citations & Knowledge Graphs
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-cyan-400 font-bold">⚡</span> Schema.org Deep Structured JSON-LD
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-cyan-400 font-bold">⚡</span> 100/100 Core Web Vitals Auditing
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-neutral-100 dark:border-white/10 flex items-center justify-between text-xs">
              <span class="text-cyan-400 font-medium">ChatGPT & Google</span>
              <a href="/services/seo-geo" class="font-medium text-[#0070f3] dark:text-cyan-400 hover:underline">Explore SEO / GEO →</a>
            </div>
          </div>

        </div>

      </div>

      <!-- Service Delivery Signals Marquee Ticker -->
      <div class="pt-4 border-t border-neutral-200 dark:border-white/10">
        <div class="marquee-mask pause-on-hover select-none overflow-hidden">
          <div class="animate-marquee flex items-center gap-6">
            <div class="flex items-center gap-6 shrink-0 text-xs font-mono text-neutral-600 dark:text-neutral-400">
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">⚡ 7-Day Launch Guarantee</span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">🔒 Dedicated Code Repository Ownership</span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">🌐 Sub-Second Global Anycast Delivery</span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">💬 Dedicated Slack / Discord Engineering Channel</span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">🤖 Generative Engine Optimization (GEO) Included</span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">📱 Full Android APK Release Readiness</span>
            </div>
            <!-- Duplicate for Seamless Loop -->
            <div class="flex items-center gap-6 shrink-0 text-xs font-mono text-neutral-600 dark:text-neutral-400" aria-hidden="true">
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">⚡ 7-Day Launch Guarantee</span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">🔒 Dedicated Code Repository Ownership</span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">🌐 Sub-Second Global Anycast Delivery</span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">💬 Dedicated Slack / Discord Engineering Channel</span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">🤖 Generative Engine Optimization (GEO) Included</span>
              <span class="px-3 py-1 rounded-full bg-white dark:bg-white/[0.04] border border-neutral-200 dark:border-white/10">📱 Full Android APK Release Readiness</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Secondary Offerings Grid: Solutions Catalog, Packages, and Pricing -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
        <!-- 4: Ready Solutions Catalog -->
        <Card variant="interactive" href="/services/catalog" class="flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-amber-600">SERVICE 04</span>
              <Badge variant="amber">Turnkey Systems</Badge>
            </div>
            <h2 class="text-xl font-semibold text-neutral-900 group-hover:text-[#0070f3] transition">
              Solutions Catalog
            </h2>
            <p class="text-xs text-neutral-600 mt-2 leading-relaxed">
              Browse productized ready-made architectures for doctors, clinics, schools, restaurants, coaching institutes, and professional service companies.
            </p>
            <div class="mt-4 flex flex-wrap gap-1 text-[11px] font-mono text-neutral-500">
              <span>• Fixed Scopes</span>
              <span>• Rapid 7-Day Launch</span>
              <span>• Managed Hosting</span>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-neutral-100 flex items-center justify-between text-xs text-[#0070f3] font-medium">
            <span>Browse Solutions Catalog</span>
            <span>→</span>
          </div>
        </Card>

        <!-- 5: Packages -->
        <Card variant="interactive" href="/services/packages" class="flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-neutral-900">SERVICE 05</span>
              <Badge variant="neutral">Clear Fixed Pricing</Badge>
            </div>
            <h2 class="text-xl font-semibold text-neutral-900 group-hover:text-[#0070f3] transition">
              Service Packages
            </h2>
            <p class="text-xs text-neutral-600 mt-2 leading-relaxed">
              Structured bundles designed to simplify purchasing: Starter ($499), Business ($1,199), Professional ($2,499), and Enterprise Custom.
            </p>
            <div class="mt-4 flex flex-wrap gap-1 text-[11px] font-mono text-neutral-500">
              <span>• Guaranteed Sprints</span>
              <span>• Dedicated Support</span>
              <span>• Zero Hidden Costs</span>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-neutral-100 flex items-center justify-between text-xs text-[#0070f3] font-medium">
            <span>Compare Service Packages</span>
            <span>→</span>
          </div>
        </Card>

        <!-- 6: Global Pricing -->
        <Card variant="interactive" href="/pricing" class="flex flex-col justify-between bg-neutral-900 text-white">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-neutral-400">GLOBAL PRICING</span>
              <span class="text-[10px] font-mono bg-neutral-800 text-emerald-400 px-2 py-0.5 rounded">Database Driven</span>
            </div>
            <h2 class="text-xl font-semibold text-white">
              Transparent Pricing Matrix
            </h2>
            <p class="text-xs text-neutral-300 mt-2 leading-relaxed">
              Explore our full service tier comparison and interactive usage calculator. Change tiers seamlessly without deployment churn.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-neutral-800 flex items-center justify-between text-xs text-white font-medium">
            <span>Open Global Pricing Page</span>
            <span>→</span>
          </div>
        </Card>

      </div>

    </div>
  </div>
</BaseLayout>
