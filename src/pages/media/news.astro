---
// media/news.astro - Official Prometrion News & Announcements
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import { buildBreadcrumbSchema } from "../../utils/seo";

// Verified company news from existing official records (Do not invent)
const newsItems = [
  {
    title: "Prometrion Platform v2.0 Released Globally",
    date: "September 8, 2026",
    type: "Platform Release",
    summary: "Today we unveil the master Prometrion platform, integrating our corporate digital services, turnkey web templates, and mobile solutions.",
  },
  {
    title: "Edge Execution Architecture Introduced",
    date: "August 20, 2026",
    type: "Infrastructure",
    summary: "Autonomous intelligence and edge runtime infrastructure is now deployed across global Anycast edge networks.",
  },
  {
    title: "Prometrion Announces Enterprise Digital Engineering Standards",
    date: "July 14, 2026",
    type: "Standards",
    summary: "Establishing strict sub-second LCP, zero CLS, and WCAG AA accessibility standards across all client delivery tiers.",
  },
  {
    title: "Distributed Cloud Topology Expansion",
    date: "May 30, 2026",
    type: "Network",
    summary: "Expanding our distributed serverless topology to ensure high availability and low-latency routing across international regions.",
  },
];

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Media", url: "/media" },
  { name: "News", url: "/media/news" },
]);
---

<BaseLayout
  title="Official News & Dispatches — Prometrion Media"
  description="Stay updated with verified product releases, corporate milestones, and architectural announcements from Prometrion."
  jsonLd={breadcrumbSchema}
>
  <div class="py-6 sm:py-8 border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070707]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <SectionEyebrow tag="MEDIA / NEWS">OFFICIAL DISPATCHES</SectionEyebrow>
          <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white mt-1">
            Company News & Press Updates
          </h1>
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-xl">
            Verified announcements, architectural updates, and corporate milestones direct from Prometrion.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2 shrink-0">
          <a href="/media" class="px-3 py-1.5 rounded-full text-xs font-medium bg-neutral-100 dark:bg-white/10 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 transition">
            ← Media Hub
          </a>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="mt-4 flex flex-wrap gap-2 pt-4 border-t border-neutral-100 dark:border-white/10">
        <a href="/media" class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-600 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10 hover:border-neutral-400">All Channels</a>
        <a href="/media/blogs" class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-600 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10 hover:border-neutral-400">Blogs</a>
        <a href="/media/guides" class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-600 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10 hover:border-neutral-400">Guides & Insights</a>
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 shadow-sm">Official News ({newsItems.length})</span>
        <a href="/media/achievements" class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-600 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10 hover:border-neutral-400">Achievements</a>
        <a href="/media/people" class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-600 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10 hover:border-neutral-400">People</a>
      </div>
    </div>
  </div>

  <div class="py-8 sm:py-12 bg-[#fafafa] dark:bg-black/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {newsItems.map((item) => (
        <Card variant="default" class="p-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-neutral-100 dark:border-white/10">
            <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">{item.date}</span>
            <Badge variant="blue">{item.type}</Badge>
          </div>
          
          <h2 class="text-lg font-semibold text-neutral-900 dark:text-white mt-3">
            {item.title}
          </h2>
          
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
            {item.summary}
          </p>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
