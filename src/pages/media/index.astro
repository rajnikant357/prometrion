---
// media/index.astro - Prometrion Media & Content Publishing Hub
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
import WireframeGlobe from "../../components/ui/WireframeGlobe.astro";
import { getPublishedArticles, getPublishedBlogs, getPublishedGuides } from "../../data/blogsData";
import { buildBreadcrumbSchema } from "../../utils/seo";

const allArticles = getPublishedArticles();
const blogs = getPublishedBlogs();
const guides = getPublishedGuides();

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "Media", url: "/media" },
]);
---

<BaseLayout
  title="Media & Publications — Prometrion"
  description="Explore Prometrion engineering blogs, implementation guides, company news, achievements, leadership profiles, and digital insights."
  jsonLd={breadcrumbSchema}
>
  <div class="py-6 sm:py-8 border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070707]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <SectionEyebrow tag="CONTENT & PUBLICATIONS">PROMETRION MEDIA</SectionEyebrow>
          <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white mt-1">
            Media, Publications & Insights
          </h1>
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-xl">
            Technical thinking, architectural guides, company chronology, and leadership profiles.
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <Button variant="secondary" href="/media/guides" size="sm">Practical Guides</Button>
          <Button variant="primary" href="/media/blogs" size="sm">Explore Blogs</Button>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="mt-4 flex flex-wrap gap-2 pt-4 border-t border-neutral-100 dark:border-white/10">
        <a href="/media" class="px-3 py-1 rounded-full text-xs font-medium bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 shadow-sm">All Channels</a>
        <a href="/media/blogs" class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-700 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10 hover:border-neutral-400">Blogs ({blogs.length})</a>
        <a href="/media/guides" class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-700 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10 hover:border-neutral-400">Guides & Insights ({guides.length})</a>
        <a href="/media/news" class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-700 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10 hover:border-neutral-400">Official News</a>
        <a href="/media/achievements" class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-700 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10 hover:border-neutral-400">Achievements</a>
        <a href="/media/people" class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-700 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10 hover:border-neutral-400">People</a>
      </div>
    </div>
  </div>

  <div class="py-8 sm:py-12 bg-[#fafafa] dark:bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Featured Split: Essay + 3D WebGL Wireframe Globe -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        
        <!-- Left: Featured Post with Border Beam & Spotlight -->
        <div class="lg:col-span-7 bento-card-sharp border-beam-container spotlight-card shadow-floating">
          <div class="border-beam-inner p-8 sm:p-10 flex flex-col justify-between h-full bg-dot-grid">
            <div>
              <div class="flex items-center gap-2 mb-4">
                <Badge variant="blue">FEATURED STRATEGIC ESSAY</Badge>
                <span class="text-xs font-mono text-neutral-400">August 2026 • 6 min read</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-semibold text-neutral-900 dark:text-white tracking-tight">
                SEO and GEO: Building Visibility Beyond Traditional Search
              </h2>
              <p class="mt-3 text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed">
                As autonomous AI assistants like ChatGPT, Claude, and Gemini intermediate user search traffic, traditional keywords give way to semantic entity maps, verified JSON-LD graphs, and citations. Here is how Prometrion prepares businesses for this paradigm shift.
              </p>
            </div>
            <div class="mt-8 flex items-center justify-between pt-4 border-t border-neutral-100 dark:border-white/10">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-black flex items-center justify-center font-bold text-xs">
                  R
                </div>
                <div class="text-xs">
                  <span class="font-semibold text-neutral-900 dark:text-white block">Rajnikant</span>
                  <span class="text-neutral-500 dark:text-neutral-400">Chief Architect, Prometrion</span>
                </div>
              </div>
              <Button variant="primary-sm" href="/media/blogs/seo-and-geo-business-visibility">
                Read Full Article →
              </Button>
            </div>
          </div>
        </div>

        <!-- Right: 3D WebGL Wireframe Globe with Coordinate Mapping -->
        <div class="lg:col-span-5 bento-card-sharp overflow-hidden">
          <WireframeGlobe 
            title="Global Knowledge Network" 
            badge="Readers Across 190+ Countries"
            size="md"
            class="h-full min-h-[380px]"
          />
        </div>

      </div>

      <!-- Trending Topics Marquee -->
      <div class="pt-2 border-t border-neutral-200 dark:border-white/10">
        <div class="marquee-mask pause-on-hover select-none overflow-hidden">
          <div class="animate-marquee flex items-center gap-4">
            <div class="flex items-center gap-4 shrink-0 text-xs font-mono text-neutral-600 dark:text-neutral-400">
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ GENERATIVE ENGINE OPTIMIZATION</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ SUB-SECOND TIME-TO-FIRST-BYTE</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ NATIVE ANDROID RUNTIMES</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ ZERO-LAYOUT SHIFT ARCHITECTURE</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ GEIST DESIGN TOKENS</span>
            </div>
            <!-- Duplicate for Continuous Loop -->
            <div class="flex items-center gap-4 shrink-0 text-xs font-mono text-neutral-600 dark:text-neutral-400" aria-hidden="true">
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ GENERATIVE ENGINE OPTIMIZATION</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ SUB-SECOND TIME-TO-FIRST-BYTE</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ NATIVE ANDROID RUNTIMES</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ ZERO-LAYOUT SHIFT ARCHITECTURE</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ GEIST DESIGN TOKENS</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Categories 5-Column Grid -->
      <div>
        <div class="mb-6">
          <SectionEyebrow tag="CHANNELS & FORMATS">MEDIA PLATFORMS</SectionEyebrow>
          <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white mt-1">
            Curated Knowledge Categories
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
          
          <!-- Channel 1: Blogs -->
          <Card variant="interactive" href="/media/blogs">
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-[#0070f3] dark:text-cyan-400">CHANNEL 01</span>
              <Badge variant="blue">Essays</Badge>
            </div>
            <h3 class="text-base font-semibold text-neutral-900 dark:text-white group-hover:text-[#0070f3] dark:group-hover:text-cyan-400 transition">
              Strategic Essays
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
              Perspectives on search evolution, entity modeling, and long-term tech strategy.
            </p>
            <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/10 text-xs text-[#0070f3] dark:text-cyan-400 font-medium">
              Explore {blogs.length} Essays →
            </div>
          </Card>

          <!-- Channel 2: Guides & Insights -->
          <Card variant="interactive" href="/media/guides">
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-sky-600 dark:text-sky-400">CHANNEL 02</span>
              <Badge variant="blue">Guides</Badge>
            </div>
            <h3 class="text-base font-semibold text-neutral-900 dark:text-white group-hover:text-[#0070f3] dark:group-hover:text-cyan-400 transition">
              Practical Guides
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
              Actionable blueprints for website budgeting, scoping, and tech stack choices.
            </p>
            <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/10 text-xs text-[#0070f3] dark:text-cyan-400 font-medium">
              Explore {guides.length} Guides →
            </div>
          </Card>

          <!-- Channel 3: Official News -->
          <Card variant="interactive" href="/media/news">
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-emerald-600">CHANNEL 03</span>
              <Badge variant="emerald">News</Badge>
            </div>
            <h3 class="text-base font-semibold text-neutral-900 dark:text-white group-hover:text-[#0070f3] dark:group-hover:text-cyan-400 transition">
              Company News
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
              Verified announcements, platform updates, and company dispatches.
            </p>
            <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/10 text-xs text-[#0070f3] dark:text-cyan-400 font-medium">
              Read News →
            </div>
          </Card>

          <!-- Channel 4: Achievements -->
          <Card variant="interactive" href="/media/achievements">
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-purple-600">CHANNEL 04</span>
              <Badge variant="purple">Timeline</Badge>
            </div>
            <h3 class="text-base font-semibold text-neutral-900 dark:text-white group-hover:text-[#0070f3] dark:group-hover:text-cyan-400 transition">
              Achievements
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
              Chronological milestones documenting architectural releases and client records.
            </p>
            <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/10 text-xs text-[#0070f3] dark:text-cyan-400 font-medium">
              View Chronology →
            </div>
          </Card>

          <!-- Channel 5: People -->
          <Card variant="interactive" href="/media/people">
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-bold text-neutral-600">CHANNEL 05</span>
              <Badge variant="neutral">People</Badge>
            </div>
            <h3 class="text-base font-semibold text-neutral-900 dark:text-white group-hover:text-[#0070f3] dark:group-hover:text-cyan-400 transition">
              People & Team
            </h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
              Meet the architects, engineers, and designers driving Prometrion.
            </p>
            <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/10 text-xs text-[#0070f3] dark:text-cyan-400 font-medium">
              Meet the Team →
            </div>
          </Card>

        </div>
      </div>

    </div>
  </div>
</BaseLayout>
