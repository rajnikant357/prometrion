---
// articles/news.astro - Official Prometrion News & Announcements
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";

const newsItems = [
  {
    title: "Prometrion Platform v2.0 Released Globally",
    date: "September 8, 2026",
    type: "Platform Release",
    summary: "Today we unveil the master Prometrion platform, integrating our corporate suite, digital store marketplace, and verified community ecosystem.",
  },
  {
    title: "Taluq AI Enters General Availability with Sub-15ms Edge Execution",
    date: "August 20, 2026",
    type: "Product Launch",
    summary: "Our flagship autonomous intelligence infrastructure is now open to enterprise developers and partner agencies worldwide.",
  },
  {
    title: "Prometrion Developer Program Crosses 2,500 Certified Members",
    date: "July 14, 2026",
    type: "Community Growth",
    summary: "Engineers from 30+ countries have joined the Prometrion ecosystem to build applications, contribute UI blocks, and solve client briefs.",
  },
  {
    title: "Prometrion Announces Strategic Partnerships with Modern Cloud Runtimes",
    date: "May 30, 2026",
    type: "Partnership",
    summary: "Expanding our distributed serverless topology to ensure 99.99% uptime and zero-latency routing across Asian, European, and American regions.",
  },
];
---

<BaseLayout
  title="Official News — Prometrion Announcements"
  description="Stay updated with official product releases, corporate updates, and announcements from Prometrion."
>
  <div class="py-14 sm:py-20 border-b border-[#ebebeb] bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionEyebrow tag="ARTICLES / NEWS">OFFICIAL DISPATCHES</SectionEyebrow>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717]">
        Company News & Press Updates
      </h1>
      <p class="mt-3 text-neutral-600 max-w-xl text-sm sm:text-base leading-relaxed">
        Verified announcements, feature rollouts, and corporate milestones direct from Prometrion headquarters.
      </p>
    </div>
  </div>

  <div class="py-16 bg-[#fafafa]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {newsItems.map((item) => (
        <Card variant="interactive">
          <div class="flex items-center gap-2 mb-2">
            <Badge variant="emerald">{item.type}</Badge>
            <span class="text-xs font-mono text-neutral-400">{item.date}</span>
          </div>
          <h2 class="text-lg font-semibold text-neutral-900 group-hover:text-[#0070f3] transition">
            {item.title}
          </h2>
          <p class="text-xs text-neutral-600 mt-2 leading-relaxed">
            {item.summary}
          </p>
          <div class="mt-4 pt-3 border-t border-neutral-100 flex items-center justify-between text-xs">
            <span class="text-neutral-400 font-mono">Prometrion Press Desk</span>
            <span class="text-[#0070f3] font-medium">Read Full Announcement →</span>
          </div>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
