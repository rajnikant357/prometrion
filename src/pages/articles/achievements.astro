---
// articles/achievements.astro - Prometrion Company Achievements & Timeline
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";

const milestones = [
  {
    year: "2026",
    quarter: "Q3",
    title: "Prometrion Platform v2.0 & Global Store Launch",
    desc: "Unification of our corporate software products, web templates store, Android appstore, and developer component registry.",
    highlight: "Platform Unified",
  },
  {
    year: "2026",
    quarter: "Q2",
    title: "Taluq AI Autonomous Agent Infrastructure GA",
    desc: "Proprietary reasoning runtime deployed across 300+ edge Points of Presence with sub-15ms cold start guarantees.",
    highlight: "Flagship AI GA",
  },
  {
    year: "2026",
    quarter: "Q1",
    title: "100th Enterprise Web & Mobile Deployment",
    desc: "Crossed 100 enterprise client implementations with an average Core Web Vitals rating of 98+ and zero security incidents.",
    highlight: "100+ Deployments",
  },
  {
    year: "2025",
    quarter: "Q4",
    title: "Coders Club & Developer Ecosystem Inauguration",
    desc: "Launched our exclusive developer guild and verified badging system, bringing together elite software builders worldwide.",
    highlight: "Community Guild",
  },
  {
    year: "2025",
    quarter: "Q2",
    title: "Prometrion Incorporated",
    desc: "Founded with the mission to build software products, services, and digital ecosystems that move people and businesses forward.",
    highlight: "Genesis",
  },
];
---

<BaseLayout
  title="Achievements — Prometrion Milestones"
  description="Explore the chronological timeline of Prometrion's technological innovations, product releases, and corporate milestones."
>
  <div class="py-14 sm:py-20 border-b border-[#ebebeb] bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionEyebrow tag="ARTICLES / ACHIEVEMENTS">COMPANY MILESTONES</SectionEyebrow>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717]">
        The Chronology of Innovation
      </h1>
      <p class="mt-3 text-neutral-600 max-w-xl text-sm sm:text-base leading-relaxed">
        A record of Prometrion's architectural breakthroughs, product rollouts, and customer achievements as we build the digital future.
      </p>
    </div>
  </div>

  <div class="py-16 bg-[#fafafa]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Interactive Vertical Timeline -->
      <div class="relative border-l-2 border-neutral-200 ml-4 pl-6 sm:pl-8 space-y-12">
        
        {milestones.map((m) => (
          <div class="relative group">
            <!-- Timeline Node Beacon -->
            <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-white border-4 border-[#171717] group-hover:border-[#0070f3] group-hover:scale-125 transition-all"></div>
            
            <Card variant="default">
              <div class="flex items-center justify-between gap-2 mb-2">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-xs font-bold text-neutral-900 bg-neutral-100 px-2 py-0.5 rounded">
                    {m.year} {m.quarter}
                  </span>
                  <Badge variant="blue">{m.highlight}</Badge>
                </div>
                <span class="text-xs font-mono text-emerald-600 font-medium">Verified Milestone ✔</span>
              </div>

              <h2 class="text-lg font-semibold text-neutral-900 mt-2">
                {m.title}
              </h2>
              <p class="text-xs text-neutral-600 mt-2 leading-relaxed">
                {m.desc}
              </p>
            </Card>
          </div>
        ))}

      </div>

    </div>
  </div>
</BaseLayout>
