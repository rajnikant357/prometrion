---
// articles/index.astro - Prometrion Articles & Publishing Hub
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
import WireframeGlobe from "../../components/ui/WireframeGlobe.astro";
---

<BaseLayout
  title="Articles & Knowledge — Prometrion"
  description="Explore Prometrion engineering blogs, company news, achievements, leadership profiles, and technical documentation."
>
  <div class="py-14 sm:py-20 border-b border-[#ebebeb] bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionEyebrow tag="KNOWLEDGE & MEDIA">PROMETRION ARTICLES</SectionEyebrow>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717]">
        Publications, News & Technical Docs
      </h1>
      <p class="mt-3 text-neutral-600 max-w-xl text-sm sm:text-base leading-relaxed">
        Deep technical thinking, product roadmaps, company chronology, team spotlights, and full documentation.
      </p>

      <!-- Category Filter Tabs -->
      <div class="mt-8 flex flex-wrap gap-2 pt-4 border-t border-neutral-100">
        <a href="/articles" class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-neutral-900 text-white">All Channels</a>
        <a href="/articles/blogs" class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">Blogs</a>
        <a href="/articles/news" class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">Official News</a>
        <a href="/articles/achievements" class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">Achievements</a>
        <a href="/articles/people" class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">People</a>
        <a href="/articles/docs" class="px-3.5 py-1.5 rounded-full text-xs font-medium bg-white text-neutral-700 border border-[#ebebeb] hover:border-neutral-400">Documentation</a>
      </div>
    </div>
  </div>

  <div class="py-16 bg-[#fafafa] dark:bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Featured Split: Essay + 3D WebGL Wireframe Globe -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        
        <!-- Left: Featured Post with Border Beam & Spotlight -->
        <div class="lg:col-span-7 bento-card-sharp border-beam-container spotlight-card shadow-floating">
          <div class="border-beam-inner p-8 sm:p-10 flex flex-col justify-between h-full bg-dot-grid">
            <div>
              <div class="flex items-center gap-2 mb-4">
                <Badge variant="blue">FEATURED ENGINEERING ESSAY</Badge>
                <span class="text-xs font-mono text-neutral-400">September 2026 • 8 min read</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-semibold text-neutral-900 dark:text-white tracking-tight">
                The Architecture of Generative Engine Optimization: Dominating the Post-Search Web
              </h2>
              <p class="mt-3 text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed">
                As autonomous AI assistants like ChatGPT, Claude, and Gemini intermediate user search traffic, traditional keywords give way to semantic entity maps, verified JSON-LD graphs, and citations. Here is how Prometrion prepares businesses for this paradigm shift.
              </p>
            </div>
            <div class="mt-8 flex items-center justify-between pt-4 border-t border-neutral-100 dark:border-white/10">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-black flex items-center justify-center font-bold text-xs">
                  R
                </div>
                <div class="text-xs">
                  <span class="font-semibold text-neutral-900 dark:text-white block">Rajnikant</span>
                  <span class="text-neutral-500 dark:text-neutral-400">Chief Architect, Prometrion</span>
                </div>
              </div>
              <Button variant="primary-sm" href="/articles/blogs/seo-geo-business-growth">
                Read Full Article →
              </Button>
            </div>
          </div>
        </div>

        <!-- Right: 3D WebGL Wireframe Globe with Coordinate Mapping -->
        <div class="lg:col-span-5 bento-card-sharp overflow-hidden">
          <WireframeGlobe 
            title="Global Knowledge Network" 
            badge="Readers Across 190+ Countries"
            size="md"
            class="h-full min-h-[380px]"
          />
        </div>

      </div>

      <!-- Trending Research & Knowledge Topics Marquee -->
      <div class="pt-2 border-t border-neutral-200 dark:border-white/10">
        <div class="marquee-mask pause-on-hover select-none overflow-hidden">
          <div class="animate-marquee flex items-center gap-4">
            <div class="flex items-center gap-4 shrink-0 text-xs font-mono text-neutral-600 dark:text-neutral-400">
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ GENERATIVE ENGINE OPTIMIZATION</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">⚡ SUB-15MS EDGE RUNTIMES</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">🤖 MULTI-AGENT SWARMS</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">🔒 HARDWARE MICROVM ISOLATION</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">🌐 300+ ANYCAST POP NETWORK</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">📈 CORE WEB VITALS 100/100</span>
            </div>
            <!-- Duplicate for Seamless Infinite Loop -->
            <div class="flex items-center gap-4 shrink-0 text-xs font-mono text-neutral-600 dark:text-neutral-400" aria-hidden="true">
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">✦ GENERATIVE ENGINE OPTIMIZATION</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">⚡ SUB-15MS EDGE RUNTIMES</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">🤖 MULTI-AGENT SWARMS</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">🔒 HARDWARE MICROVM ISOLATION</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">🌐 300+ ANYCAST POP NETWORK</span>
              <span class="px-3 py-1 rounded bg-white dark:bg-white/[0.03] border border-neutral-200 dark:border-white/10">📈 CORE WEB VITALS 100/100</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Publishing Sections 5-Up Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        
        <div class="bento-card-sharp spotlight-card p-6 flex flex-col justify-between">
          <div>
            <Badge variant="blue">Engineering Blog</Badge>
            <h3 class="text-lg font-semibold text-neutral-900 dark:text-white mt-3">Deep Tech & System Design</h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
              Explorations into TypeScript compiler performance, edge computing, distributed microVMs, and AI agent architectures.
            </p>
          </div>
          <a href="/articles/blogs" class="inline-block mt-4 text-xs font-medium text-[#0070f3] dark:text-cyan-400">Browse Blog Articles →</a>
        </div>

        <div class="bento-card-sharp spotlight-card p-6 flex flex-col justify-between">
          <div>
            <Badge variant="emerald">Official News</Badge>
            <h3 class="text-lg font-semibold text-neutral-900 dark:text-white mt-3">Releases & Announcements</h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
              Stay up to date with new feature deployments, store listings, partnership announcements, and corporate news.
            </p>
          </div>
          <a href="/articles/news" class="inline-block mt-4 text-xs font-medium text-[#0070f3] dark:text-cyan-400">View Company News →</a>
        </div>

        <div class="bento-card-sharp spotlight-card p-6 flex flex-col justify-between">
          <div>
            <Badge variant="purple">Company Milestones</Badge>
            <h3 class="text-lg font-semibold text-neutral-900 dark:text-white mt-3">Achievements & Timeline</h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
              Our historical timeline documenting the launch of Taluq AI, community expansion, and customer milestones.
            </p>
          </div>
          <a href="/articles/achievements" class="inline-block mt-4 text-xs font-medium text-[#0070f3] dark:text-cyan-400">Explore Milestones →</a>
        </div>

        <div class="bento-card-sharp spotlight-card p-6 flex flex-col justify-between">
          <div>
            <Badge variant="amber">Leadership & Team</Badge>
            <h3 class="text-lg font-semibold text-neutral-900 dark:text-white mt-3">People & Culture</h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
              Meet the architects, engineers, designers, and community creators building Prometrion's digital platforms.
            </p>
          </div>
          <a href="/articles/people" class="inline-block mt-4 text-xs font-medium text-[#0070f3] dark:text-cyan-400">Meet The Team →</a>
        </div>

        <div class="bento-card-sharp spotlight-card p-6 flex flex-col justify-between md:col-span-2">
          <div>
            <Badge variant="neutral">Documentation</Badge>
            <h3 class="text-lg font-semibold text-neutral-900 dark:text-white mt-3">Technical Documentation & APIs</h3>
            <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">
              Comprehensive guides for integrating Prometrion CLI, deploying webstore themes, calling Taluq AI endpoints, and developing for the Coders Club.
            </p>
          </div>
          <a href="/articles/docs" class="inline-block mt-4 text-xs font-medium text-[#0070f3] dark:text-cyan-400">Open Documentation Hub →</a>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>
