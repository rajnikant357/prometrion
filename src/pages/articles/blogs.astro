---
// articles/blogs.astro - Prometrion Educational & Thought Leadership Blogs
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import { blogsData } from "../../data/blogsData";
---

<BaseLayout
  title="Blogs & Educational Essays — Prometrion"
  description="Educational and practical long-form articles on website selection, catalogues vs e-commerce, SEO & GEO AI search visibility, mobile app strategy, and digital presence."
>
  <!-- Header -->
  <div class="py-14 sm:py-20 border-b border-[#ebebeb] bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionEyebrow tag="ARTICLES / BLOGS">PRACTICAL KNOWLEDGE</SectionEyebrow>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717]">
        Educational & Strategic Essays
      </h1>
      <p class="mt-3 text-neutral-600 max-w-xl text-sm sm:text-base leading-relaxed">
        Curated long-form guides helping business owners, founders, and developers make sound architectural and digital investments.
      </p>

      <!-- Category Filter Tabs -->
      <div class="mt-8 flex flex-wrap gap-2 pt-4 border-t border-neutral-100">
        <a href="/articles" class="px-3 py-1 rounded-full text-xs font-medium bg-white text-neutral-600 border border-[#ebebeb] hover:border-neutral-400">← All Articles Hub</a>
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-neutral-900 text-white">All Blogs ({blogsData.length})</span>
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-white text-neutral-600 border border-[#ebebeb]">Web Architecture</span>
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-white text-neutral-600 border border-[#ebebeb]">SEO & GEO</span>
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-white text-neutral-600 border border-[#ebebeb]">Mobile Apps</span>
      </div>
    </div>
  </div>

  <!-- Blog List Grid -->
  <div class="py-16 bg-[#fafafa]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {blogsData.map((post) => (
        <Card variant="interactive" href={`/articles/blogs/${post.slug}`} class="flex flex-col md:flex-row md:items-center justify-between gap-6 p-7">
          <div class="space-y-2 max-w-2xl">
            <div class="flex items-center gap-2">
              <Badge variant="blue">{post.tags[0] || post.category}</Badge>
              <span class="text-xs font-mono text-neutral-400">{post.pubDate} • {post.readTime}</span>
            </div>
            
            <h2 class="text-xl font-semibold text-neutral-900 group-hover:text-[#0070f3] transition">
              {post.title}
            </h2>
            
            <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed line-clamp-2">
              {post.excerpt}
            </p>

            <div class="pt-2 text-xs font-mono text-neutral-500 flex items-center gap-2">
              <span>By <strong class="text-neutral-800 font-sans">{post.author.name}</strong></span>
              <span>•</span>
              <span class="text-neutral-400">{post.tags.slice(0, 2).map(t => `#${t}`).join(' ')}</span>
            </div>
          </div>

          <div class="shrink-0 pt-2 md:pt-0">
            <span class="text-xs font-medium text-[#0070f3] group-hover:underline flex items-center gap-1">
              Read Essay →
            </span>
          </div>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
