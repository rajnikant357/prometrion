---
// articles/blogs.astro - Prometrion Educational & Thought Leadership Blogs
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";
import { blogsData } from "../../data/blogsData";
---

<BaseLayout
  title="Blogs & Educational Essays — Prometrion"
  description="Educational and practical long-form articles on website selection, catalogues vs e-commerce, SEO & GEO AI search visibility, mobile app strategy, and digital presence."
>
  <!-- Compact Header -->
  <div class="py-6 sm:py-8 border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070707]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <SectionEyebrow tag="ARTICLES / BLOGS">PRACTICAL KNOWLEDGE</SectionEyebrow>
          <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white mt-1">
            Educational & Strategic Essays
          </h1>
          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-xl">
            Curated long-form guides helping business owners, founders, and developers make sound architectural decisions.
          </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a href="/articles" class="px-3 py-1.5 rounded-full text-xs font-medium bg-neutral-100 dark:bg-white/10 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-200 transition">
            ← All Articles
          </a>
          <a href="/articles/docs" class="px-3 py-1.5 rounded-full text-xs font-medium bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:opacity-90 transition">
            Documentation
          </a>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="mt-4 flex flex-wrap gap-2 pt-4 border-t border-neutral-100 dark:border-white/10">
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 shadow-sm">All Blogs ({blogsData.length})</span>
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-600 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10">Web Architecture</span>
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-600 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10">SEO & GEO</span>
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-white dark:bg-white/[0.06] text-neutral-600 dark:text-neutral-300 border border-[#ebebeb] dark:border-white/10">Mobile Apps</span>
      </div>
    </div>
  </div>

  <!-- Blog List Grid -->
  <div class="py-8 sm:py-12 bg-[#fafafa] dark:bg-black/50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {blogsData.map((post) => (
        <Card variant="interactive" href={`/articles/blogs/${post.slug}`} class="flex flex-col md:flex-row md:items-center justify-between gap-6 p-7">
          <div class="space-y-2 max-w-2xl">
            <div class="flex items-center gap-2">
              <Badge variant="blue">{post.tags[0] || post.category}</Badge>
              <span class="text-xs font-mono text-neutral-400">{post.pubDate} • {post.readTime}</span>
            </div>
            
            <h2 class="text-xl font-semibold text-neutral-900 group-hover:text-[#0070f3] transition">
              {post.title}
            </h2>
            
            <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed line-clamp-2">
              {post.excerpt}
            </p>

            <div class="pt-2 text-xs font-mono text-neutral-500 flex items-center gap-2">
              <span>By <strong class="text-neutral-800 font-sans">{post.author.name}</strong></span>
              <span>•</span>
              <span class="text-neutral-400">{post.tags.slice(0, 2).map(t => `#${t}`).join(' ')}</span>
            </div>
          </div>

          <div class="shrink-0 pt-2 md:pt-0">
            <span class="text-xs font-medium text-[#0070f3] group-hover:underline flex items-center gap-1">
              Read Essay →
            </span>
          </div>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
