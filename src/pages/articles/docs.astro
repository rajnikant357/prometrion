---
// articles/docs.astro - Master Prometrion Documentation & Skills Platform (Vercel 3-Column Split Layout)
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
import ArticlesSidebar from "../../components/ui/ArticlesSidebar.astro";
import OnThisPage from "../../components/ui/OnThisPage.astro";
import { docsList, docCategories, prometrionSkills } from "../../data/docsData";

const docsHeadings = [
  { id: "overview", text: "Platform Architecture & Quickstart" },
  { id: "services-spec", text: "Service Specs & Pricing Matrix" },
  { id: "skills-registry", text: "Prometrion Skills Registry" },
  { id: "future-docs", text: "Roadmap & Future Extensions" },
];
---

<BaseLayout
  title="Documentation & Skills — Prometrion Developer Hub"
  description="Official Prometrion technical documentation, service catalog specifications, engineering standards, Prometrion Skills registry, and contribution roadmap."
>
  <!-- Documentation Top Bar -->
  <div class="py-10 sm:py-14 border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070707]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionEyebrow tag="DEVELOPER KNOWLEDGE BASE">PROMETRION DOCS & SKILLS</SectionEyebrow>
      
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mt-2">
        <div>
          <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-white">
            Technical Documentation & Skills
          </h1>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400 max-w-2xl text-sm sm:text-base leading-relaxed">
            The canonical reference for platform architecture, service specifications, autonomous agent skills, and future developer extensions.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <Badge variant="emerald">✦ Active GA</Badge>
          <span class="text-xs font-mono text-neutral-400">Spec v2.4</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Vercel 3-Column Split Layout Container -->
  <div class="py-10 sm:py-14 bg-[#fafafa] dark:bg-black min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-8 lg:gap-12 items-start">
        
        <!-- Left Column: Navigation Sidebar -->
        <ArticlesSidebar activeSection="docs" />

        <!-- Center Column: Documentation Content Body -->
        <main class="flex-1 min-w-0 space-y-16">
      
      <!-- Section 1: Platform Overview & Guides -->
      <section id="overview" class="space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-neutral-200">
          <div>
            <SectionEyebrow tag="SECTION 01">FOUNDATIONAL GUIDES</SectionEyebrow>
            <h2 class="text-2xl font-semibold text-neutral-900">Platform Architecture & Quickstart</h2>
          </div>
          <span class="text-xs font-mono text-neutral-400">3 Core Docs</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {docsList.slice(0, 3).map((doc) => (
            <Card variant="default" class="p-6 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <Badge variant="blue">{doc.badge || doc.category}</Badge>
                </div>
                <h3 class="text-base font-semibold text-neutral-900">{doc.title}</h3>
                <p class="text-xs text-neutral-600 mt-2 leading-relaxed">{doc.desc}</p>
                
                <div class="mt-4 space-y-2 text-xs text-neutral-700 border-t border-neutral-100 pt-3">
                  {doc.content.slice(0, 2).map(p => (
                    <p class="text-[11px] text-neutral-600 leading-relaxed">{p}</p>
                  ))}
                </div>

                {doc.codeSnippet && (
                  <div class="mt-3 bg-[#171717] rounded-lg p-2.5 text-[10px] font-mono text-neutral-300 overflow-x-auto">
                    <code>{doc.codeSnippet}</code>
                  </div>
                )}
              </div>

              <div class="mt-6 pt-3 border-t border-neutral-100 flex items-center justify-between text-xs font-mono">
                <span class="text-neutral-400">{doc.tags.map(t => `#${t}`).join(' ')}</span>
                <span class="text-[#0070f3] font-medium font-sans">Verified Doc ✔</span>
              </div>
            </Card>
          ))}
        </div>
      </section>

      <!-- Section 2: Service Catalog Specs & Delivery Matrix -->
      <section id="services-spec" class="space-y-6">
        <div class="flex items-center justify-between pb-3 border-b border-neutral-200">
          <div>
            <SectionEyebrow tag="SECTION 02">SERVICE SPECIFICATIONS</SectionEyebrow>
            <h2 class="text-2xl font-semibold text-neutral-900">Canonical Pricing & Delivery Architecture</h2>
          </div>
          <a href="/services/catalog" class="text-xs font-medium text-[#0070f3] hover:underline">
            View Live Catalog →
          </a>
        </div>

        <div class="bg-white border border-[#ebebeb] rounded-[6px] p-6 sm:p-8 shadow-whisper space-y-6">
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed max-w-3xl">
            Prometrion enforces a strict commercial specification across all digital services. To ensure absolute transparency, pricing is structured in the central database (<code class="font-mono text-neutral-800 bg-neutral-100 px-1 py-0.5 rounded">src/data/servicesCatalog.ts</code>) and categorized into clear deliverables.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-mono">
            <div class="p-4 rounded-[6px] bg-[#fafafa] border border-neutral-200/60">
              <span class="text-neutral-400 block text-[10px]">RULE 01: PRICING SYNTAX</span>
              <strong class="text-neutral-900 block mt-1 text-sm font-sans">Starting From (₹+)</strong>
              <p class="text-neutral-500 font-sans text-[11px] mt-1">
                Prices with expandable custom options use "+" suffix (e.g. ₹5,000+).
              </p>
            </div>

            <div class="p-4 rounded-[6px] bg-[#fafafa] border border-neutral-200/60">
              <span class="text-neutral-400 block text-[10px]">RULE 02: HONEST SEO</span>
              <strong class="text-neutral-900 block mt-1 text-sm font-sans">Zero False Guarantees</strong>
              <p class="text-neutral-500 font-sans text-[11px] mt-1">
                Never guarantee #1 search rank; search algorithms and competitor actions fluctuate.
              </p>
            </div>

            <div class="p-4 rounded-[6px] bg-[#fafafa] border border-neutral-200/60">
              <span class="text-neutral-400 block text-[10px]">RULE 03: TURNAROUND SLA</span>
              <strong class="text-neutral-900 block mt-1 text-sm font-sans">Guaranteed Sprints</strong>
              <p class="text-neutral-500 font-sans text-[11px] mt-1">
                Starter (3–6 days), Standard (5–8 days), Growth (8–15 days), Advanced (15–45 days).
              </p>
            </div>

            <div class="p-4 rounded-[6px] bg-[#fafafa] border border-neutral-200/60">
              <span class="text-neutral-400 block text-[10px]">RULE 04: REVISION CYCLES</span>
              <strong class="text-neutral-900 block mt-1 text-sm font-sans">Structured Rounds</strong>
              <p class="text-neutral-500 font-sans text-[11px] mt-1">
                2 to 4 structured revision rounds with written sign-offs per stage.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Dedicated Prometrion Skills System & Registry -->
      <section id="skills-registry" class="space-y-6 pt-4">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-3 border-b border-neutral-200">
          <div>
            <SectionEyebrow tag="SECTION 03">PROMETRION SKILLS REGISTRY</SectionEyebrow>
            <h2 class="text-2xl sm:text-3xl font-semibold text-neutral-900">
              Prometrion Skills & Agent Capabilities
            </h2>
            <p class="text-xs sm:text-sm text-neutral-600 mt-1 max-w-2xl">
              Specialized execution capabilities used by our engineering team, Taluq AI autonomous agents, and Coders Club members. You can register and extend skills here.
            </p>
          </div>

          <div class="shrink-0">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              {prometrionSkills.length} Skills Registered
            </span>
          </div>
        </div>

        <!-- Skills Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {prometrionSkills.map((skill) => (
            <div class="bg-white border border-[#ebebeb] rounded-[6px] p-6 shadow-whisper hover:shadow-floating transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-xs font-bold text-[#0070f3]">{skill.id}</span>
                  <Badge variant={skill.status === 'Ready' ? 'emerald' : 'blue'}>
                    {skill.status}
                  </Badge>
                </div>

                <h3 class="text-lg font-semibold text-neutral-900 mt-1">{skill.name}</h3>
                <span class="text-[11px] font-mono text-neutral-400">{skill.category}</span>
                
                <p class="text-xs text-neutral-600 mt-3 leading-relaxed">
                  {skill.description}
                </p>

                <!-- Skill Parameters Table -->
                <div class="mt-4 pt-3 border-t border-neutral-100">
                  <span class="text-[10px] font-mono font-bold text-neutral-400 uppercase tracking-wider block mb-2">
                    INPUT PARAMETERS
                  </span>
                  <div class="space-y-1.5 font-mono text-[11px]">
                    {skill.parameters.map((param) => (
                      <div class="flex items-start justify-between gap-2 p-1.5 rounded bg-neutral-50 text-neutral-700">
                        <span class="font-semibold text-neutral-900">{param.name} <span class="text-[10px] text-neutral-400 font-normal">({param.type})</span></span>
                        <span class="text-right text-[10px] text-neutral-500 font-sans">{param.desc}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Code Example -->
                <div class="mt-4">
                  <span class="text-[10px] font-mono font-bold text-neutral-400 uppercase tracking-wider block mb-1">
                    EXECUTION EXAMPLE
                  </span>
                  <div class="bg-[#171717] rounded-lg p-3 text-neutral-200 font-mono text-[10.5px] overflow-x-auto">
                    <code>{skill.exampleUsage}</code>
                  </div>
                </div>
              </div>

              <div class="mt-6 pt-3 border-t border-neutral-100 flex items-center justify-between text-xs">
                <span class="text-neutral-400 font-mono text-[11px]">Category: {skill.category}</span>
                <span class="text-[#0070f3] font-medium">Ready for Execution →</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 4: Future Docs & Contribution Guide -->
      <section id="future-docs" class="space-y-6 pt-4">
        <div class="flex items-center justify-between pb-3 border-b border-neutral-200">
          <div>
            <SectionEyebrow tag="SECTION 04">ROADMAP & CONTRIBUTIONS</SectionEyebrow>
            <h2 class="text-2xl font-semibold text-neutral-900">How to Add Future Docs & Skills</h2>
          </div>
          <span class="text-xs font-mono text-neutral-400">Developer Extension</span>
        </div>

        <div class="bg-white border border-[#ebebeb] rounded-[6px] p-8 shadow-whisper space-y-6">
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed">
            The Prometrion documentation engine is built for seamless expansion. As our product ecosystem grows, you can register new skills, API references, and documentation articles with complete type safety.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
            <div class="p-5 rounded-[6px] border border-[#ebebeb] bg-[#fafafa] space-y-3">
              <span class="text-xs font-mono font-bold text-[#0070f3]">1. ADDING A PROMETRION SKILL</span>
              <p class="text-xs text-neutral-600 leading-relaxed">
                Open <code class="font-mono bg-neutral-200 px-1 py-0.5 rounded text-[11px]">src/data/docsData.ts</code> and add an object to the <code class="font-mono bg-neutral-200 px-1 py-0.5 rounded text-[11px]">prometrionSkills</code> array with <code class="font-mono text-[11px]">id, name, category, parameters, exampleUsage</code>.
              </p>
              <div class="bg-[#171717] rounded-[6px] p-3 text-[10.5px] font-mono text-emerald-400 overflow-x-auto">
                <code>prometrionSkills.push(&#123; id: 'skill-new', name: '...', ... &#125;)</code>
              </div>
            </div>

            <div class="p-5 rounded-[6px] border border-[#ebebeb] bg-[#fafafa] space-y-3">
              <span class="text-xs font-mono font-bold text-emerald-600">2. ADDING A DOCUMENTATION TOPIC</span>
              <p class="text-xs text-neutral-600 leading-relaxed">
                Open <code class="font-mono bg-neutral-200 px-1 py-0.5 rounded text-[11px]">src/data/docsData.ts</code> and append an entry to <code class="font-mono bg-neutral-200 px-1 py-0.5 rounded text-[11px]">docsList</code> with markdown content blocks, code snippets, and tags.
              </p>
              <div class="bg-[#171717] rounded-[6px] p-3 text-[10.5px] font-mono text-emerald-400 overflow-x-auto">
                <code>docsList.push(&#123; slug: 'new-doc', title: '...', ... &#125;)</code>
              </div>
            </div>
          </div>
        </div>
      </section>

        <!-- Global CLI Quickbox -->
        <div class="bg-[#171717] rounded-[6px] p-8 text-white shadow-floating flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <Badge variant="blue">PROMETRION CLI</Badge>
            <h3 class="text-xl font-semibold text-white mt-2">Access Documentation & Skills via Terminal</h3>
            <p class="text-xs text-neutral-400 mt-1">Run skills, query docs, and deploy edge workloads directly from your CLI.</p>
          </div>
          <div class="bg-black/60 border border-neutral-800 px-4 py-2.5 rounded-lg font-mono text-xs text-emerald-400 flex items-center gap-3">
            <span>npx @prometrion/cli docs --all</span>
            <span class="text-neutral-500">v2.4</span>
          </div>
        </div>

        </main>

        <!-- Right Column: "On this page" Mini UI with Dynamic Scrollspy -->
        <OnThisPage headings={docsHeadings} />

      </div>
    </div>
  </div>
</BaseLayout>
