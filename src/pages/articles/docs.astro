---
// articles/docs.astro - Master Prometrion Documentation & Skills Platform (Article Cards Layout with Sticky Sidebars)
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
import ArticlesSidebar from "../../components/ui/ArticlesSidebar.astro";
import OnThisPage from "../../components/ui/OnThisPage.astro";
import { docsList, docCategories, prometrionSkills } from "../../data/docsData";

const docsHeadings = [
  { id: "overview", text: "Architecture & Quickstart" },
  { id: "services-spec", text: "Service Specifications" },
  { id: "engineering-standards", text: "Engineering Standards" },
  { id: "skills-registry", text: "Prometrion Skills Registry" },
  { id: "future-docs", text: "Roadmap & Contributions" },
  { id: "cli-reference", text: "CLI Terminal Reference" },
];
---

<BaseLayout
  title="Documentation & Skills — Prometrion Developer Hub"
  description="Official Prometrion technical documentation, service catalog specifications, engineering standards, Prometrion Skills registry, and contribution roadmap."
>
  <!-- Streamlined Compact Top Bar (Hero removed, buttons utilized) -->
  <div class="py-6 sm:py-8 border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070707]">
    <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <SectionEyebrow tag="DEVELOPER KNOWLEDGE BASE">PROMETRION DOCS & SKILLS</SectionEyebrow>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white mt-1">
          Technical Documentation & Skills
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-2xl">
          The canonical reference for platform architecture, service specifications, autonomous agent skills, and developer extensions.
        </p>
      </div>

      <!-- Action Buttons Utilized in Header -->
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <Badge variant="emerald">✦ Spec v2.4 GA</Badge>
        <Button variant="ghost-sm" href="/articles/blogs">Launch Blogs</Button>
        <Button variant="primary-sm" href="/contact">Ask an Architect</Button>
      </div>
    </div>
  </div>

  <!-- Optimized Split Layout Container: Sticky Left Menu + Article Cards Center + Sticky Right TOC -->
  <div class="py-8 sm:py-10 bg-[#fafafa] dark:bg-black min-h-screen">
    <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-6 lg:gap-8 xl:gap-10 items-start">
        
        <!-- Left Column: Sticky Navigation Sidebar -->
        <ArticlesSidebar activeSection="docs" />

        <!-- Center Column: Article Cards Layout -->
        <main class="flex-1 min-w-0 space-y-12">
          
          <!-- Article Section 1: Platform Architecture & Quickstart Cards -->
          <section id="overview" class="space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-neutral-200 dark:border-white/10">
              <div>
                <SectionEyebrow tag="SECTION 01">FOUNDATIONAL GUIDES</SectionEyebrow>
                <h2 class="text-xl sm:text-2xl font-semibold text-neutral-900 dark:text-white">Platform Architecture & Quickstart</h2>
              </div>
              <span class="text-xs font-mono text-neutral-400">{docsList.slice(0, 3).length} Core Articles</span>
            </div>

            <!-- Article Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              {docsList.slice(0, 3).map((doc) => (
                <article class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[8px] p-6 shadow-whisper hover:shadow-floating hover:border-neutral-300 dark:hover:border-white/20 transition-all flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between mb-3">
                      <Badge variant="blue">{doc.badge || doc.category}</Badge>
                      <span class="text-[10px] font-mono text-neutral-400">DOC-01</span>
                    </div>

                    <h3 class="text-base font-semibold text-neutral-900 dark:text-white">{doc.title}</h3>
                    <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-2 leading-relaxed">{doc.desc}</p>
                    
                    <div class="mt-4 space-y-2 text-xs text-neutral-700 dark:text-neutral-300 border-t border-neutral-100 dark:border-white/10 pt-3">
                      {doc.content.slice(0, 2).map(p => (
                        <p class="text-[11px] text-neutral-600 dark:text-neutral-400 leading-relaxed">{p}</p>
                      ))}
                    </div>

                    {doc.codeSnippet && (
                      <div class="mt-3 bg-[#171717] rounded-lg p-2.5 text-[10px] font-mono text-neutral-300 overflow-x-auto">
                        <code>{doc.codeSnippet}</code>
                      </div>
                    )}
                  </div>

                  <div class="mt-5 pt-3 border-t border-neutral-100 dark:border-white/10 flex items-center justify-between text-xs font-mono">
                    <span class="text-neutral-400">{doc.tags.map(t => `#${t}`).join(' ')}</span>
                    <span class="text-[#0070f3] dark:text-cyan-400 font-medium font-sans">Verified Doc ✔</span>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- Article Section 2: Service Catalog Specs Article Card -->
          <section id="services-spec" class="space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-neutral-200 dark:border-white/10">
              <div>
                <SectionEyebrow tag="SECTION 02">COMMERCIAL STANDARDS</SectionEyebrow>
                <h2 class="text-xl sm:text-2xl font-semibold text-neutral-900 dark:text-white">Canonical Pricing & Delivery Architecture</h2>
              </div>
              <a href="/services/catalog" class="text-xs font-medium text-[#0070f3] dark:text-cyan-400 hover:underline">
                View Live Catalog (30+ Solutions) →
              </a>
            </div>

            <!-- Single Comprehensive Article Card with 4 Rules -->
            <article class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[8px] p-6 sm:p-8 shadow-whisper space-y-6">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-neutral-100 dark:border-white/10">
                <div>
                  <div class="flex items-center gap-2">
                    <Badge variant="emerald">Commercial Integrity</Badge>
                    <span class="text-xs font-mono text-neutral-400">Standard Spec</span>
                  </div>
                  <h3 class="text-lg font-semibold text-neutral-900 dark:text-white mt-1">
                    Database-Driven Scope & Milestone Contracts
                  </h3>
                </div>
                <Button variant="ghost-sm" href="/pricing">View Pricing Matrix</Button>
              </div>

              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-4xl">
                Prometrion enforces a strict commercial specification across all digital services. To ensure absolute transparency, pricing is structured in the central database (<code class="font-mono text-neutral-800 dark:text-neutral-200 bg-neutral-100 dark:bg-white/10 px-1 py-0.5 rounded">src/data/servicesCatalog.ts</code>) and categorized into clear deliverables.
              </p>

              <!-- 4 Rule Mini Cards -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs font-mono">
                <div class="p-4 rounded-[6px] bg-[#fafafa] dark:bg-white/[0.03] border border-neutral-200/60 dark:border-white/10">
                  <span class="text-neutral-400 block text-[10px]">RULE 01: PRICING SYNTAX</span>
                  <strong class="text-neutral-900 dark:text-white block mt-1 text-sm font-sans">Starting From (₹+)</strong>
                  <p class="text-neutral-500 dark:text-neutral-400 font-sans text-[11px] mt-1">
                    Prices with expandable custom options use "+" suffix (e.g. ₹5,000+).
                  </p>
                </div>

                <div class="p-4 rounded-[6px] bg-[#fafafa] dark:bg-white/[0.03] border border-neutral-200/60 dark:border-white/10">
                  <span class="text-neutral-400 block text-[10px]">RULE 02: HONEST SEO</span>
                  <strong class="text-neutral-900 dark:text-white block mt-1 text-sm font-sans">Zero False Guarantees</strong>
                  <p class="text-neutral-500 dark:text-neutral-400 font-sans text-[11px] mt-1">
                    Never guarantee #1 search rank; search algorithms and competitor actions fluctuate.
                  </p>
                </div>

                <div class="p-4 rounded-[6px] bg-[#fafafa] dark:bg-white/[0.03] border border-neutral-200/60 dark:border-white/10">
                  <span class="text-neutral-400 block text-[10px]">RULE 03: TURNAROUND SLA</span>
                  <strong class="text-neutral-900 dark:text-white block mt-1 text-sm font-sans">Guaranteed Sprints</strong>
                  <p class="text-neutral-500 dark:text-neutral-400 font-sans text-[11px] mt-1">
                    Starter (3–6 days), Standard (5–8 days), Growth (8–15 days), Advanced (15–45 days).
                  </p>
                </div>

                <div class="p-4 rounded-[6px] bg-[#fafafa] dark:bg-white/[0.03] border border-neutral-200/60 dark:border-white/10">
                  <span class="text-neutral-400 block text-[10px]">RULE 04: REVISION CYCLES</span>
                  <strong class="text-neutral-900 dark:text-white block mt-1 text-sm font-sans">Structured Rounds</strong>
                  <p class="text-neutral-500 dark:text-neutral-400 font-sans text-[11px] mt-1">
                    2 to 4 structured revision rounds with written sign-offs per stage.
                  </p>
                </div>
              </div>
            </article>
          </section>

          <!-- Article Section 3: Engineering Standards & Design System -->
          <section id="engineering-standards" class="space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-neutral-200 dark:border-white/10">
              <div>
                <SectionEyebrow tag="SECTION 03">DESIGN TOKENS</SectionEyebrow>
                <h2 class="text-xl sm:text-2xl font-semibold text-neutral-900 dark:text-white">Engineering & Geist Design System</h2>
              </div>
              <span class="text-xs font-mono text-neutral-400">Astro 7 & Tailwind v4</span>
            </div>

            <article class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[8px] p-6 sm:p-8 shadow-whisper space-y-6">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
                <div class="space-y-4">
                  <Badge variant="purple">Design Tokens Specification</Badge>
                  <h3 class="text-lg font-semibold text-neutral-900 dark:text-white">
                    Subtractive Ink & Canvas Architecture
                  </h3>
                  <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
                    Our platform utilizes the Swiss-inspired Geist design language: high-contrast ink on off-white canvas with 1px hairlines. Marketing calls-to-action use 100px rounded pills, while nav chrome and app controls use tight 6px squares.
                  </p>
                  <ul class="space-y-2 text-xs text-neutral-700 dark:text-neutral-300">
                    <li class="flex items-center gap-2">
                      <span class="text-emerald-500 font-bold">✔</span>
                      <span><strong>0.00 CLS:</strong> Zero Cumulative Layout Shift across all responsive breakpoints.</span>
                    </li>
                    <li class="flex items-center gap-2">
                      <span class="text-emerald-500 font-bold">✔</span>
                      <span><strong>Sub-100ms TTFB:</strong> Distributed Anycast edge delivery via Cloudflare / Vercel.</span>
                    </li>
                    <li class="flex items-center gap-2">
                      <span class="text-emerald-500 font-bold">✔</span>
                      <span><strong>Native Dark Mode:</strong> Zero flash of unstyled theme with immediate inline bootloader.</span>
                    </li>
                  </ul>
                </div>

                <div class="bg-[#171717] rounded-lg p-4 font-mono text-xs text-neutral-300 overflow-x-auto shadow-inner">
                  <div class="flex items-center justify-between pb-2 mb-2 border-b border-neutral-800 text-[11px] text-neutral-400">
                    <span>DESIGN.md Token Registry</span>
                    <span class="text-emerald-400">Active Spec</span>
                  </div>
                  <pre class="text-[11px] leading-relaxed text-emerald-400"><code>@theme &#123;
  --color-ink: #171717;
  --color-canvas: #fafafa;
  --color-hairline: #ebebeb;
  --color-blue-accent: #0070f3;
  --font-sans: 'Geist', sans-serif;
  --font-mono: 'Geist Mono', monospace;
  --radius-pill: 100px;
  --radius-chrome: 6px;
&#125;</code></pre>
                </div>
              </div>
            </article>
          </section>

          <!-- Article Section 4: Dedicated Prometrion Skills System & Registry -->
          <section id="skills-registry" class="space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-3 border-b border-neutral-200 dark:border-white/10">
              <div>
                <SectionEyebrow tag="SECTION 04">PROMETRION SKILLS REGISTRY</SectionEyebrow>
                <h2 class="text-xl sm:text-2xl font-semibold text-neutral-900 dark:text-white">
                  Autonomous Agent Skills & Capabilities
                </h2>
                <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-2xl">
                  Specialized execution modules utilized by our engineering team, Taluq AI autonomous agents, and Coders Club members.
                </p>
              </div>

              <div class="shrink-0">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  {prometrionSkills.length} Skills Registered
                </span>
              </div>
            </div>

            <!-- Skills Article Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              {prometrionSkills.map((skill) => (
                <article class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[8px] p-6 shadow-whisper hover:shadow-floating hover:border-neutral-300 dark:hover:border-white/20 transition-all flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <span class="font-mono text-xs font-bold text-[#0070f3] dark:text-cyan-400">{skill.id}</span>
                      <Badge variant={skill.status === 'Ready' ? 'emerald' : 'blue'}>
                        {skill.status}
                      </Badge>
                    </div>

                    <h3 class="text-lg font-semibold text-neutral-900 dark:text-white mt-1">{skill.name}</h3>
                    <span class="text-[11px] font-mono text-neutral-400">{skill.category}</span>
                    
                    <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-3 leading-relaxed">
                      {skill.description}
                    </p>

                    <!-- Skill Parameters Table -->
                    <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-white/10">
                      <span class="text-[10px] font-mono font-bold text-neutral-400 uppercase tracking-wider block mb-2">
                        INPUT PARAMETERS
                      </span>
                      <div class="space-y-1.5 font-mono text-[11px]">
                        {skill.parameters.map((param) => (
                          <div class="flex items-start justify-between gap-2 p-1.5 rounded bg-neutral-50 dark:bg-white/[0.04] text-neutral-700 dark:text-neutral-300">
                            <span class="font-semibold text-neutral-900 dark:text-white">{param.name} <span class="text-[10px] text-neutral-400 font-normal">({param.type})</span></span>
                            <span class="text-right text-[10px] text-neutral-500 dark:text-neutral-400 font-sans">{param.desc}</span>
                          </div>
                        ))}
                      </div>
                    </div>

                    <!-- Code Example -->
                    <div class="mt-4">
                      <span class="text-[10px] font-mono font-bold text-neutral-400 uppercase tracking-wider block mb-1">
                        EXECUTION EXAMPLE
                      </span>
                      <div class="bg-[#171717] rounded-lg p-3 text-neutral-200 font-mono text-[10.5px] overflow-x-auto">
                        <code>{skill.exampleUsage}</code>
                      </div>
                    </div>
                  </div>

                  <div class="mt-6 pt-3 border-t border-neutral-100 dark:border-white/10 flex items-center justify-between text-xs">
                    <span class="text-neutral-400 font-mono text-[11px]">Category: {skill.category}</span>
                    <span class="text-[#0070f3] dark:text-cyan-400 font-medium">Ready for Execution →</span>
                  </div>
                </article>
              ))}
            </div>
          </section>

          <!-- Article Section 5: Future Docs & Contribution Guide Cards -->
          <section id="future-docs" class="space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-neutral-200 dark:border-white/10">
              <div>
                <SectionEyebrow tag="SECTION 05">ROADMAP & EXTENSIONS</SectionEyebrow>
                <h2 class="text-xl sm:text-2xl font-semibold text-neutral-900 dark:text-white">Extending Docs & Skills</h2>
              </div>
              <span class="text-xs font-mono text-neutral-400">Open Guild Architecture</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <article class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[8px] p-6 shadow-whisper space-y-3">
                <span class="text-xs font-mono font-bold text-[#0070f3] dark:text-cyan-400">1. ADDING A PROMETRION SKILL</span>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-white">Registering New Agent Skills</h3>
                <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
                  Open <code class="font-mono bg-neutral-100 dark:bg-white/10 px-1 py-0.5 rounded text-[11px]">src/data/docsData.ts</code> and append your skill object to <code class="font-mono bg-neutral-100 dark:bg-white/10 px-1 py-0.5 rounded text-[11px]">prometrionSkills</code> with parameter schemas and examples.
                </p>
                <div class="bg-[#171717] rounded-[6px] p-3 text-[10.5px] font-mono text-emerald-400 overflow-x-auto">
                  <code>prometrionSkills.push(&#123; id: 'custom-tool', ... &#125;)</code>
                </div>
              </article>

              <article class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[8px] p-6 shadow-whisper space-y-3">
                <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">2. ADDING A DOC ARTICLE</span>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-white">Contributing Technical Guides</h3>
                <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
                  Open <code class="font-mono bg-neutral-100 dark:bg-white/10 px-1 py-0.5 rounded text-[11px]">src/data/docsData.ts</code> and append an entry to <code class="font-mono bg-neutral-100 dark:bg-white/10 px-1 py-0.5 rounded text-[11px]">docsList</code> with markdown content blocks, code snippets, and tags.
                </p>
                <div class="bg-[#171717] rounded-[6px] p-3 text-[10.5px] font-mono text-emerald-400 overflow-x-auto">
                  <code>docsList.push(&#123; slug: 'new-doc', title: '...', ... &#125;)</code>
                </div>
              </article>
            </div>
          </section>

          <!-- Section 6: CLI Quickbox Reference -->
          <section id="cli-reference" class="pt-2">
            <div class="bg-[#171717] rounded-[8px] p-7 sm:p-8 text-white shadow-floating flex flex-col md:flex-row items-start md:items-center justify-between gap-6 border border-neutral-800">
              <div>
                <Badge variant="blue">PROMETRION CLI</Badge>
                <h3 class="text-xl font-semibold text-white mt-2">Access Documentation & Skills via Terminal</h3>
                <p class="text-xs text-neutral-400 mt-1 max-w-xl">Run skills, query docs, invoke autonomous agents, and deploy edge workloads directly from your CLI.</p>
              </div>
              <div class="bg-black/70 border border-neutral-700 px-4 py-3 rounded-lg font-mono text-xs text-emerald-400 flex items-center gap-3 shrink-0">
                <span>npx @prometrion/cli docs --all</span>
                <span class="text-neutral-500">v2.4</span>
              </div>
            </div>
          </section>

        </main>

        <!-- Right Column: Sticky "On this page" TOC -->
        <OnThisPage headings={docsHeadings} />

      </div>
    </div>
  </div>
</BaseLayout>

