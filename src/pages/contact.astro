---
// contact.astro - Multi-Channel Contact Hub
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionEyebrow from "../components/ui/SectionEyebrow.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
---

<BaseLayout
  title="Contact Us — Prometrion Multi-Channel Desk"
  description="Connect with Prometrion: Contact Form, Direct Phone Call, WhatsApp Desk, and 24/7 AI Chatbot Assistant."
>
  <div class="py-6 sm:py-8 border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070708]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <SectionEyebrow tag="COMMUNICATION">CONTACT PROMETRION</SectionEyebrow>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white mt-1">
          Let's build something exceptional together.
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-xl">
          Call, WhatsApp on <strong class="text-neutral-900 dark:text-white font-mono">+91 7084202503</strong>, structured brief, or 24/7 AI guide.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <a href="https://wa.me/917084202503" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium bg-emerald-600 hover:bg-emerald-500 text-white transition shadow-sm">
          WhatsApp Desk →
        </a>
        <a href="tel:+917084202503" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-medium bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:opacity-90 transition shadow-sm">
          Call Directly
        </a>
      </div>
    </div>
  </div>

  <div class="py-8 sm:py-12 bg-[#fafafa] dark:bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- 4 Channels Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        
        <!-- Channel 1: Contact Form -->
        <Card variant="default" class="text-center p-6">
          <div class="w-10 h-10 rounded-full bg-blue-50 dark:bg-blue-950/60 text-[#0070f3] dark:text-cyan-400 flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-semibold text-sm text-neutral-900 dark:text-white">Structured Form</h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Submit detailed project briefs and scopes.</p>
          <a href="#contact-form" class="text-xs font-medium text-[#0070f3] dark:text-cyan-400 mt-3 inline-block hover:underline">
            Scroll to Form ↓
          </a>
        </Card>

        <!-- Channel 2: Call Button -->
        <Card variant="default" class="text-center p-6">
          <div class="w-10 h-10 rounded-full bg-neutral-100 dark:bg-white/10 text-neutral-900 dark:text-white flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <h3 class="font-semibold text-sm text-neutral-900 dark:text-white">Direct Phone Call</h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Speak directly with an engineering advisor.</p>
          <a href="tel:+917084202503" class="text-xs font-mono font-medium text-neutral-900 dark:text-white mt-3 inline-block bg-neutral-100 dark:bg-white/10 px-3 py-1 rounded hover:bg-neutral-200 dark:hover:bg-white/15 transition">
            +91 7084202503
          </a>
        </Card>

        <!-- Channel 3: WhatsApp Button -->
        <Card variant="default" class="text-center p-6">
          <div class="w-10 h-10 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5 fill-currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.301-.15-1.781-.879-2.057-.98-.276-.1-.477-.15-.678.15-.2.301-.777.98-.953 1.18-.176.2-.351.226-.652.076-.301-.15-1.27-.468-2.42-1.493-.894-.798-1.498-1.784-1.674-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.15-.176.2-.301.301-.501.1-.2.05-.376-.025-.526-.075-.15-.677-1.631-.928-2.234-.244-.587-.492-.507-.677-.517-.176-.01-.376-.01-.577-.01-.2 0-.526.075-.802.376-.276.301-1.053 1.029-1.053 2.509 0 1.48 1.078 2.909 1.229 3.109.15.2 2.122 3.241 5.141 4.545.718.31 1.279.495 1.716.634.721.23 1.378.197 1.897.12.578-.087 1.781-.727 2.032-1.43.251-.702.251-1.304.176-1.43-.076-.126-.276-.201-.577-.351z"/>
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.892.525 3.663 1.438 5.176L2 22l4.981-1.399C8.423 21.496 10.158 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.273c-1.628 0-3.14-.5-4.402-1.359l-.316-.214-2.955.83.844-2.88-.235-.333C4.017 14.992 3.5 13.541 3.5 12c0-4.687 3.813-8.5 8.5-8.5s8.5 3.813 8.5 8.5-3.813 8.5-8.5 8.5z"/>
            </svg>
          </div>
          <h3 class="font-semibold text-sm text-neutral-900 dark:text-white">WhatsApp Desk</h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Chat in real time with our team.</p>
          <a href="https://wa.me/917084202503" target="_blank" rel="noopener noreferrer" class="text-xs font-mono font-medium text-emerald-700 dark:text-emerald-400 mt-3 inline-flex items-center gap-1.5 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/50 px-3 py-1 rounded hover:bg-emerald-100 dark:hover:bg-emerald-900/40 transition">
            <span>+91 7084202503</span>
            <span>↗</span>
          </a>
        </Card>

        <!-- Channel 4: AI Chatbot -->
        <Card variant="default" class="text-center p-6">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-[#00dfd8] to-[#007cf0] text-white flex items-center justify-center mx-auto mb-3 font-bold text-xs">
            AI
          </div>
          <h3 class="font-semibold text-sm text-neutral-900 dark:text-white">Prometrion AI</h3>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">Instant estimates, specs & answers.</p>
          <button id="trigger-chat-page-btn" class="text-xs font-medium text-[#0070f3] dark:text-cyan-400 mt-3 inline-block bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/50 px-3 py-1 rounded hover:bg-blue-100 dark:hover:bg-blue-900/40 transition cursor-pointer">
            Launch Chatbot ✦
          </button>
        </Card>

      </div>

      <!-- Main Structured Form Section -->
      <div id="contact-form" class="max-w-2xl mx-auto bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-8 sm:p-10 shadow-floating">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-neutral-100 dark:border-white/10">
          <div>
            <h2 class="text-xl font-semibold text-neutral-900 dark:text-white">Submit a Project Enquiry</h2>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">Fill out your brief below — it instantly forwards to our WhatsApp desk.</p>
          </div>
          <div class="hidden sm:flex items-center gap-1.5 text-xs text-emerald-600 dark:text-emerald-400 font-mono bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/50 px-2.5 py-1 rounded-full">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            WhatsApp Active
          </div>
        </div>

        <form id="enquiry-form" class="space-y-4 text-xs text-neutral-800 dark:text-neutral-200">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-medium mb-1 text-neutral-700 dark:text-neutral-300">Your Full Name *</label>
              <input id="enquiry-name" type="text" required placeholder="Jane Doe" class="w-full px-3.5 py-2.5 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-white/15 rounded-lg focus:outline-none focus:border-neutral-900 dark:focus:border-cyan-400 text-neutral-900 dark:text-white placeholder:text-neutral-400" />
            </div>
            <div>
              <label class="block font-medium mb-1 text-neutral-700 dark:text-neutral-300">Email Address *</label>
              <input id="enquiry-email" type="email" required placeholder="jane@company.com" class="w-full px-3.5 py-2.5 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-white/15 rounded-lg focus:outline-none focus:border-neutral-900 dark:focus:border-cyan-400 text-neutral-900 dark:text-white placeholder:text-neutral-400" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-medium mb-1 text-neutral-700 dark:text-neutral-300">Phone Number / WhatsApp (Optional)</label>
              <input id="enquiry-phone" type="tel" placeholder="+91 70842 02503" class="w-full px-3.5 py-2.5 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-white/15 rounded-lg focus:outline-none focus:border-neutral-900 dark:focus:border-cyan-400 text-neutral-900 dark:text-white placeholder:text-neutral-400" />
            </div>
            <div>
              <label class="block font-medium mb-1 text-neutral-700 dark:text-neutral-300">Service or Package Interest *</label>
              <select id="service-select" class="w-full px-3.5 py-2.5 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-white/15 rounded-lg focus:outline-none focus:border-neutral-900 dark:focus:border-cyan-400 text-neutral-700 dark:text-neutral-200">
                <option value="general">Select Service or Package...</option>
                <option value="combo-starter">Starter Digital Package (₹7,500)</option>
                <option value="combo-business">Business Digital Package (₹15,000)</option>
                <option value="combo-growth">Digital Growth Package (₹25,000)</option>
                <option value="combo-complete">Complete Digital Package (₹40,000+)</option>
                <option value="website">Website Development (Portfolio, Corporate, Catalogue, E-Com)</option>
                <option value="app">Mobile Application (Android / Cross-Platform)</option>
                <option value="seo-geo">SEO & Generative Engine Optimization (GEO)</option>
                <option value="taluq-ai">Taluq AI & Autonomous Reasoning Agents</option>
                <option value="maintenance">Monthly Care & Ongoing Retainer</option>
                <option value="other">Bespoke Custom Statement of Work</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block font-medium mb-1 text-neutral-700 dark:text-neutral-300">Estimated Budget Range</label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1">
              <label class="flex items-center gap-1.5 p-2 rounded border border-[#ebebeb] dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] cursor-pointer text-[11px] text-neutral-800 dark:text-neutral-200">
                <input type="radio" name="budget" value="₹5K – ₹15K" checked />
                <span>₹5K – ₹15K</span>
              </label>
              <label class="flex items-center gap-1.5 p-2 rounded border border-[#ebebeb] dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] cursor-pointer text-[11px] text-neutral-800 dark:text-neutral-200">
                <input type="radio" name="budget" value="₹15K – ₹35K" />
                <span>₹15K – ₹35K</span>
              </label>
              <label class="flex items-center gap-1.5 p-2 rounded border border-[#ebebeb] dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] cursor-pointer text-[11px] text-neutral-800 dark:text-neutral-200">
                <input type="radio" name="budget" value="₹35K – ₹75K" />
                <span>₹35K – ₹75K</span>
              </label>
              <label class="flex items-center gap-1.5 p-2 rounded border border-[#ebebeb] dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] cursor-pointer text-[11px] text-neutral-800 dark:text-neutral-200">
                <input type="radio" name="budget" value="₹75K+ / Custom" />
                <span>₹75K+ / Custom</span>
              </label>
            </div>
          </div>

          <div>
            <label class="block font-medium mb-1 text-neutral-700 dark:text-neutral-300">Project Details & Requirements *</label>
            <textarea id="project-details" rows="4" required placeholder="Briefly describe your business, target launch timeline, and core requirements..." class="w-full px-3.5 py-2.5 bg-[#fafafa] dark:bg-[#141414] border border-[#ebebeb] dark:border-white/15 rounded-lg focus:outline-none focus:border-neutral-900 dark:focus:border-cyan-400 text-neutral-900 dark:text-white placeholder:text-neutral-400"></textarea>
          </div>

          <div class="pt-2">
            <button
              type="submit"
              id="submit-enquiry-btn"
              class="w-full py-3.5 px-6 bg-[#25D366] hover:bg-[#20bd5a] text-black font-semibold rounded-full transition-colors duration-200 flex items-center justify-center gap-2.5 cursor-pointer text-sm"
            >
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.301-.15-1.781-.879-2.057-.98-.276-.1-.477-.15-.678.15-.2.301-.777.98-.953 1.18-.176.2-.351.226-.652.076-.301-.15-1.27-.468-2.42-1.493-.894-.798-1.498-1.784-1.674-2.085-.176-.301-.019-.464.132-.614.136-.135.301-.351.451-.527.15-.176.2-.301.301-.501.1-.2.05-.376-.025-.526-.075-.15-.677-1.631-.928-2.234-.244-.587-.492-.507-.677-.517-.176-.01-.376-.01-.577-.01-.2 0-.526.075-.802.376-.276.301-1.053 1.029-1.053 2.509 0 1.48 1.078 2.909 1.229 3.109.15.2 2.122 3.241 5.141 4.545.718.31 1.279.495 1.716.634.721.23 1.378.197 1.897.12.578-.087 1.781-.727 2.032-1.43.251-.702.251-1.304.176-1.43-.076-.126-.276-.201-.577-.351z"/>
                <path d="M12 2C6.477 2 2 6.477 2 12c0 1.892.525 3.663 1.438 5.176L2 22l4.981-1.399C8.423 21.496 10.158 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.273c-1.628 0-3.14-.5-4.402-1.359l-.316-.214-2.955.83.844-2.88-.235-.333C4.017 14.992 3.5 13.541 3.5 12c0-4.687 3.813-8.5 8.5-8.5s8.5 3.813 8.5 8.5-3.813 8.5-8.5 8.5z"/>
              </svg>
              <span>Send Project Enquiry via WhatsApp →</span>
            </button>
          </div>

          <div id="form-success-msg" class="hidden p-4 bg-emerald-50 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 rounded-lg text-center leading-relaxed">
          </div>
        </form>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById("enquiry-form") as HTMLFormElement;
  const successMsg = document.getElementById("form-success-msg");
  const chatTrigger = document.getElementById("trigger-chat-page-btn");
  const serviceSelect = document.getElementById("service-select") as HTMLSelectElement;
  const projectDetails = document.getElementById("project-details") as HTMLTextAreaElement;

  // Auto-fill from URL params
  const urlParams = new URLSearchParams(window.location.search);
  const serviceParam = urlParams.get("service");
  const packageParam = urlParams.get("package");
  const tierParam = urlParams.get("tier");
  const planParam = urlParams.get("plan");

  if (packageParam && serviceSelect) {
    if (packageParam === "combo-starter") serviceSelect.value = "combo-starter";
    else if (packageParam === "combo-business") serviceSelect.value = "combo-business";
    else if (packageParam === "combo-growth") serviceSelect.value = "combo-growth";
    else if (packageParam === "combo-complete") serviceSelect.value = "combo-complete";
  } else if (serviceParam && projectDetails) {
    projectDetails.value = `I am inquiring about the "${serviceParam}" solution from the catalog. Please share availability and delivery timeframe.`;
  } else if (tierParam && projectDetails) {
    projectDetails.value = `I am interested in initiating a ${tierParam.toUpperCase()} tier sprint for my business.`;
  } else if (planParam && projectDetails) {
    projectDetails.value = `I would like to subscribe to the "${planParam}" ongoing retainer.`;
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const nameInput = document.getElementById("enquiry-name") as HTMLInputElement;
    const emailInput = document.getElementById("enquiry-email") as HTMLInputElement;
    const phoneInput = document.getElementById("enquiry-phone") as HTMLInputElement;
    const name = nameInput?.value.trim() || "N/A";
    const email = emailInput?.value.trim() || "N/A";
    const phone = phoneInput?.value.trim() || "Not provided";
    const service = serviceSelect?.options[serviceSelect.selectedIndex]?.text || "General Enquiry";
    const selectedBudget = (document.querySelector('input[name="budget"]:checked') as HTMLInputElement)?.value || "N/A";
    const details = projectDetails?.value.trim() || "N/A";

    const whatsappMessage = `*New Project Enquiry — Prometrion*\n\n` +
      `👤 *Name:* ${name}\n` +
      `📧 *Email:* ${email}\n` +
      `📞 *Phone / WhatsApp:* ${phone}\n` +
      `💼 *Service:* ${service}\n` +
      `💰 *Budget Range:* ${selectedBudget}\n\n` +
      `📝 *Project Details:*\n${details}\n\n` +
      `— Sent via Prometrion.com Enquiry Portal`;

    const encodedMsg = encodeURIComponent(whatsappMessage);
    const whatsappUrl = `https://wa.me/917084202503?text=${encodedMsg}`;

    if (successMsg) {
      successMsg.classList.remove("hidden");
      successMsg.innerHTML = `
        <p class="font-semibold text-sm mb-1">✔ Opening WhatsApp chat with your project details...</p>
        <p class="text-xs text-emerald-700 dark:text-emerald-300">If WhatsApp doesn't open automatically, <a href="${whatsappUrl}" target="_blank" rel="noopener noreferrer" class="underline font-bold text-emerald-900 dark:text-emerald-100 hover:text-black">click here to chat on +91 7084202503 ↗</a></p>
      `;
    }

    // Open WhatsApp in new tab/window
    window.open(whatsappUrl, "_blank");
  });

  chatTrigger?.addEventListener("click", () => {
    const launcher = document.getElementById("chat-launcher-btn");
    launcher?.click();
  });
</script>
