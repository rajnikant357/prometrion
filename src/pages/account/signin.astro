---
// account/signin.astro - Prometrion Account Sign In
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
---

<BaseLayout
  title="Sign In — Prometrion Account"
  description="Prometrion Account Sign In is currently under active development. We are working for you to bring a secure, unified client authentication system."
>
  <div class="py-16 sm:py-24 bg-[#fafafa] dark:bg-black flex items-center justify-center min-h-[calc(100vh-280px)] relative overflow-hidden">
    <!-- Ambient mesh glow -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[550px] h-[350px] bg-gradient-to-tr from-cyan-500/10 via-blue-500/10 to-purple-500/10 dark:from-cyan-500/15 dark:via-blue-500/10 dark:to-purple-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <div class="w-full max-w-xl mx-auto px-4 relative z-10">
      
      <div class="bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[12px] p-8 sm:p-10 shadow-floating text-center">
        <!-- Prometrion Logo -->
        <div class="w-14 h-14 rounded-xl flex items-center justify-center mx-auto mb-5 p-2 bg-neutral-50 dark:bg-white/5 border border-neutral-200/80 dark:border-white/10 shadow-whisper">
          <img src="/prometrion-logo.png" alt="Prometrion" class="w-full h-full object-contain" width="48" height="48" />
        </div>

        <!-- Main Headline as requested -->
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-white">
          We are working for you.
        </h1>
        
        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-400 mt-3 max-w-md mx-auto leading-relaxed">
          Our unified client sign-in and authentication system is currently being built. We are engineering a high-security, seamless portal for all your Prometrion services.
        </p>

        <!-- What We Are Building for You Box -->
        <div class="mt-8 mb-6 p-5 rounded-xl bg-neutral-50 dark:bg-white/[0.03] border border-neutral-200/80 dark:border-white/10 text-left">
          <div class="flex items-center justify-between pb-3 border-b border-neutral-200/60 dark:border-white/10">
            <span class="text-[11px] font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold">What we are building for you</span>
            <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-medium">In Active Progress</span>
          </div>

          <ul class="mt-3 space-y-2.5 text-xs text-neutral-700 dark:text-neutral-300">
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-500 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Unified Client Portal:</strong> Live project roadmaps, delivery milestones, and invoice tracking.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-500 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Enterprise Security:</strong> Single Sign-On (SSO), OAuth, and encrypted session management.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-4 h-4 text-emerald-500 dark:text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Direct Engineer Access:</strong> Priority desk to collaborate directly with senior architects.</span>
            </li>
          </ul>
        </div>

        <!-- Early Access Notification Form -->
        <div class="mb-8 p-4 rounded-xl border border-dashed border-neutral-300 dark:border-white/15 bg-white dark:bg-black/40">
          <p class="text-xs font-medium text-neutral-800 dark:text-neutral-200 mb-2">
            Want to be notified when sign-in goes live?
          </p>
          <form id="notify-form-signin" class="flex flex-col sm:flex-row gap-2 max-w-md mx-auto">
            <input
              type="email"
              required
              id="notify-email-signin"
              placeholder="Enter your email address"
              class="flex-1 px-3.5 py-2 text-xs bg-neutral-50 dark:bg-white/5 border border-neutral-200 dark:border-white/10 rounded-lg text-neutral-900 dark:text-white placeholder:text-neutral-400 focus:outline-none focus:border-[#0070f3] dark:focus:border-cyan-400 transition"
            />
            <button
              type="submit"
              class="px-4 py-2 text-xs font-medium text-white bg-[#171717] hover:bg-neutral-800 dark:bg-white dark:text-black dark:hover:bg-neutral-200 rounded-lg transition shadow-xs cursor-pointer whitespace-nowrap"
            >
              Notify Me
            </button>
          </form>
          <div id="notify-success-signin" class="hidden text-xs text-emerald-600 dark:text-emerald-400 font-medium mt-2 flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span>Thank you! We will notify you the moment the portal is ready.</span>
          </div>
        </div>

        <!-- Quick Help & Actions -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-3">
          <Button variant="primary" href="/contact">
            Talk to Our Team
          </Button>
          <Button variant="secondary" href="/services">
            Explore Services
          </Button>
        </div>

        <div class="mt-8 pt-6 border-t border-neutral-100 dark:border-white/10 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 dark:text-neutral-400 gap-2">
          <span>Need immediate assistance?</span>
          <a href="/contact" class="text-[#0070f3] dark:text-cyan-400 hover:underline font-medium">Contact Support & Sales →</a>
        </div>
      </div>

      <div class="text-center mt-6">
        <a href="/" class="text-xs text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200 font-medium inline-flex items-center gap-1 transition">
          ← Back to Homepage
        </a>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById("notify-form-signin") as HTMLFormElement | null;
  const success = document.getElementById("notify-success-signin");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (form && success) {
      form.classList.add("hidden");
      success.classList.remove("hidden");
    }
  });
</script>
