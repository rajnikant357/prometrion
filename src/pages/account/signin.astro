---
// account/signin.astro - Prometrion Account Sign In
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Button from "../../components/ui/Button.astro";
---

<BaseLayout
  title="Sign In — Prometrion Account"
  description="Log in to your Prometrion Account to access your dashboard, ratings, developer profile, and purchases."
>
  <div class="py-16 sm:py-24 bg-[#fafafa] flex items-center justify-center min-h-[calc(100vh-280px)]">
    <div class="w-full max-w-md mx-auto px-4">
      
      <div class="bg-white border border-[#ebebeb] rounded-[6px] p-8 shadow-floating">
        <div class="text-center mb-6">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mx-auto mb-3 overflow-hidden">
            <img src="/prometrion-logo.png" alt="Prometrion" class="w-full h-full object-contain" width="48" height="48" />
          </div>
          <h1 class="text-xl font-semibold text-neutral-900">Sign in to Prometrion</h1>
          <p class="text-xs text-neutral-500 mt-1">One passport for products, store, and community.</p>
        </div>

        <!-- Social / OAuth Quick Sign In -->
        <div class="space-y-2 mb-6">
          <button class="w-full py-2.5 px-4 rounded-lg border border-[#ebebeb] bg-neutral-50 hover:bg-neutral-100 text-xs font-medium text-neutral-800 flex items-center justify-center gap-2 transition cursor-pointer">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>Continue with GitHub</span>
          </button>
          <button class="w-full py-2.5 px-4 rounded-lg border border-[#ebebeb] bg-neutral-50 hover:bg-neutral-100 text-xs font-medium text-neutral-800 flex items-center justify-center gap-2 transition cursor-pointer">
            <svg class="w-4 h-4" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Continue with Google</span>
          </button>
        </div>

        <div class="relative flex items-center justify-center mb-6">
          <div class="border-t border-neutral-200 w-full"></div>
          <span class="bg-white px-2 text-[10px] uppercase font-mono text-neutral-400 absolute">or email</span>
        </div>

        <!-- Email Form -->
        <form class="space-y-4 text-xs">
          <div>
            <label class="block font-medium text-neutral-800 mb-1">Email Address</label>
            <input type="email" required placeholder="you@company.com" class="w-full px-3.5 py-2.5 bg-[#fafafa] border border-[#ebebeb] rounded-lg focus:outline-none focus:border-neutral-900" />
          </div>
          <div>
            <div class="flex justify-between items-center mb-1">
              <label class="font-medium text-neutral-800">Password</label>
              <a href="#" class="text-[11px] text-[#0070f3] hover:underline">Forgot?</a>
            </div>
            <input type="password" required placeholder="••••••••" class="w-full px-3.5 py-2.5 bg-[#fafafa] border border-[#ebebeb] rounded-lg focus:outline-none focus:border-neutral-900" />
          </div>

          <div class="pt-2">
            <a href="/account/dashboard" class="block w-full text-center py-2.5 bg-[#171717] hover:bg-neutral-800 text-white font-medium rounded-lg transition shadow-sm">
              Sign In →
            </a>
          </div>
        </form>

        <p class="text-xs text-neutral-500 text-center mt-6">
          Don't have an account? <a href="/account/signup" class="text-[#0070f3] font-medium hover:underline">Sign up free</a>
        </p>
      </div>

    </div>
  </div>
</BaseLayout>
