---
// account/signup.astro - Prometrion Account Registration
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
---

<BaseLayout
  title="Create Account — Prometrion"
  description="Create your free Prometrion Account to participate in the community, rate services, access developer tools, and manage orders."
>
  <div class="py-16 sm:py-24 bg-[#fafafa] flex items-center justify-center min-h-[calc(100vh-280px)]">
    <div class="w-full max-w-md mx-auto px-4">
      
      <div class="bg-white border border-[#ebebeb] rounded-[6px] p-8 shadow-floating">
        <div class="text-center mb-6">
          <div class="w-12 h-12 rounded-lg flex items-center justify-center mx-auto mb-3 overflow-hidden">
            <img src="/prometrion-logo.png" alt="Prometrion" class="w-full h-full object-contain" width="48" height="48" />
          </div>
          <h1 class="text-xl font-semibold text-neutral-900">Create your Prometrion Account</h1>
          <p class="text-xs text-neutral-500 mt-1">Join the network of developers, creators, and partners.</p>
        </div>

        <form class="space-y-4 text-xs">
          <div>
            <label class="block font-medium text-neutral-800 mb-1">Full Name</label>
            <input type="text" required placeholder="Alex Rivera" class="w-full px-3.5 py-2.5 bg-[#fafafa] border border-[#ebebeb] rounded-lg focus:outline-none focus:border-neutral-900" />
          </div>
          <div>
            <label class="block font-medium text-neutral-800 mb-1">Email Address</label>
            <input type="email" required placeholder="alex@company.com" class="w-full px-3.5 py-2.5 bg-[#fafafa] border border-[#ebebeb] rounded-lg focus:outline-none focus:border-neutral-900" />
          </div>
          <div>
            <label class="block font-medium text-neutral-800 mb-1">Desired Username</label>
            <div class="flex items-center">
              <span class="px-3 py-2.5 bg-neutral-100 border border-r-0 border-[#ebebeb] rounded-l-lg text-neutral-400 font-mono">@</span>
              <input type="text" required placeholder="alexrivera" class="w-full px-3.5 py-2.5 bg-[#fafafa] border border-[#ebebeb] rounded-r-lg focus:outline-none focus:border-neutral-900 font-mono" />
            </div>
          </div>
          <div>
            <label class="block font-medium text-neutral-800 mb-1">Password</label>
            <input type="password" required placeholder="At least 8 characters" class="w-full px-3.5 py-2.5 bg-[#fafafa] border border-[#ebebeb] rounded-lg focus:outline-none focus:border-neutral-900" />
          </div>

          <div class="pt-2">
            <a href="/account/dashboard" class="block w-full text-center py-2.5 bg-[#171717] hover:bg-neutral-800 text-white font-medium rounded-lg transition shadow-sm">
              Create Account →
            </a>
          </div>
        </form>

        <p class="text-xs text-neutral-500 text-center mt-6">
          Already have an account? <a href="/account/signin" class="text-[#0070f3] font-medium hover:underline">Sign in</a>
        </p>
      </div>

    </div>
  </div>
</BaseLayout>
