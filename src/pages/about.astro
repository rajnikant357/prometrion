        </div>

        <!-- ==========================================
             WIKIPEDIA x PROMETRION FLOATING INFOBOX (VCARD)
             ========================================== -->
        <aside class="w-full sm:w-[320px] md:w-[350px] sm:float-right sm:ml-8 mb-6 bg-neutral-50/90 dark:bg-[#121216] border border-neutral-200 dark:border-white/10 rounded-lg p-4 text-xs leading-normal shadow-whisper hover:shadow-floating transition-all duration-300 font-sans">
            
            <!-- Infobox Top Banner -->
            <div class="bg-neutral-100 dark:bg-white/[0.05] py-2 px-3 text-center font-bold text-sm text-neutral-900 dark:text-white border-b border-neutral-200 dark:border-white/10 rounded-t tracking-tight">
              Rajnikant Gaurav
            </div>

            <!-- Image 1: Authentic Photo of Rajnikant Gaurav -->
            <div class="p-2.5 bg-white dark:bg-[#09090c] border border-neutral-200 dark:border-white/10 rounded my-3 text-center group">
              <div class="w-full aspect-[4/5] rounded overflow-hidden bg-neutral-900 relative shadow-md">
                <img
                  src="/rajnikant.png"
                  alt="Rajnikant Gaurav — Founder & CEO of Prometrion"
                  class="w-full h-full object-cover object-top transition duration-500 group-hover:scale-105"
                  loading="eager"
                />
                <!-- Subtle Gradient Vignette at bottom of portrait -->
                <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                <div class="absolute bottom-2 left-2 right-2 text-center text-white text-[11px] font-mono">
                  <span class="px-2 py-0.5 rounded bg-black/60 backdrop-blur-xs border border-white/20">
                    Rajnikant Gaurav (2025)
                  </span>
                </div>
              </div>
              
              <div class="text-[11px] text-neutral-600 dark:text-neutral-400 italic pt-2 mt-1">
                Rajnikant Gaurav in formal attire<br />
                <span class="font-normal not-italic text-[10px] text-neutral-500 dark:text-neutral-400">Formal portrait (2025)</span>
              </div>
            </div>

            <!-- Image 2: Workspace & Coffee Card -->
            <div class="p-2.5 bg-white dark:bg-[#09090c] border border-neutral-200 dark:border-white/10 rounded mb-3 text-center">
              <div class="p-2.5 rounded bg-neutral-100 dark:bg-white/[0.03] font-mono text-[11px] text-neutral-700 dark:text-neutral-300 flex items-center justify-center gap-2 border border-neutral-200/80 dark:border-white/5">
                <span>💻 Code</span>
                <span class="text-neutral-400">•</span>
                <span>☕ Coffee</span>
                <span class="text-neutral-400">•</span>
                <span>🚀 Build</span>
              </div>
              <div class="text-[11px] text-neutral-600 dark:text-neutral-400 pt-1.5 font-sans">
                Rajnikant Gaurav working with coffee<br />
                <span class="font-semibold text-neutral-900 dark:text-white">Built with 💻 & ☕</span>
              </div>
            </div>

            <!-- Subheader Banner -->
            <div class="bg-neutral-100 dark:bg-white/[0.05] py-1.5 px-3 text-center font-semibold text-xs text-neutral-800 dark:text-neutral-200 border-y border-neutral-200 dark:border-white/10">
              Founder of Prometrion
            </div>

            <!-- Key-Value Metadata Table -->
            <table class="w-full text-left border-collapse my-2">
              <tbody>
                <tr class="border-b border-neutral-200/70 dark:border-white/5">
                  <th scope="row" class="py-2 pr-2 font-bold text-neutral-700 dark:text-neutral-300 w-28 align-top">
                    Born
                  </th>
                  <td class="py-2 text-neutral-800 dark:text-neutral-200 align-top">
                    20 September 2005 (age 20)<br />
                    <span class="text-neutral-500 dark:text-neutral-400">Dadar, Ballia, Uttar Pradesh, India</span>
                  </td>
                </tr>

                <tr class="border-b border-neutral-200/70 dark:border-white/5">
                  <th scope="row" class="py-2 pr-2 font-bold text-neutral-700 dark:text-neutral-300 align-top">
