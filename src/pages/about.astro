            </span>
            <button id="view-source-tab" class="px-3 py-2 text-neutral-500 dark:text-neutral-400 hover:text-cyan-500 dark:hover:text-cyan-300 cursor-pointer transition">
              View source
            </button>
            <button id="view-history-tab" class="px-3 py-2 text-neutral-500 dark:text-neutral-400 hover:text-cyan-500 dark:hover:text-cyan-300 cursor-pointer transition">
              View history
            </button>
