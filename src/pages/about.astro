---
// src/pages/about.astro - Encyclopedic Archive: Rajnikant Gaurav & Prometrion Platform
// A synthesis of Wikipedia's authoritative encyclopedic structure and Prometrion's luminous dark-first aesthetic.
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildBreadcrumbSchema } from "../utils/seo";

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: "/" },
  { name: "About", url: "/about" },
  { name: "Rajnikant Gaurav", url: "/about#article" },
]);

// Encyclopedic Schema.org Graph combining Person, Organization, and Article
const encyclopedicSchema = {
  "@context": "https://schema.org",
  "@graph": [
    breadcrumbSchema,
    {
      "@type": "Person",
      "@id": "https://www.prometrion.com/about#rajnikant-gaurav",
      "name": "Rajnikant Gaurav",
      "image": "https://www.prometrion.com/rajnikant.png",
      "birthDate": "2005-09-20",
      "birthPlace": {
        "@type": "Place",
        "name": "Dadar, Ballia, Uttar Pradesh, India",
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "25.7583",
          "longitude": "84.1482"
        }
      },
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Bachelor of Technology in Computer Science and Engineering"
      },
      "jobTitle": "Founder & Chief Executive Officer",
      "worksFor": {
        "@type": "Organization",
        "@id": "https://www.prometrion.com/#organization",
        "name": "Prometrion"
      },
      "knowsAbout": [
        "Software Engineering",
        "Full-Stack Web Development",
        "Artificial Intelligence",
        "Autonomous Agent Systems",
        "Distributed Systems",
        "React",
        "Node.js",
        "Python",
        "PostgreSQL",
        "Tailwind CSS"
      ],
      "sameAs": [
        "https://www.rajnikantg.in",
        "https://www.prometrion.com"
      ]
    },
    {
      "@type": "Organization",
      "@id": "https://www.prometrion.com/#organization",
      "name": "Prometrion",
      "url": "https://www.prometrion.com",
      "foundingDate": "2025-11",
      "founder": {
        "@id": "https://www.prometrion.com/about#rajnikant-gaurav"
      },
      "description": "Software company and digital engineering platform established in November 2025 by Rajnikant Gaurav as an independent initiative, evolving into his ultimate flagship technology enterprise."
    },
    {
      "@type": "Article",
      "@id": "https://www.prometrion.com/about#article",
      "headline": "Rajnikant Gaurav — Encyclopedic Profile & Prometrion History",
      "description": "Biographical article documenting software engineer Rajnikant Gaurav and the history, architectural evolution, and software product ecosystem of Prometrion.",
      "image": "https://www.prometrion.com/rajnikant.png",
      "author": {
        "@type": "Organization",
        "name": "Prometrion Encyclopedia Desk"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Prometrion"
      },
      "datePublished": "2025-11-01",
      "dateModified": "2026-10-11"
    }
  ]
};
---

