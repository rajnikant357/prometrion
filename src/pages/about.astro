  <!-- Client-Side Scripts for Wikipedia Interactions -->
  <script is:inline>
    // View Source Modal Toggle
    const sourceModal = document.getElementById('wikitext-modal');
    const openSourceBtn1 = document.getElementById('view-source-trigger');
    const openSourceBtn2 = document.getElementById('view-source-tab');
    const closeSourceBtn1 = document.getElementById('close-source-modal');
    const closeSourceBtn2 = document.getElementById('close-modal-btn');

    function openModal() {
      if (sourceModal) sourceModal.classList.remove('hidden'), sourceModal.classList.add('flex');
    }
    function closeModal() {
      if (sourceModal) sourceModal.classList.add('hidden'), sourceModal.classList.remove('flex');
    }

    if (openSourceBtn1) openSourceBtn1.addEventListener('click', openModal);
    if (openSourceBtn2) openSourceBtn2.addEventListener('click', openModal);
    if (closeSourceBtn1) closeSourceBtn1.addEventListener('click', closeModal);
    if (closeSourceBtn2) closeSourceBtn2.addEventListener('click', closeModal);

    // Close on backdrop click
    if (sourceModal) {
      sourceModal.addEventListener('click', (e) => {
        if (e.target === sourceModal) closeModal();
      });
    }
  </script>
