        <div class="mb-6 p-4 bg-neutral-50/90 dark:bg-white/[0.02] border-l-3 border-cyan-400 dark:border-cyan-400 text-xs text-neutral-600 dark:text-neutral-300 italic rounded-r-lg shadow-whisper">
