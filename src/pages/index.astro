  <!-- Hero Depth Parallax Orchestrator -->
  <script>
    function setupHeroParallax() {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return;

      const globe = document.getElementById("hero-globe-scrolly");
      const mesh = document.getElementById("hero-mesh-scrolly");

      function updateParallax() {
        const scrollY = window.scrollY;
        if (scrollY < 1200) {
          if (globe) {
            globe.style.transform = `translateY(calc(45% + ${scrollY * 0.12}px)) scale(${1 + scrollY * 0.00015})`;
          }
          if (mesh) {
            mesh.style.transform = `translateY(${scrollY * 0.18}px)`;
            mesh.style.opacity = `${Math.max(0, 0.65 - scrollY * 0.0007)}`;
          }
        }
      }

      window.addEventListener("scroll", updateParallax, { passive: true });
      if ((window as any).lenis) {
        (window as any).lenis.on("scroll", updateParallax);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupHeroParallax);
    } else {
      setupHeroParallax();
    }
    document.addEventListener("astro:page-load", setupHeroParallax);
  </script>
