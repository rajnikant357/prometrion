---
// index.astro - Prometrion Homepage (Premium, Evidence-Backed Technology Platform)
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import SectionEyebrow from "../components/ui/SectionEyebrow.astro";
import Badge from "../components/ui/Badge.astro";
import WireframeGlobe from "../components/ui/WireframeGlobe.astro";
import TechStackMap from "../components/TechStackMap.astro";
import ClientPartnerships from "../components/ClientPartnerships.astro";
import CaseStudiesSection from "../components/CaseStudiesSection.astro";
import MaintenanceSupportSection from "../components/MaintenanceSupportSection.astro";
import TestimonialsTelemetrySection from "../components/TestimonialsTelemetrySection.astro";
import { webstoreProjects, type WebstoreProject } from "../data/webstoreProjects";
import { buildOrganizationSchema, buildWebSiteSchema, buildServiceSchema } from "../utils/seo";

// Curated selection of 6 verified production projects from centralized registry
const featuredSlugs = [
  "prometrion-ai",
  "sharpr",
  "locallink",
  "gazal-suit-ghar",
  "alankarini-mehandi-art",
  "ultron",
];

const featuredProjects = featuredSlugs
  .map((slug) => webstoreProjects.find((p) => p.slug === slug))
  .filter((p): p is WebstoreProject => Boolean(p));

function getCategoryBadgeVariant(category: string): 'neutral' | 'blue' | 'emerald' | 'amber' | 'purple' {
  switch (category) {
    case 'AI Applications':
      return 'purple';
    case 'Education':
      return 'blue';
    case 'SaaS and Web Applications':
      return 'emerald';
    case 'E-commerce and Retail':
      return 'amber';
    case 'Portfolios':
      return 'blue';
    case 'Games and Interactive Experiences':
      return 'purple';
    case 'Business Websites':
      return 'emerald';
    default:
      return 'neutral';
  }
}

// Master Schema.org Structured Graph for Homepage SEO & GEO
const homepageStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    buildOrganizationSchema(),
    buildWebSiteSchema(),
    buildServiceSchema({
      name: "Custom Website Development",
      description: "High-performance corporate platforms, SaaS web apps, and modern e-commerce architectures engineered with Astro 7, React 19, and Tailwind CSS v4 for sub-second LCP and high conversion.",
      serviceType: "Web Development",
      url: "/services/website-development",
    }),
    buildServiceSchema({
      name: "Native Android & Mobile Application Engineering",
      description: "Native Android applications and fluid mobile solutions built with Kotlin, Java, and Flutter with offline data sync and biometric security.",
      serviceType: "Mobile Application Development",
      url: "/services/app-development",
    }),
    buildServiceSchema({
      name: "Generative Engine Optimization (GEO) & Semantic SEO",
      description: "Traditional organic search combined with Generative Engine Optimization (GEO) ensuring discovery and entity citations across Google, ChatGPT, Perplexity, and Gemini.",
      serviceType: "Search Engine Optimization",
      url: "/services/seo-geo",
    }),
    buildServiceSchema({
      name: "Website & Application Maintenance and SLA Support",
      description: "Proactive uptime monitoring, automated database backups, security patching, and Core Web Vitals optimization backed by clear service level agreements.",
      serviceType: "Software Maintenance",
      url: "/services/maintenance-support",
    }),
    {
      '@type': 'ItemList',
      name: 'Featured Prometrion Software & Digital Projects',
      itemListElement: featuredProjects.map((p, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: p.name,
        description: p.shortDesc,
        url: p.url,
      })),
    },
  ],
};
---

<BaseLayout
  title="Prometrion — Technology & Digital Services Company"
  description="Prometrion is a technology and digital services company helping businesses build, launch, and grow through software development, digital solutions, and search visibility."
  jsonLd={homepageStructuredData}
>

  <!-- 1. Hero Section with Planet Horizon Blue & Green Glow Effect & 3D WebGL Wireframe Half-Globe Background -->
  <section class="relative overflow-hidden pt-24 pb-28 md:pt-32 md:pb-40 border-b border-[#ebebeb] dark:border-[#202020]">
    <!-- 3D WebGL Wireframe Half-Globe in Hero Background with Green + Blue Aurora Light Effect (60% Opacity) -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center justify-center overflow-hidden h-[540px] sm:h-[700px] lg:h-[840px] opacity-60 z-0">
      <div class="w-[900px] sm:w-[1200px] lg:w-[1500px] h-[900px] sm:h-[1200px] lg:h-[1500px] translate-y-[45%] relative transition-transform duration-200" id="hero-globe-scrolly">
        <WireframeGlobe background={true} aurora={true} size="full" />
      </div>
    </div>

    <!-- Planet Horizon Atmospheric Arc & Blue/Green Luminous Crest -->
    <div class="planet-horizon-wrapper">
      <div class="planet-horizon-glow"></div>
      <div class="planet-horizon-arc"></div>
    </div>

    <!-- Atmospheric Multi-Stop Mesh Glow -->
    <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center">
      <div class="w-[720px] sm:w-[960px] h-[480px] sm:h-[560px] mesh-gradient mesh-glow rounded-full transition-transform duration-200" id="hero-mesh-scrolly"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Main Headline with Tight Geist Tracking -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-white max-w-4xl mx-auto leading-[1.08]">
        Building technology that moves businesses forward.
      </h1>

      <!-- Approved Business Positioning Copy -->
      <p class="mt-6 text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
        Prometrion is a technology and digital services company helping businesses build, launch, and grow through software development, digital solutions, and search visibility.
      </p>

      <!-- Dual Marketing CTAs -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button variant="primary" href="/contact">
          Get a Quote
          <svg class="w-4 h-4 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </Button>
        <Button variant="glass" href="/services">
          Explore Services
        </Button>
      </div>

    </div>
  </section>

  <!-- Infinite Marquee Ticker: Engineering Signals -->
  <section class="py-10 bg-white dark:bg-[#070708] border-b border-[#ebebeb] dark:border-white/10 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 text-center">
      <p class="text-[11px] font-mono uppercase tracking-[0.25em] text-neutral-400 dark:text-neutral-500 font-semibold">
        ENGINEERED FOR HIGH PERFORMANCE & MODERN BUSINESS EXCELLENCE
      </p>
    </div>

    <!-- Dual Infinite Marquee Container with Gradient Mask -->
    <div class="space-y-4 marquee-mask pause-on-hover select-none">
      <!-- Track 1: Running Left -->
      <div class="animate-marquee flex items-center gap-6">
        <div class="flex items-center gap-6 shrink-0">
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            SUB-SECOND TARGET LCP ARCHITECTURE
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            NATIVE ANDROID RUNTIMES
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            GEO AI SEARCH VISIBILITY
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            ASTRO 7 ARCHITECTURE
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
            TAILWIND CSS V4
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            ZERO LAYOUT SHIFT (CLS 0)
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            100% CODE REPO OWNERSHIP
          </div>
        </div>
        <div class="flex items-center gap-6 shrink-0" aria-hidden="true">
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            SUB-SECOND TARGET LCP ARCHITECTURE
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            NATIVE ANDROID RUNTIMES
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            GEO AI SEARCH VISIBILITY
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            ASTRO 7 ARCHITECTURE
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
            TAILWIND CSS V4
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            ZERO LAYOUT SHIFT (CLS 0)
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            100% CODE REPO OWNERSHIP
          </div>
        </div>
      </div>

      <!-- Track 2: Running Right (Reverse) -->
      <div class="animate-marquee-reverse flex items-center gap-6">
        <div class="flex items-center gap-6 shrink-0">
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-emerald-500 font-bold">⚡</span> Optimized Edge CDN Delivery
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-cyan-400 font-bold">●</span> Defined Support Retainers
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-sky-400 font-bold">✦</span> Generative Engine Optimization
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-purple-400 font-bold">🔒</span> Enterprise Security Best Practices
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-emerald-400 font-bold">✓</span> Static & Edge Runtimes
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-blue-400 font-bold">🌐</span> Global Anycast Edge CDN
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-amber-400 font-bold">🚀</span> Transparent Milestone Delivery
          </div>
        </div>
        <div class="flex items-center gap-6 shrink-0" aria-hidden="true">
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-emerald-500 font-bold">⚡</span> Optimized Edge CDN Delivery
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-cyan-400 font-bold">●</span> Defined Support Retainers
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-sky-400 font-bold">✦</span> Generative Engine Optimization
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-purple-400 font-bold">🔒</span> Enterprise Security Best Practices
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-emerald-400 font-bold">✓</span> Static & Edge Runtimes
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-blue-400 font-bold">🌐</span> Global Anycast Edge CDN
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-amber-400 font-bold">🚀</span> Transparent Milestone Delivery
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================================================
       SECTION 1: FEATURED PROJECTS / REAL DIGITAL SOLUTIONS
       ================================================== -->
  <section id="featured-projects" class="relative py-20 sm:py-28 bg-[#fafafa] dark:bg-[#070707] border-b border-[#ebebeb] dark:border-white/10 overflow-hidden transition-colors">
    <!-- Atmospheric Ambient Glows -->
    <div class="absolute top-1/4 right-0 w-[500px] h-[500px] bg-sky-500/10 dark:bg-sky-500/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>
    <div class="absolute bottom-1/4 -left-20 w-[450px] h-[450px] bg-emerald-500/10 dark:bg-emerald-500/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-6">
        <div class="max-w-3xl">
          <SectionEyebrow tag="FEATURED SHOWCASE">PRODUCTION PORTFOLIO</SectionEyebrow>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-white leading-[1.12]">
            Digital Experiences. Real Solutions.
          </h2>
          <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            From AI-powered experiences and business websites to educational platforms, interactive applications, and digital commerce, Prometrion builds digital solutions around real-world needs.
          </p>
        </div>

        <div class="shrink-0">
          <Button variant="secondary" href="/store/webstore">
            Explore All Projects →
          </Button>
        </div>
      </div>

      <!-- 6-Project Balanced Grid: 3 cols Desktop, 2 cols Tablet, 1 col Mobile -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
        {featuredProjects.map((p) => (
          <article class="group flex flex-col justify-between bg-white dark:bg-[#0c0c0c] border border-[#ebebeb] dark:border-white/10 rounded-[6px] p-5 shadow-whisper hover:shadow-floating dark:hover:border-white/20 transition-all duration-200">
            <div>
              <!-- Website Screenshot Preview -->
              <a
                href={`/store/webstore/${p.slug}`}
                class="block aspect-[16/10] bg-neutral-100 dark:bg-neutral-900 rounded-[4px] mb-4 overflow-hidden border border-neutral-200/60 dark:border-white/10 relative group-hover:border-neutral-400 dark:group-hover:border-white/30 transition cursor-pointer"
                title={`View ${p.name} case details`}
              >
                {p.image ? (
                  <img
                    src={p.image}
                    alt={`Screenshot of ${p.name}`}
                    class="w-full h-full object-cover object-top transition duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center p-6 text-center bg-gradient-to-br from-neutral-900 to-black text-white">
                    <span class="text-xs font-semibold">{p.name}</span>
                    <span class="text-[10px] font-mono text-neutral-400 mt-1">{p.category}</span>
                  </div>
                )}
                
                <!-- Hover Overlay Pill -->
                <div class="absolute inset-0 bg-black/35 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center pointer-events-none">
                  <span class="px-3 py-1 bg-white/95 dark:bg-black/90 text-neutral-900 dark:text-white rounded-full text-[11px] font-medium shadow-md backdrop-blur-xs font-mono">
                    View Project Case ↗
                  </span>
                </div>
              </a>

              <!-- Header: Name & Category Badge -->
              <div class="flex items-center justify-between gap-2 flex-wrap mb-2">
                <h3 class="text-base sm:text-lg font-semibold tracking-tight text-[#171717] dark:text-white group-hover:text-[#0070f3] dark:group-hover:text-cyan-400 transition">
                  <a href={`/store/webstore/${p.slug}`} class="focus:outline-hidden">
                    {p.name}
                  </a>
                </h3>
                <Badge variant={getCategoryBadgeVariant(p.category)}>
                  {p.category}
                </Badge>
              </div>

              <!-- Concise Project Description -->
              <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
                {p.shortDesc}
              </p>

              <!-- Key Features Highlights (2–3 items) -->
              <div class="mt-4 space-y-1.5 text-[11px] text-neutral-700 dark:text-neutral-300 font-mono">
                {p.features.slice(0, 3).map((feat) => (
                  <div class="flex items-start gap-2">
                    <span class="text-emerald-500 font-bold shrink-0">✓</span>
                    <span class="truncate">{feat}</span>
                  </div>
                ))}
              </div>

              <!-- Verified Tech Stack -->
              <div class="mt-4 flex flex-wrap gap-1.5 pt-3 border-t border-neutral-100 dark:border-white/10">
                {p.stack.slice(0, 3).map((tech) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-white/[0.06] text-neutral-700 dark:text-neutral-300 border border-neutral-200/60 dark:border-white/10">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Functional Actions: Live Demo + View Details -->
            <div class="mt-5 pt-3 flex items-center justify-between gap-2 border-t border-neutral-100 dark:border-white/10">
              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold rounded-full bg-[#171717] text-white dark:bg-white dark:text-black hover:opacity-90 transition shadow-xs cursor-pointer"
              >
                <span>Live Demo</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
              <a
                href={`/store/webstore/${p.slug}`}
                class="inline-flex items-center gap-1 text-xs font-medium text-neutral-600 hover:text-black dark:text-neutral-400 dark:hover:text-white transition"
              >
                <span>View Details</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Bottom Explore Action Link -->
      <div class="mt-12 text-center">
        <a
          href="/store/webstore"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full text-xs font-medium border border-neutral-200 dark:border-white/15 bg-white dark:bg-white/[0.03] text-neutral-800 dark:text-neutral-200 hover:border-neutral-400 dark:hover:border-cyan-400/40 hover:bg-neutral-50 dark:hover:bg-white/[0.06] transition shadow-whisper"
        >
          <span>Explore All 17 Production Projects in Webstore</span>
          <span class="text-neutral-400">→</span>
        </a>
      </div>

    </div>
  </section>

  <!-- ==================================================
       SECTION 2: INTERACTIVE TECHNOLOGY STACK (Connected Grid & Architecture)
