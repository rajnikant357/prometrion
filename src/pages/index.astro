---
// index.astro - Prometrion Homepage
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import SectionEyebrow from "../components/ui/SectionEyebrow.astro";
import Badge from "../components/ui/Badge.astro";
import InteractiveWorkflowShowcase from "../components/ui/InteractiveWorkflowShowcase.astro";
import WireframeGlobe from "../components/ui/WireframeGlobe.astro";
---

<BaseLayout
  title="Prometrion — Building Technology for What's Next"
  description="Prometrion is a technology company creating software products, digital services, marketplaces, and developer ecosystems for people and businesses moving forward."
>

  <!-- Hero Section with Planet Horizon Blue & Green Glow Effect & 3D WebGL Wireframe Half-Globe Background -->
  <section class="relative overflow-hidden pt-24 pb-28 md:pt-32 md:pb-40 border-b border-[#ebebeb] dark:border-[#202020]">
    <!-- 3D WebGL Wireframe Half-Globe in Hero Background with Green + Blue Aurora Light Effect (60% Opacity) -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center justify-center overflow-hidden h-[540px] sm:h-[700px] lg:h-[840px] opacity-60 z-0">
      <div class="w-[900px] sm:w-[1200px] lg:w-[1500px] h-[900px] sm:h-[1200px] lg:h-[1500px] translate-y-[45%] relative">
        <WireframeGlobe background={true} aurora={true} size="full" />
      </div>
    </div>

    <!-- Planet Horizon Atmospheric Arc & Blue/Green Luminous Crest -->
    <div class="planet-horizon-wrapper">
      <div class="planet-horizon-glow"></div>
      <div class="planet-horizon-arc"></div>
    </div>

    <!-- Atmospheric Multi-Stop Mesh Glow -->
    <div class="absolute inset-0 pointer-events-none -z-10 flex items-center justify-center">
      <div class="w-[720px] sm:w-[960px] h-[480px] sm:h-[560px] mesh-gradient mesh-glow rounded-full"></div>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Main Headline with Tight Geist Tracking -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-semibold tracking-[-0.04em] text-[#171717] dark:text-white max-w-4xl mx-auto leading-[1.08]">
        Building technology for what's next.
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
        Prometrion is a technology company creating software products, digital services, marketplaces, and ecosystems for people, developers, and businesses moving forward.
      </p>

      <!-- Dual Marketing CTAs with Glassmorphic Secondary Button -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <Button variant="primary" href="/products">
          Explore Prometrion
          <svg class="w-4 h-4 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </Button>
        <Button variant="glass" href="/store">
          Browse Store & Marketplace
        </Button>
      </div>

    </div>
  </section>

  <!-- 3. Infinite Marquee Ticker: Partners & Ecosystem Signals -->
  <section class="py-10 bg-white dark:bg-[#070708] border-b border-[#ebebeb] dark:border-white/10 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 text-center">
      <p class="text-[11px] font-mono uppercase tracking-[0.25em] text-neutral-400 dark:text-neutral-500 font-semibold">
        TRUSTED BY AMBITIOUS TEAMS & INTEGRATED WITH NEXT-GEN PLATFORMS
      </p>
    </div>

    <!-- Dual Infinite Marquee Container with Gradient Mask -->
    <div class="space-y-4 marquee-mask pause-on-hover select-none">
      <!-- Track 1: Running Left -->
      <div class="animate-marquee flex items-center gap-6">
        <div class="flex items-center gap-6 shrink-0">
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            NEXTGEN LABS
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            TALUQ AI ENGINE
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            NEXUS CLOUD
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            ASTRO 5.0 CORE
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
            TAILWIND CSS V4
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            VELOX SYSTEMS
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            PULSE DIGITAL
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            QUANTUM RUNTIME
          </div>
        </div>
        <!-- Duplicate for Seamless Infinite Loop -->
        <div class="flex items-center gap-6 shrink-0" aria-hidden="true">
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            NEXTGEN LABS
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            TALUQ AI ENGINE
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            NEXUS CLOUD
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            ASTRO 5.0 CORE
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-sky-400"></span>
            TAILWIND CSS V4
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            VELOX SYSTEMS
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            PULSE DIGITAL
          </div>
          <div class="flex items-center gap-2.5 px-4 py-2 rounded-full border border-neutral-200 dark:border-white/10 bg-neutral-50 dark:bg-white/[0.03] text-xs font-mono font-semibold text-neutral-800 dark:text-neutral-200">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            QUANTUM RUNTIME
          </div>
        </div>
      </div>

      <!-- Track 2: Running Right (Reverse) -->
      <div class="animate-marquee-reverse flex items-center gap-6">
        <div class="flex items-center gap-6 shrink-0">
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-emerald-500 font-bold">⚡</span> Sub-15ms Edge Latency
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-cyan-400 font-bold">●</span> 99.99% Guaranteed SLA
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-sky-400 font-bold">✦</span> Multimodal Agent SDK
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-purple-400 font-bold">🔒</span> Hardware MicroVM Isolation
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-emerald-400 font-bold">✓</span> Zero Cold Start Guarantee
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-blue-400 font-bold">🌐</span> 300+ Anycast Global PoPs
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-amber-400 font-bold">🚀</span> SOC2 Type II Certified
          </div>
        </div>
        <!-- Duplicate for Seamless Infinite Loop -->
        <div class="flex items-center gap-6 shrink-0" aria-hidden="true">
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-emerald-500 font-bold">⚡</span> Sub-15ms Edge Latency
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-cyan-400 font-bold">●</span> 99.99% Guaranteed SLA
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-sky-400 font-bold">✦</span> Multimodal Agent SDK
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-purple-400 font-bold">🔒</span> Hardware MicroVM Isolation
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-emerald-400 font-bold">✓</span> Zero Cold Start Guarantee
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-blue-400 font-bold">🌐</span> 300+ Anycast Global PoPs
          </div>
          <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-lg border border-neutral-200/80 dark:border-white/5 bg-white dark:bg-white/[0.02] text-xs font-mono text-neutral-600 dark:text-neutral-400">
            <span class="text-amber-400 font-bold">🚀</span> SOC2 Type II Certified
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Workflow Architecture: Vertical Stepper + Scrollspy + Browser Mockup with Acme® UI -->
  <InteractiveWorkflowShowcase />

  <!-- 4. Products Spotlight: Sharp 3-Card Bento Grid -->
  <section class="py-24 bg-[#fafafa] dark:bg-black border-b border-[#ebebeb] dark:border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <SectionEyebrow tag="01. PRODUCTS">PROMETRION PRODUCTS</SectionEyebrow>
          <h2 class="text-3xl sm:text-4xl font-semibold tracking-[-0.03em] text-[#171717] dark:text-white">
            Proprietary technologies built for scale.
          </h2>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400 text-sm sm:text-base max-w-xl">
            Prometrion conceives, architects, and deploys high-impact technologies that power the modern digital economy.
          </p>
        </div>
        <div class="mt-4 md:mt-0">
          <Button variant="secondary" href="/products">
            View All Products →
          </Button>
        </div>
      </div>

      <!-- Sharp Bento Grid: Exactly 3 Cards (1 Large + 2 Aligned Small Cards) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        
        <!-- Large Card (7 cols): Taluq AI with Glowing Border Beam & Interactive Terminal -->
        <div class="lg:col-span-7 bento-card-sharp border-beam-container spotlight-card shadow-whisper hover:shadow-floating">
          <div class="border-beam-inner p-8 sm:p-10 flex flex-col justify-between h-full bg-dot-grid">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-2">
                  <Badge variant="emerald">✦ Flagship AI Platform</Badge>
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono bg-cyan-400/10 text-cyan-400 border border-cyan-400/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
                    v2.0 GA
                  </span>
                </div>
                <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">Live Telemetry</span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white">
                Taluq AI: Multi-Agent Reasoning Engine
              </h3>
              <p class="mt-3 text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed max-w-xl">
                An advanced autonomous intelligence platform engineered for agentic workflows, dynamic reasoning graphs, and multimodal execution. Taluq AI bridges generative software with high-concurrency enterprise business operations.
              </p>

              <!-- Live Interactive Edge Terminal Mockup -->
              <div class="mt-6 rounded-[6px] border border-neutral-200 dark:border-white/10 bg-neutral-900 dark:bg-black/80 p-4 font-mono text-xs text-neutral-300 shadow-inner">
                <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/10 text-[11px] text-neutral-400">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
                    <span class="ml-2 font-mono text-neutral-400">taluq-runtime@edge</span>
                  </div>
                  <span class="text-emerald-400">● ACTIVE CLUSTER</span>
                </div>
                <div class="space-y-1 text-neutral-300">
                  <p class="text-neutral-500">$ taluq deploy --agent=orchestrator-v2 --edge-mesh</p>
                  <p class="text-emerald-400">✓ Isolated microVM spawned [RAM: 128MB | Cold Start: 0ms]</p>
                  <p class="text-cyan-400">✓ Reasoning graph compiled: 14 tool bindings verified</p>
                  <p class="text-sky-300">✓ Edge Anycast propagation: 300+ PoPs synced in 11.4ms</p>
                </div>
              </div>

              <!-- 3 Core Telemetry Metrics -->
              <div class="mt-6 grid grid-cols-3 gap-4 pt-4 border-t border-neutral-100 dark:border-white/10 text-xs">
                <div>
                  <span class="block font-semibold text-neutral-900 dark:text-white text-base">Sub-15ms</span>
                  <span class="text-neutral-500 dark:text-neutral-400 text-[11px]">Edge Inference</span>
                </div>
                <div>
                  <span class="block font-semibold text-neutral-900 dark:text-white text-base">Zero</span>
                  <span class="text-neutral-500 dark:text-neutral-400 text-[11px]">Cold Start Runtimes</span>
                </div>
                <div>
                  <span class="block font-semibold text-neutral-900 dark:text-white text-base">99.99%</span>
                  <span class="text-neutral-500 dark:text-neutral-400 text-[11px]">Uptime SLA</span>
                </div>
              </div>
            </div>

            <div class="mt-8 pt-4 flex flex-wrap items-center gap-4">
              <Button variant="primary" href="/products/taluq-ai">
                Explore Taluq AI Platform →
              </Button>
              <a href="/articles/docs" class="text-xs font-semibold text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition flex items-center gap-1">
                Read Architecture Specs <span>→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 2 Aligned Small Cards (5 cols) Stacked Vertically -->
        <div class="lg:col-span-5 flex flex-col gap-6 justify-between">
          
          <!-- Small Card 1: Prometrion Cloud -->
          <div class="flex-1 bento-card-sharp spotlight-card p-7 flex flex-col justify-between shadow-whisper hover:shadow-floating">
            <div>
              <div class="flex items-center justify-between mb-3">
                <Badge variant="blue">Cloud Infrastructure</Badge>
                <span class="text-[11px] font-mono text-emerald-500 font-semibold">Active CPU</span>
              </div>
              <h4 class="text-xl font-semibold tracking-tight text-[#171717] dark:text-white">
                Prometrion Cloud
              </h4>
              <p class="mt-2 text-neutral-600 dark:text-neutral-400 text-xs leading-relaxed">
                Global serverless compute and microVM sandboxing designed for developers building high-concurrency, resilient cloud-native applications.
              </p>

              <div class="mt-5 space-y-2 text-xs text-neutral-600 dark:text-neutral-400 font-mono">
                <div class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✔</span> 300+ Anycast Edge Locations
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✔</span> Instant Rollback Sandboxing
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-emerald-500 font-bold">✔</span> Hardware-Enforced Isolation
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-neutral-100 dark:border-white/10">
              <a href="/products" class="text-xs font-semibold text-neutral-900 dark:text-cyan-400 hover:text-[#0070f3] dark:hover:text-cyan-300 transition flex items-center justify-between">
                <span>Learn about Cloud Runtimes</span>
                <span>→</span>
              </a>
            </div>
          </div>

          <!-- Small Card 2: Anycast Edge Mesh -->
          <div class="flex-1 bento-card-sharp spotlight-card p-7 flex flex-col justify-between shadow-whisper hover:shadow-floating">
            <div>
              <div class="flex items-center justify-between mb-3">
                <Badge variant="purple">Global Edge Mesh</Badge>
                <span class="text-[11px] font-mono text-cyan-400 font-semibold">&lt;1ms Routing</span>
              </div>
              <h4 class="text-xl font-semibold tracking-tight text-[#171717] dark:text-white">
                Anycast Edge Mesh
              </h4>
              <p class="mt-2 text-neutral-600 dark:text-neutral-400 text-xs leading-relaxed">
                Sub-millisecond data synchronization and edge cache fabric ensuring your users experience instant response times globally.
              </p>

              <div class="mt-5 space-y-2 text-xs text-neutral-600 dark:text-neutral-400 font-mono">
                <div class="flex items-center gap-2">
                  <span class="text-cyan-400 font-bold">⚡</span> Smart Edge BGP Ingress
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-cyan-400 font-bold">⚡</span> Zero-hop Static Asset Invalidation
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-cyan-400 font-bold">⚡</span> Global Multi-Region Replication
                </div>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-neutral-100 dark:border-white/10">
              <a href="/products" class="text-xs font-semibold text-neutral-900 dark:text-cyan-400 hover:text-[#0070f3] dark:hover:text-cyan-300 transition flex items-center justify-between">
                <span>Inspect Edge Mesh Topology</span>
                <span>→</span>
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- 5. Commercial Services Section -->
  <section class="py-24 bg-white border-b border-[#ebebeb]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <SectionEyebrow tag="02. SERVICES">DIGITAL ENGINEERING SERVICES</SectionEyebrow>
        <h2 class="text-3xl sm:text-4xl font-semibold tracking-[-0.03em] text-[#171717]">
          Crafted for businesses ready to lead.
