---
// community/developer.astro - Prometrion Developer Ecosystem
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";

const badgeTiers = [
  {
    tier: "Prometrion Developer",
    badgeColor: "blue",
    desc: "Entry credential for certified engineers. Access sandbox developer keys, CLI tools, and the Coders Club Discord.",
    criteria: "Pass the developer verification assessment and publish a verified public GitHub repo.",
  },
  {
    tier: "Verified Partner Developer",
    badgeColor: "emerald",
    desc: "Eligible for customer project referrals, paid component marketplace store listings, and direct support.",
    criteria: "Deploy at least 3 production client projects on the Prometrion edge network with 95+ Core Web Vitals.",
  },
  {
    tier: "Ecosystem Core Contributor",
    badgeColor: "purple",
    desc: "Exclusive access to experimental Taluq AI reasoning models, early API betas, and annual leadership roundtables.",
    criteria: "Contribute to open-source Prometrion libraries or author recognized technical documentation guides.",
  },
];
---

<BaseLayout
  title="Prometrion Developer Program — Partner Ecosystem"
  description="Join the official Prometrion Developer program: Earn verified developer credentials, publish store components, and build with Taluq AI."
>
  <div class="py-6 sm:py-8 border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070707]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <SectionEyebrow tag="DEVELOPER ECOSYSTEM">OFFICIAL PARTNER NETWORK</SectionEyebrow>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white mt-1">
          Build, publish, and earn with Prometrion.
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-xl">
          Elite engineers receiving platform credentials, publishing store apps, and delivering enterprise solutions.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <Button variant="primary" href="/account/signup" size="sm">
          Apply as Developer
        </Button>
        <Button variant="secondary" href="/community/coders-club" size="sm">
          Coders Club
        </Button>
      </div>
    </div>
  </div>

  <div class="py-8 sm:py-12 bg-[#fafafa] dark:bg-black/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Developer Profile Preview Card per PRD -->
      <div class="bg-white border border-[#ebebeb] rounded-[6px] p-8 shadow-whisper">
        <div class="text-xs font-mono uppercase tracking-wider text-neutral-400 mb-4">PROFILE SPECIFICATION</div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-6 border-b border-neutral-100">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-full bg-neutral-900 text-white flex items-center justify-center font-bold text-2xl">
              R
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-xl font-semibold text-neutral-900">Rajnikant</h2>
                <Badge variant="blue">✦ Verified Developer</Badge>
              </div>
              <p class="text-xs text-neutral-500 font-mono mt-0.5">@rajnikant • Joined Q2 2025</p>
              <div class="flex flex-wrap gap-1.5 mt-2">
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 text-neutral-700">Astro 7</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 text-neutral-700">Taluq AI</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 text-neutral-700">Tailwind v4</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-neutral-100 text-neutral-700">TypeScript</span>
              </div>
            </div>
          </div>

          <div class="flex gap-2">
            <Button variant="ghost-sm" href="/account/profile">View Public Profile</Button>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 text-xs text-neutral-600 font-mono">
          <div>
            <span class="text-neutral-400 block">Deployments:</span>
            <span class="font-bold text-neutral-900 text-sm">34 Production</span>
          </div>
          <div>
            <span class="text-neutral-400 block">Marketplace:</span>
            <span class="font-bold text-neutral-900 text-sm">12 Components</span>
          </div>
          <div>
            <span class="text-neutral-400 block">Community Rep:</span>
            <span class="font-bold text-emerald-600 text-sm">Top 1% Guild</span>
          </div>
          <div>
            <span class="text-neutral-400 block">Status:</span>
            <span class="font-bold text-neutral-900 text-sm">Active & Verified</span>
          </div>
        </div>
      </div>

      <!-- Badge Tiers Grid -->
      <div>
        <h3 class="text-xl font-semibold text-neutral-900 mb-6">Prometrion Developer Credentials</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {badgeTiers.map((b) => (
            <Card variant="default">
              <Badge variant={b.badgeColor as any}>{b.tier}</Badge>
              <p class="text-xs text-neutral-600 mt-3 leading-relaxed">{b.desc}</p>
              <div class="mt-4 pt-4 border-t border-neutral-100 text-[11px] font-mono text-neutral-400">
                Criteria: <span class="text-neutral-700 font-sans">{b.criteria}</span>
              </div>
            </Card>
          ))}
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
