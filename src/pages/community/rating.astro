---
// community/rating.astro - Authenticated Ratings & Reviews System
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";

const reviews = [
  {
    author: "Kavita Singhania",
    company: "Aura Health & Diagnostics",
    role: "Medical Director",
    service: "Healthcare Web Portal & GEO",
    rating: 5,
    date: "August 2026",
    verifiedCustomer: true,
    content: "Prometrion completely rebuilt our clinic's web presence in 10 days. The site loads in under 300ms, our appointment booking rate tripled, and we are consistently ranking in the top local Google search results and AI citations.",
  },
  {
    author: "Alexandre Dupont",
    company: "Veloce SaaS Platform",
    role: "Chief Technology Officer",
    service: "SaaS Frontend & Cloud Sandbox",
    rating: 5,
    date: "July 2026",
    verifiedCustomer: true,
    content: "The engineering craft is unmatched. We evaluated multiple dev agencies before discovering Prometrion. Their Swiss-inspired Geist design combined with Astro 7 performance resulted in a 99/100 Core Web Vitals score on day one.",
  },
  {
    author: "Tariq Mansoor",
    company: "Nexus Logistics Group",
    role: "VP of Operations",
    service: "Native Android Operations App",
    rating: 5,
    date: "June 2026",
    verifiedCustomer: true,
    content: "Our field agents needed a resilient, offline-first Android application. Prometrion delivered the entire solution on time with full biometric security and automated database synchronization.",
  },
  {
    author: "Sara Jenkins",
    company: "Loomis Creative Studio",
    role: "Creative Director",
    service: "Agency Portfolio & SEO",
    rating: 5,
    date: "May 2026",
    verifiedCustomer: true,
    content: "Clean, confident, and hyper-refined. Prometrion proves that high performance and breathtaking typography can live together harmoniously.",
  },
];
---

<BaseLayout
  title="Ratings & Reviews — Prometrion Community"
  description="Verified client testimonials and community ratings for Prometrion products, software engineering, and digital services."
>
  <div class="py-14 sm:py-20 border-b border-[#ebebeb] bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionEyebrow tag="COMMUNITY / RATINGS">AUTHENTICATED REPUTATION</SectionEyebrow>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="text-3xl sm:text-5xl font-semibold tracking-[-0.04em] text-[#171717]">
            Verified Ratings & Reviews
          </h1>
          <p class="mt-3 text-neutral-600 max-w-xl text-sm sm:text-base leading-relaxed">
            Transparent feedback from verified clients and registered community builders. Every review is tied to an authenticated Prometrion Account.
          </p>
        </div>

        <div class="flex items-center gap-4 shrink-0">
          <Button variant="primary" href="/account/signin">
            Rate Prometrion (Sign In)
          </Button>
        </div>
      </div>

      <!-- Rating Overview Score Card -->
      <div class="mt-10 p-6 bg-[#fafafa] rounded-[6px] border border-[#ebebeb] grid grid-cols-1 sm:grid-cols-3 gap-6 items-center">
        <div class="text-center sm:text-left sm:border-r border-neutral-200 sm:pr-6">
          <div class="text-5xl font-mono font-bold text-[#171717]">4.9</div>
          <div class="flex items-center justify-center sm:justify-start gap-1 text-amber-500 text-sm mt-1">
            ★★★★★
          </div>
          <span class="text-xs text-neutral-500 mt-1 block">Based on 148 verified submissions</span>
        </div>

        <div class="space-y-1.5 text-xs font-mono text-neutral-600 sm:col-span-2">
          <div class="flex items-center gap-2">
            <span class="w-12">5 stars</span>
            <div class="flex-1 h-2 bg-neutral-200 rounded-full overflow-hidden">
              <div class="w-[94%] h-full bg-amber-400"></div>
            </div>
            <span class="w-8 text-right font-medium">94%</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-12">4 stars</span>
            <div class="flex-1 h-2 bg-neutral-200 rounded-full overflow-hidden">
              <div class="w-[5%] h-full bg-amber-400"></div>
            </div>
            <span class="w-8 text-right font-medium">5%</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-12">3 stars</span>
            <div class="flex-1 h-2 bg-neutral-200 rounded-full overflow-hidden">
              <div class="w-[1%] h-full bg-amber-400"></div>
            </div>
            <span class="w-8 text-right font-medium">1%</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="py-16 bg-[#fafafa]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {reviews.map((r) => (
        <Card variant="default">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-neutral-100">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-semibold text-sm text-neutral-900">{r.author}</span>
                {r.verifiedCustomer && (
                  <Badge variant="emerald">✔ Verified Customer</Badge>
                )}
              </div>
              <p class="text-xs text-neutral-500">{r.role}, {r.company}</p>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <span class="text-amber-500">★★★★★</span>
              <span class="font-mono text-neutral-400">{r.date}</span>
            </div>
          </div>

          <p class="text-xs sm:text-sm text-neutral-700 mt-4 leading-relaxed">
            "{r.content}"
          </p>

          <div class="mt-4 pt-3 border-t border-neutral-100 flex items-center justify-between text-[11px] font-mono text-neutral-400">
            <span>Project: <strong class="text-neutral-700 font-sans">{r.service}</strong></span>
            <span>Reviewed on Prometrion Trust Desk</span>
          </div>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
