---
// community/customers.astro - Prometrion Customer Showcase & Case Studies
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";

const caseStudies = [
  {
    company: "Aura Health & Diagnostics",
    industry: "Healthcare & Diagnostics",
    services: ["Healthcare Web Portal", "GEO & Semantic SEO", "Managed Edge Cloud"],
    impact: "+220% online bookings in 60 days, 210ms average page load time.",
    quote: "Prometrion eliminated all our performance and SEO headaches. Our clinic web platform is now a primary driver of new patient registrations.",
    leader: "Dr. Kavita Singhania, Medical Director",
  },
  {
    company: "Veloce Financial SaaS",
    industry: "Fintech & Wealth Management",
    services: ["SaaS Web Platform", "Authentication Suite", "Taluq AI Agent"],
    impact: "99/100 Core Web Vitals, 0.00 CLS, and automated financial reasoning assistant.",
    quote: "The speed of execution was staggering. Prometrion delivered a bank-grade frontend that outclassed our venture-backed competitors.",
    leader: "Alexandre Dupont, CTO",
  },
  {
    company: "Nexus Logistics Worldwide",
    industry: "Supply Chain & Logistics",
    services: ["Android Field Operations App", "Cross-Platform Dashboard"],
    impact: "15,000+ daily package dispatches tracked with zero offline data loss.",
    quote: "Our field drivers love the Android native client. It is responsive, battery-friendly, and operates flawlessly in offline areas.",
    leader: "Tariq Mansoor, VP of Operations",
  },
];
---

<BaseLayout
  title="Customer Stories — Prometrion Case Studies"
  description="Explore in-depth case studies and verified business impact stories from organizations powered by Prometrion."
>
  <div class="py-6 sm:py-8 border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070707]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <SectionEyebrow tag="COMMUNITY / CUSTOMERS">ENTERPRISE SUCCESS</SectionEyebrow>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white mt-1">
          Customer Impact & Case Studies
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-xl">
          How forward-thinking companies leverage Prometrion software products, digital services, and AI architectures.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <Button variant="primary" href="/contact" size="sm">Start a Project</Button>
        <Button variant="secondary" href="/services/packages" size="sm">View Packages</Button>
      </div>
    </div>
  </div>

  <div class="py-8 sm:py-12 bg-[#fafafa] dark:bg-black/50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      {caseStudies.map((c) => (
        <Card variant="default" class="p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-neutral-100">
            <div>
              <h2 class="text-xl font-semibold text-neutral-900">{c.company}</h2>
              <span class="text-xs text-neutral-500 font-mono">{c.industry}</span>
            </div>
            <Badge variant="blue">Verified Case Study</Badge>
          </div>

          <div class="my-4">
            <div class="text-xs font-mono uppercase text-neutral-400">BUSINESS IMPACT:</div>
            <p class="text-sm font-semibold text-emerald-700 mt-1">{c.impact}</p>
          </div>

          <blockquote class="my-4 p-4 rounded-[6px] bg-neutral-50 border-l-2 border-[#0070f3] text-xs sm:text-sm text-neutral-700 italic">
            "{c.quote}"
          </blockquote>

          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-neutral-100 text-xs text-neutral-500">
            <div>
              <span class="font-mono text-neutral-400">Services: </span>
              <span class="text-neutral-800">{c.services.join(" • ")}</span>
            </div>
            <div class="font-medium text-neutral-800 shrink-0">
              — {c.leader}
            </div>
          </div>
        </Card>
      ))}
    </div>
  </div>
</BaseLayout>
