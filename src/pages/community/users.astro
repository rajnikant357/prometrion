---
// community/users.astro - Directory of People & Creators Powered by Prometrion
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Badge from "../../components/ui/Badge.astro";

const usersList = [
  {
    name: "Vikram Mehta",
    username: "vikram_m",
    role: "Full-Stack Engineer",
    productsUsed: ["Astro 7 Webstore", "Prometrion CLI"],
    contributions: "5 Templates, 14 Code Reviews",
    avatarInitial: "V",
  },
  {
    name: "Sarah Lindqvist",
    username: "sarahlind",
    role: "AI Workflow Architect",
    productsUsed: ["Taluq AI SDK", "Prometrion Sandboxes"],
    contributions: "3 Agent Pipelines",
    avatarInitial: "S",
  },
  {
    name: "David Morales",
    username: "dmorales_tech",
    role: "Independent App Creator",
    productsUsed: ["Prometrion Appstore", "Android Kotlin Tools"],
    contributions: "2 Android Apps Published",
    avatarInitial: "D",
  },
  {
    name: "Amina Al-Mansoor",
    username: "amina_am",
    role: "Digital Agency Principal",
    productsUsed: ["Enterprise Website Development", "GEO Suite"],
    contributions: "12 Client Deployments",
    avatarInitial: "A",
  },
];
---

<BaseLayout
  title="Users Directory — Prometrion Community"
  description="Discover the global directory of creators, engineers, and digital innovators building with Prometrion."
>
  <div class="py-6 sm:py-8 border-b border-[#ebebeb] dark:border-white/10 bg-white dark:bg-[#070707]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <SectionEyebrow tag="COMMUNITY / USERS">CREATOR DIRECTORY</SectionEyebrow>
        <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#171717] dark:text-white mt-1">
          People Building with Prometrion
        </h1>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 mt-1 max-w-xl">
          A directory of verified builders using our products, templates, and runtime infrastructure.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <a href="/account/signup" class="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-full text-xs font-medium bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:opacity-90 transition shadow-sm">
          Join Directory →
        </a>
      </div>
    </div>
  </div>

  <div class="py-8 sm:py-12 bg-[#fafafa] dark:bg-black/50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {usersList.map((user) => (
          <Card variant="default">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-neutral-900 text-white flex items-center justify-center font-bold text-sm">
                {user.avatarInitial}
              </div>
              <div>
                <h3 class="font-semibold text-sm text-neutral-900">{user.name}</h3>
                <span class="text-xs font-mono text-neutral-400">@{user.username}</span>
              </div>
            </div>

            <p class="text-xs text-[#0070f3] font-medium mt-3">{user.role}</p>

            <div class="mt-4 pt-3 border-t border-neutral-100 text-xs text-neutral-600 space-y-1">
              <div>
                <span class="text-neutral-400 font-mono text-[11px]">Products: </span>
                <span>{user.productsUsed.join(", ")}</span>
              </div>
              <div>
                <span class="text-neutral-400 font-mono text-[11px]">Contributions: </span>
                <span class="text-neutral-900 font-medium">{user.contributions}</span>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
