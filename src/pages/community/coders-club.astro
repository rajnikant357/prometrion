---
// community/coders-club.astro - Coders Club Developer Guild
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionEyebrow from "../../components/ui/SectionEyebrow.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";

const clubFeatures = [
  {
    title: "Quarterly Hackathons",
    desc: "Build autonomous AI agents, novel UI libraries, or edge tools. Compete for $25,000+ prize pools and store feature spots.",
    tag: "Competitions",
  },
  {
    title: "Architectural Peer Review",
    desc: "Submit your code architectures and schemas for live peer review by senior Prometrion platform engineers.",
    tag: "Mentorship",
  },
  {
    title: "Curated Code Snippets",
    desc: "Exclusive access to experimental Taluq AI reasoning prompts, custom Astro components, and microVM templates.",
    tag: "Resources",
  },
  {
    title: "Global Private Guild Channels",
    desc: "Direct private Discord and forum access with verified software architects and technical founders.",
    tag: "Networking",
  },
];
---

<BaseLayout
  title="Coders Club — Prometrion Developer Guild"
  description="An exclusive developer community and guild solving engineering challenges, hosting hackathons, and sharing code."
>
  <div class="py-16 sm:py-24 border-b border-[#ebebeb] bg-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionEyebrow tag="COMMUNITY GUILD">CODERS CLUB</SectionEyebrow>
      <h1 class="text-4xl sm:text-6xl font-semibold tracking-[-0.04em] text-[#171717] leading-tight">
        The Guild for Modern Programmers.
      </h1>
      <p class="mt-4 text-base text-neutral-600 max-w-2xl mx-auto leading-relaxed">
        Coders Club brings together elite software builders, indie developers, and system architects. Solve challenges, earn reputation, and build what's next.
      </p>

      <div class="mt-8 flex justify-center gap-3">
        <Button variant="primary" href="/account/signup">
          Join Coders Club
        </Button>
        <Button variant="secondary" href="/store/components">
          Browse Club Snippets
        </Button>
      </div>
    </div>
  </div>

  <div class="py-16 bg-[#fafafa]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {clubFeatures.map((f) => (
          <Card variant="default">
            <Badge variant="purple">{f.tag}</Badge>
            <h2 class="text-lg font-semibold text-neutral-900 mt-3">{f.title}</h2>
            <p class="text-xs text-neutral-600 mt-2 leading-relaxed">{f.desc}</p>
          </Card>
        ))}
      </div>

      <!-- Upcoming Event Callout -->
      <div class="bg-white border border-[#ebebeb] rounded-[6px] p-8 shadow-floating flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <Badge variant="emerald">✦ LIVE HACKATHON</Badge>
            <span class="text-xs font-mono text-neutral-400">October 2026</span>
          </div>
          <h3 class="text-xl font-semibold text-neutral-900">Taluq Autonomous Agent Sprint</h3>
          <p class="text-xs text-neutral-600 mt-1 max-w-xl">
            Build the most capable multi-step reasoning agent using the Taluq AI SDK. Open to all verified Coders Club members.
          </p>
        </div>
        <Button variant="primary-sm" href="/account/signup">
          Register for Sprint →
        </Button>
      </div>

    </div>
  </div>
</BaseLayout>
