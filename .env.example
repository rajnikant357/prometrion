# Prometrion Website - Environment Variables Reference
# Copy to .env for local production testing

# Canonical Site URL
PUBLIC_SITE_URL=https://www.prometrion.com

# Analytics & Observability (Optional)
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Notification / CRM Webhook Endpoints (Optional)
# QUOTE_WEBHOOK_URL=https://api.prometrion.com/v1/quotes
# CONSULTATION_WEBHOOK_URL=https://api.prometrion.com/v1/consultations
